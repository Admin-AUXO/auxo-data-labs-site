{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "strict": true,
    "incremental": true,
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "jsx": "preserve",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [".astro/types.d.ts", "src/**/*"],
  "exclude": ["dist", "node_modules", "src_legacy"]
}
