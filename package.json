{
  "name": "auxo-homepage",
  "type": "module",
  "version": "2.0.0",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "astro dev --port 4340",
    "build": "astro build",
    "preview": "astro preview --port 4341",
    "sync": "astro sync",
    "type-check": "astro sync && tsc --noEmit",
    "lint:css": "stylelint \"src/styles/**/*.css\" --allow-empty-input",
    "lint:css:fix": "stylelint \"src/styles/**/*.css\" --fix --allow-empty-input",
    "lint": "npm run type-check && npm run lint:css",
    "audit:astro": "node scripts/audit/check-astro.mjs",
    "audit:stacking": "node scripts/audit/check-stacking.mjs",
    "audit:public": "node scripts/audit/check-public.mjs",
    "audit:deps": "node scripts/audit/check-deps.mjs",
    "audit": "npm run lint && npm run audit:astro && npm run audit:stacking && npm run audit:public && npm run audit:deps",
    "validate": "npm run lint && npm run build",
    "test": "playwright test",
    "test:ui": "playwright test --ui"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.3",
    "@emailjs/browser": "^4.4.1",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/simple-icons": "^1.2.63",
    "astro": "^6.3.8",
    "astro-icon": "^1.1.5",
    "embla-carousel": "^8.6.0",
    "embla-carousel-autoplay": "^8.6.0",
    "lenis": "^1.3.23",
    "web-vitals": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.3.0",
    "sharp": "^0.34.5",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^39.0.1",
    "stylelint-order": "^6.0.4",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "sharp": "^0.34.5"
  }
}
