# Public Google Analytics 4 measurement ID (exposed to the client; consent-gated)
PUBLIC_GA4_MEASUREMENT_ID=

# Server-side webhook URLs the form actions POST validated JSON to.
# When set, the matching form delivers; when unset in production the form
# reports "not connected". Leave blank in dev to keep forms in pending mode.

# Receives { email } from the brief subscription form
BRIEF_WEBHOOK_URL=

# Receives { email, band } from the report request form
REPORT_WEBHOOK_URL=

# Receives { name, email, company, topic, message } from the contact form
CONTACT_WEBHOOK_URL=
