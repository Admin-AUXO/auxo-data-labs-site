# Public Google Tag Manager container ID (loads GA4 via GTM; Consent Mode default-denied)
PUBLIC_GTM_CONTAINER_ID=GTM-N6547BGW

# AUXO Score (/self-check/) — n8n webhooks. If unset, the email forms show "Email isn't available right now."
PUBLIC_N8N_REPORT_WEBHOOK=https://<n8n-host>/webhook/auxo-score-report
PUBLIC_N8N_EXTENDED_WEBHOOK=https://<n8n-host>/webhook/auxo-score-extended
