---
import { Icon } from "astro-icon/components";
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/layout/Section.astro";
import SectionHeader from "../components/ui/SectionHeader.astro";
import Button from "../components/ui/Button.astro";
import HighlightText from "../components/ui/HighlightText.astro";
import CtaSection from "../components/sections/shared/CtaSection.astro";
import SelfCheckCta from "../components/sections/shared/SelfCheckCta.astro";
import { servicesContent as c } from "../data/services-overview";
---

<BaseLayout
  title="Work — analytics and AI for Gulf real estate"
  description="What AUXO does for Gulf property teams: trusted data, clear reporting, reliable automation, and confident compliance — plus four clear ways to work together."
>
  <Section padding="xl" width="7xl">    <div class="flex max-w-3xl flex-col gap-7">
      <h1 class="text-display text-display--5xl max-w-[14ch]" data-enter="headline">
        <HighlightText text={c.hero.title} highlight={c.hero.titleHighlight} />
      </h1>
      <p class="lead max-w-2xl text-xl" data-enter>{c.hero.lead}</p>
      <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center" data-enter>
        <Button variant="primary" size="lg" href={c.hero.primaryCta.href} icon class="w-full sm:w-auto">
          {c.hero.primaryCta.text}
        </Button>
        <Button variant="secondary" size="lg" href={c.hero.secondaryCta.href} class="w-full sm:w-auto">
          {c.hero.secondaryCta.text}
        </Button>
      </div>
    </div>
  </Section>

  <Section padding="lg" width="7xl">
    <SectionHeader
      title={c.capabilities.title}
      highlight={c.capabilities.titleHighlight}
      subtitle={c.capabilities.subtitle}
    />
    <div class="mt-10 flex flex-col border-t border-border sm:mt-16">
      {
        c.capabilities.items.map((item, i) => (
          <article
            class="group grid gap-6 border-b border-border py-9 sm:py-12 lg:grid-cols-12 lg:gap-10"
            data-reveal
            data-anim="rise"
            style={`--i:${i}`}
          >
            <div class="flex items-start gap-5 lg:col-span-5">
              <Icon name={item.icon} class="size-8 shrink-0 text-accent-2 transition-transform duration-300 group-hover:scale-110" aria-hidden="true" />
              <div class="flex flex-col gap-2">
                <div class="flex items-center gap-3">
                  <span class="text-accent-2 font-mono text-sm tabular-nums leading-none">
                    0{i + 1}
                  </span>
                  <span class="eyebrow text-muted">{item.label}</span>
                </div>
                <h3 class="text-2xl font-bold sm:text-3xl">
                  <HighlightText text={item.name} highlight={item.nameHighlight} />
                </h3>
              </div>
            </div>
            <div class="flex flex-col gap-5 lg:col-span-7">
              <p class="text-muted text-lg max-w-prose">{item.description}</p>
              <ul class="flex flex-wrap gap-x-6 gap-y-2">
                {item.outcomes.map((outcome) => (
                  <li class="flex items-center gap-2.5 text-sm text-foreground">
                    <span
                      class="h-1.5 w-1.5 shrink-0 rounded-full bg-accent"
                      aria-hidden="true"
                    />
                    {outcome}
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }
    </div>
  </Section>

  <SelfCheckCta
    text="Want a sharper sense of where you stand on these four? Get a straight 0–100 read across data, reporting, automation, and compliance, and the one fix that would change the most. No sign-up, ~3 minutes, and it stays in your browser."
  />

  <Section id="ways-to-work" padding="lg" width="7xl">
    <SectionHeader
      title={c.models.title}
      highlight={c.models.titleHighlight}
      subtitle={c.models.subtitle}
    />
    <div class="ways mt-10 sm:mt-16">
      {
        c.models.items.map((model) => (
          <article
            class:list={["ways__card group", model.featured && "ways__card--featured"]}
            data-reveal
            data-anim="rise"
          >
            <span class="mono-label ways__kicker transition-colors duration-300 group-hover:text-accent">
              {model.kicker}
            </span>
            {model.featured && <span class="mono-label ways__badge">Start here</span>}
            <h3 class="ways__name">{model.name}</h3>
            <div class="ways__price">
              <span class="font-mono font-semibold whitespace-nowrap text-foreground">{model.price}</span>
              {model.unit && <span class="font-mono text-sm text-subtle">{model.unit}</span>}
            </div>
            <span class="mono-datum">{model.timeframe}</span>
            <p class="ways__hook">{model.hook}</p>
            <p class="ways__best">{model.bestFor}</p>
          </article>
        ))
      }
    </div>
    <div class="mt-8 flex flex-col gap-5 border-t border-border pt-8 sm:flex-row sm:items-center sm:justify-between sm:gap-8">
      <p class="text-muted max-w-2xl">{c.models.priceNote}</p>
      <Button variant="primary" size="lg" href={c.cta.ctaHref} icon class="w-full shrink-0 sm:w-auto">
        Book a meeting
      </Button>
    </div>

    <div class="mt-12 flex flex-col items-center gap-6 border-t border-border pt-10 text-center sm:mt-16 sm:pt-12" data-reveal>
      <h3 class="text-2xl font-bold sm:text-3xl">
        <HighlightText text={c.models.standards.title} highlight="standards" />
      </h3>
      <ul class="flex flex-wrap justify-center gap-3">
        {
          c.models.standards.frameworks.map((framework) => (
            <li class="mono-datum rounded-full border border-border-strong px-4 py-2 text-foreground">
              {framework}
            </li>
          ))
        }
      </ul>
      <p class="text-subtle text-sm max-w-prose mx-auto">{c.models.standards.caveat}</p>
    </div>
  </Section>

  <Section padding="lg" width="7xl">
    <div
      class="flex flex-col gap-8 rounded-2xl border border-border bg-surface px-6 py-9 lg:px-10 lg:py-11"
      style="box-shadow: var(--shadow-sm);"
      data-reveal
    >
      <div class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between sm:gap-10">
        <div class="flex max-w-2xl flex-col gap-3">
          <span class="block h-0.5 w-14 bg-accent-2" aria-hidden="true" data-anim="draw"></span>
          <h2 class="text-2xl font-bold sm:text-3xl" data-anim="clip-up">
            <HighlightText text={c.process.title} highlight={c.process.titleHighlight} />
          </h2>
          <p class="text-muted max-w-prose">{c.process.subtitle}</p>
        </div>
        <Button variant="secondary" size="md" href={c.process.summaryHref} class="w-full shrink-0 sm:w-auto">
          See how we work
        </Button>
      </div>
      <ol class="grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
        {
          c.process.steps.map((step, i) => (
            <li class="relative flex flex-col gap-3 border-t-2 border-foreground pt-5" data-anim="rise">
              <span class="mono-datum">{String(i + 1).padStart(2, "0")}</span>
              <h3 class="text-lg font-bold">{step.name}</h3>
              <p class="text-muted text-sm leading-relaxed">{step.desc}</p>
              {i < c.process.steps.length - 1 && (
                <Icon
                  name="mdi:arrow-right"
                  class="absolute -right-6 top-4 hidden text-xl text-subtle lg:block"
                  aria-hidden="true"
                />
              )}
            </li>
          ))
        }
      </ol>
    </div>
  </Section>

  <CtaSection
    title={c.cta.title}
    titleHighlight={c.cta.titleHighlight}
    description={c.cta.description}
    descriptionHighlight={c.cta.descriptionHighlight}
    ctaText={c.cta.ctaText}
    ctaHref={c.cta.ctaHref}
    secondaryText={c.cta.secondaryText}
    secondaryHref={c.cta.secondaryHref}
    reassurance={c.cta.reassurance}
  />
</BaseLayout>

<style>
  .ways {
    border-block-start: 1px solid var(--border);
    border-inline-start: 1px solid var(--border);
    display: grid;
    grid-template-columns: 1fr;
  }

  .ways__card {
    background: var(--surface);
    border-block-end: 1px solid var(--border);
    border-inline-end: 1px solid var(--border);
    display: grid;
    gap: 0.65rem;
    padding: 1.4rem 1.5rem;
    position: relative;
  }

  .ways__card--featured {
    box-shadow: inset 0 0 0 1px var(--accent);
  }

  .ways__badge {
    color: var(--accent);
    inset-block-start: 1.4rem;
    inset-inline-end: 1.5rem;
    position: absolute;
  }

  .ways__name {
    font-family: var(--font-brand);
    font-size: var(--text-lg);
    font-weight: 700;
    line-height: 1.1;
  }

  .ways__price {
    align-items: baseline;
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.4rem;
  }

  .ways__price span:first-child {
    font-size: var(--text-base);
  }

  .ways__hook {
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: 1.55;
  }

  .ways__best {
    border-block-start: 1px solid var(--border);
    color: var(--subtle);
    font-size: var(--text-xs);
    line-height: 1.55;
    margin-block-start: 0.3rem;
    padding-block-start: 0.85rem;
  }

  @media (width >= 40rem) {
    .ways {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (width >= 64rem) {
    .ways {
      grid-template-columns: repeat(4, 1fr);
    }

    .ways__card {
      grid-row: span 6;
      grid-template-rows: subgrid;
    }
  }
</style>
