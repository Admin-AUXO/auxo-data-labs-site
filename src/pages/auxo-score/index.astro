---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AuxoScore from "../../components/auxo-score/AuxoScore.astro";
import Section from "../../components/layout/Section.astro";
import SectionHeader from "../../components/ui/SectionHeader.astro";
import Accordion from "../../components/ui/Accordion.astro";
import StructuredData from "../../components/layout/StructuredData.astro";
import { SCORE_COPY } from "../../components/auxo-score/copy";
import { auxoScoreAbout as about } from "../../data/auxo-score";
import { howItWorksContent } from "../../data/how-it-works";
import { faqSchema } from "../../lib/structured-data";
import { escapeHtml } from "../../lib/text";
import "../../styles/pages/how-it-works.css";

const faqItems = about.faq.items.map((item) => ({
  title: item.question,
  body: `<p>${escapeHtml(item.answer)}</p>`,
}));
---
<BaseLayout title={SCORE_COPY.meta.title} description={SCORE_COPY.meta.description} path="/auxo-score/">
  <AuxoScore />

  <Section padding="lg" width="7xl">
    <SectionHeader eyebrow={about.eyebrow} title={about.title} subtitle={about.lead} />
    <ol class="method mt-8">
      {
        howItWorksContent.method.dimensions.map((d, i) => (
          <li class="method__item">
            <span class="mono-datum text-accent-2">{String(i + 1).padStart(2, "0")}</span>
            <h3 class="method__name">{d.name}</h3>
            <p class="method__question text-muted">{d.question}</p>
          </li>
        ))
      }
    </ol>
  </Section>

  <Section padding="lg" width="7xl">
    <div class="faq-split">
      <SectionHeader eyebrow={about.faq.eyebrow} title={about.faq.title} />
      <div class="faq-split__list">
        <Accordion items={faqItems} openFirst />
      </div>
    </div>
  </Section>

  <StructuredData type="FAQPage" data={faqSchema(about.faq.items)} />
</BaseLayout>
