---
import { Icon } from "astro-icon/components";
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/layout/Section.astro";
import SectionHeader from "../components/ui/SectionHeader.astro";
import Accordion from "../components/ui/Accordion.astro";
import Button from "../components/ui/Button.astro";
import CtaSection from "../components/sections/shared/CtaSection.astro";
import FootnoteRef from "../components/ui/FootnoteRef.astro";
import { homeContent as c } from "../data/home";
import "../styles/pages/home.css";

const logoLoop = [...c.logos.items, ...c.logos.items];

/** Split a sentence around the substring to accent, as the pillars do with their letter. */
const splitOn = (text: string, needle: string) => {
  const i = needle ? text.indexOf(needle) : -1;
  return i === -1
    ? { pre: text, hl: "", post: "" }
    : { pre: text.slice(0, i), hl: needle, post: text.slice(i + needle.length) };
};

const scoreTitle = splitOn(c.score.title, c.score.titleAccent);
const scoreStat = splitOn(c.score.stat, c.score.statAccent);
const scoreNote = splitOn(c.score.reassurance, c.score.reassuranceAccent);

const pillars = c.pillars.map((p) => {
  const i = p.title.toLowerCase().indexOf(p.letter.toLowerCase());
  return i === -1
    ? { ...p, pre: p.title, hl: "", post: "" }
    : { ...p, pre: p.title.slice(0, i), hl: p.title.slice(i, i + 1), post: p.title.slice(i + 1) };
});

---
<BaseLayout title={c.meta.title} description={c.meta.description} footnotes>
  <Section padding="lg" width="7xl" class="home-hero">
    <div class="home-hero__inner">
      <div class="home-hero__main">
        <h1 class="home-hero__title" data-enter="headline">{c.hero.titleLead} <span class="hl-accent">{c.hero.titleHighlight}</span>{c.hero.titleTail}</h1>
        <div class="home-hero__row">
          <p class="lead home-hero__lead" data-enter>{c.hero.subtitle}</p>
          <div class="home-hero__ctas" data-enter>
            <Button variant="primary" size="lg" href={c.hero.primaryCta.href} icon class="w-full sm:w-auto">
              {c.hero.primaryCta.text}
            </Button>
            <Button variant="secondary" size="lg" href={c.hero.secondaryCta.href} class="w-full sm:w-auto">
              {c.hero.secondaryCta.text}
            </Button>
          </div>
        </div>
      </div>
    </div>
  </Section>

  <!-- Explainer film. Click to load: no bytes fetched until the still is pressed. -->
  <!-- See claude/Explainer_Video_Placement_Nov2026.md -->
  <Section padding="sm" width="7xl">
    <figure class="film-band" data-reveal>
      <div class="film-band__frame" data-film data-src={c.film.src}>
        <button class="film-band__trigger" type="button" data-film-play aria-label={`${c.film.playLabel}, ${c.film.duration}`}>
          <img class="film-band__poster" src={c.film.poster} alt={c.film.posterAlt} width="1600" height="900" loading="lazy" decoding="async" />
          <span class="film-band__veil" aria-hidden="true"></span>
          <span class="film-band__overlay">
            <span class="film-band__label">{c.film.label}</span>
            <span class="film-band__lead">{c.film.lead}</span>
            <span class="film-band__play">
              <span class="film-band__play-icon" aria-hidden="true"></span>
              {c.film.playLabel}
              <span class="film-band__dur">{c.film.duration}</span>
            </span>
          </span>
        </button>
      </div>
      <p class="sr-only">{c.film.transcript}</p>
    </figure>
  </Section>

  <script is:inline>
    (function () {
      var band = document.querySelector("[data-film]");
      var btn = band && band.querySelector("[data-film-play]");
      if (!band || !btn) return;
      btn.addEventListener("click", function () {
        if (band.dataset.playing === "1") return;
        band.dataset.playing = "1";
        var v = document.createElement("video");
        v.className = "film-band__video";
        v.src = band.dataset.src;
        v.poster = btn.querySelector("img").getAttribute("src");
        v.controls = true;
        v.autoplay = true;
        v.playsInline = true;
        v.setAttribute("playsinline", "");
        band.appendChild(v);
        btn.remove();
        var p = v.play();
        if (p && p.catch) p.catch(function () {});
      });
    })();
  </script>

  <Section padding="lg" width="7xl">
    <div class="home-fix">
      <div class="score-card" data-reveal>
        <svg class="score-gauge" data-gauge="idle" viewBox="0 0 120 70" aria-hidden="true">
          <path class="score-gauge__track" d="M10 62 A50 50 0 0 1 110 62" pathLength="100" />
          <path class="score-gauge__fill" d="M10 62 A50 50 0 0 1 110 62" pathLength="100" />
        </svg>
        <div class="flex flex-col gap-3">
          <h2 class="font-bold">{scoreTitle.pre}<span class="hl-accent">{scoreTitle.hl}</span>{scoreTitle.post}</h2>
          <p class="max-w-xl text-lg text-muted text-balance">{scoreStat.pre}<em class="hl-glow">{scoreStat.hl}</em>{scoreStat.post}<FootnoteRef id={c.score.statFootnoteId} /></p>
        </div>
        <div class="flex flex-col items-start gap-3 min-[56rem]:items-end">
          <Button variant="secondary" size="lg" href={c.score.cta.href} icon class="w-full sm:w-auto">
            {c.score.cta.text}
          </Button>
          <p class="text-sm text-subtle text-pretty min-[56rem]:text-end">{scoreNote.pre}<span class="hl-accent whitespace-nowrap">{scoreNote.hl}</span>{scoreNote.post}</p>
        </div>
      </div>
    </div>
  </Section>

  <Section padding="sm" width="7xl">
    <div class="logos" data-reveal>
      <p class="eyebrow logos__label" id="works-with-label">{c.logos.label}</p>
      <div class="logos__viewport" data-marquee tabindex="0" role="region" aria-labelledby="works-with-label">
        <ul class="logos__track" aria-labelledby="works-with-label">
          {
            logoLoop.map((logo, i) => (
              <li class="logos__item" aria-hidden={i >= c.logos.items.length ? "true" : undefined}>
                <Icon name={logo.icon} class="logos__icon" aria-hidden="true" />
                <span class="logos__name">{logo.name}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <p class="logos__note text-subtle">{c.logos.note}</p>
    </div>
  </Section>


  <Section padding="lg" width="7xl">
    <div class="home-head">
      <SectionHeader title={c.objection.title} />
    </div>

    <div class="disagree mt-8">
      <p class="disagree__q" data-reveal>
        <span class="disagree__prompt" aria-hidden="true">&gt;</span>{c.objection.question}
      </p>

      <ul class="disagree__grid">
        {c.objection.sources.map((src, i) => (
          <li data-anim="rise" style={`--i:${i}`}>
            <button type="button" class="src" data-source>
              <span class="src__name">{src.name}</span>
              <span class="src__num">{src.value}</span>
              <span class="src__def">{src.definition}</span>
            </button>
          </li>
        ))}
      </ul>

      <p class="disagree__hint">{c.objection.hint}</p>

      <div class="answer" data-reveal>
        <p class="answer__who">{c.objection.assistantLabel}</p>
        <p class="answer__text">
          {c.objection.assistantLead} <span class="answer__pick">{c.objection.assistantPick}</span> {c.objection.assistantTail}
        </p>
        <p class="answer__sub">
          {c.objection.assistantNoteLead} <em class="hl-glow">{c.objection.assistantNoteGlow}</em>
        </p>
      </div>

      <p class="disagree__close" data-reveal>
        {c.objection.closeLead} <em class="hl-glow">{c.objection.closeGlow}</em>{c.objection.closeTail}
      </p>
    </div>

    <div class="followups">
      <p class="eyebrow followups__label">{c.objection.followupsLabel}</p>
      <Accordion items={c.objection.followups} />
      <div class="followups__foot">
        <Button variant="secondary" href={c.objection.cta.href}>{c.objection.cta.text}</Button>
        <a class="followups__quiet" href={c.objection.blogLink.href}>{c.objection.blogLink.text}</a>
      </div>
    </div>
  </Section>

  <script is:inline>
    (function () {
      var all = document.querySelectorAll("[data-source]");
      all.forEach(function (b) {
        b.addEventListener("click", function () {
          var open = b.getAttribute("data-open") === "1";
          all.forEach(function (o) { o.removeAttribute("data-open"); });
          if (!open) b.setAttribute("data-open", "1");
        });
      });
    })();
  </script>

  <Section padding="lg" width="7xl">
    <div class="home-fix">
      <div class="home-head">
        <SectionHeader title={c.pillarsHeader.title} subtitle={c.pillarsHeader.lead} />
      </div>
      <ul class="cube" aria-label={c.pillarsLabel}>
        {
          pillars.map((p) => (
            <li class="cube__cell">
              <button type="button" class="cube__tile" aria-pressed="false" data-cube-tile>
                <span class="cube__face cube__face--front">
                  <span class="cube__letter" aria-hidden="true">{p.letter}</span>
                  <span class="cube__title">{p.pre}<span class="cube__hl">{p.hl}</span>{p.post}</span>
                </span>
                <span class="cube__face cube__face--back">
                  <span class="cube__back-letter" aria-hidden="true">{p.letter}</span>
                  <span class="cube__back-title">{p.title}</span>
                  <span class="cube__desc">{p.desc}</span>
                </span>
              </button>
            </li>
          ))
        }
      </ul>
    </div>
  </Section>


  <CtaSection
    title={c.cta.title}
    description={c.cta.description}
    ctaText={c.cta.ctaText}
    ctaHref={c.cta.ctaHref}
    secondaryText={c.cta.secondaryText}
    secondaryHref={c.cta.secondaryHref}
    reassurance={c.cta.reassurance}
  />
</BaseLayout>

<script>
  import { motionEnabled } from "../scripts/core/motion";

  function initGauge() {
    const g = document.querySelector<SVGElement>("[data-gauge]");
    if (!g) return;
    g.style.setProperty("--gauge-off", String(20 + Math.round(Math.random() * 45)));
    if (!motionEnabled()) {
      g.dataset.gauge = "done";
      return;
    }
    const io = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        g.dataset.gauge = "run";
      },
      { threshold: 0.3 },
    );
    io.observe(g);
  }

  function initMarquee() {
    const vp = document.querySelector<HTMLElement>("[data-marquee]");
    const track = vp?.firstElementChild;
    if (!vp || !track || vp.dataset.bound) return;
    vp.dataset.bound = "1";
    const SPEED = 40;
    let paused = false;
    let visible = false;
    let running = false;
    let resumeTimer = 0;
    let last = 0;
    let pos = vp.scrollLeft;
    let half = 0;
    let width = 0;
    const measure = () => {
      half = vp.scrollWidth / 2;
      width = vp.clientWidth;
    };
    const tick = (now: number) => {
      if (!vp.isConnected || !visible || !motionEnabled()) {
        running = false;
        last = 0;
        return;
      }
      const dt = last ? Math.min(now - last, 100) : 0;
      last = now;
      if (!paused && half > width) {
        // Scrolling left moves the track right, so the logos travel left to right.
        pos -= (SPEED * dt) / 1000;
        if (pos <= 0) pos += half;
        vp.scrollLeft = pos;
      } else {
        pos = vp.scrollLeft;
      }
      requestAnimationFrame(tick);
    };
    const start = () => {
      if (running || !visible || !motionEnabled()) return;
      running = true;
      requestAnimationFrame(tick);
    };
    const sync = () => {
      if (!vp.isConnected) {
        window.removeEventListener("auxo:motionchange", sync);
        return;
      }
      vp.toggleAttribute("data-static", !motionEnabled());
      measure();
      // Travelling right means starting a full copy in, with room to scroll back.
      if (half > width && pos <= 0) {
        pos = half;
        vp.scrollLeft = pos;
      }
      start();
    };
    const pause = () => {
      paused = true;
      clearTimeout(resumeTimer);
    };
    const resumeSoon = (ms: number) => {
      clearTimeout(resumeTimer);
      resumeTimer = window.setTimeout(() => {
        pos = half ? vp.scrollLeft % half : vp.scrollLeft;
        paused = false;
      }, ms);
    };
    const pauseForMouse = (e: PointerEvent) => { if (e.pointerType === "mouse") pause(); };
    vp.addEventListener("pointerenter", pauseForMouse);
    // pointermove keeps it paused while the pointer sits inside, and covers the
    // case where the pointer is already over the strip before the script binds.
    vp.addEventListener("pointermove", pauseForMouse, { passive: true });
    vp.addEventListener("pointerleave", (e) => { if (e.pointerType === "mouse") resumeSoon(0); });
    vp.addEventListener("touchstart", pause, { passive: true });
    vp.addEventListener("touchend", () => resumeSoon(2000), { passive: true });
    vp.addEventListener("focusin", pause);
    vp.addEventListener("focusout", () => resumeSoon(0));
    const ro = new ResizeObserver(measure);
    ro.observe(vp);
    ro.observe(track);
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      start();
    }).observe(vp);
    window.addEventListener("auxo:motionchange", sync);
    sync();
  }

  function initCube() {
    document.querySelectorAll<HTMLButtonElement>("[data-cube-tile]").forEach((tile) => {
      if (tile.dataset.bound) return;
      tile.dataset.bound = "1";
      tile.addEventListener("click", (e) => {
        if ((e as PointerEvent).pointerType === "mouse" && window.matchMedia("(hover: hover)").matches) return;
        const on = tile.getAttribute("aria-pressed") !== "true";
        tile.setAttribute("aria-pressed", String(on));
      });
      tile.addEventListener("blur", () => tile.setAttribute("aria-pressed", "false"));
    });
  }

  document.addEventListener("astro:page-load", () => {
    initGauge();
    initMarquee();
    initCube();
  });

</script>
