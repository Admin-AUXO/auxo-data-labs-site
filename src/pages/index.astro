---
import { Icon } from "astro-icon/components";
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/layout/Section.astro";
import SectionHeader from "../components/ui/SectionHeader.astro";
import Button from "../components/ui/Button.astro";
import FootnoteRef from "../components/ui/FootnoteRef.astro";
import CtaSection from "../components/sections/shared/CtaSection.astro";
import { homeContent as c } from "../data/home";
import "../styles/pages/home.css";

const logoLoop = [...c.logos.items, ...c.logos.items];

const angleOrder = (slug: string) => {
  const i = c.blog.angles.findIndex((a) => a.slug === slug);
  return i === -1 ? c.blog.angles.length : i;
};

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf() || angleOrder(a.id) - angleOrder(b.id))
  .slice(0, 2)
  .map((post) => ({
    href: `/blog/${post.id}/`,
    title: post.data.title,
    description: post.data.description,
    author: post.data.author,
    angle: c.blog.angles.find((a) => a.slug === post.id)?.label,
  }));
---
<BaseLayout title={c.meta.title} description={c.meta.description} footnotes>
  <Section padding="lg" width="7xl" class="home-hero">
    <div class="flex flex-col gap-6">
      <h1 class="text-display text-display--5xl max-w-[20ch]" data-enter="headline">{c.hero.title}</h1>
      <p class="lead max-w-2xl text-xl" data-enter>{c.hero.subtitle}</p>
      <div class="flex flex-col gap-3" data-enter>
        <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center">
          <Button variant="primary" size="lg" href={c.hero.primaryCta.href} icon class="w-full sm:w-auto">
            {c.hero.primaryCta.text}
          </Button>
          <Button variant="secondary" size="lg" href={c.hero.secondaryCta.href} class="w-full sm:w-auto">
            {c.hero.secondaryCta.text}
          </Button>
        </div>
        <p class="text-sm text-subtle">{c.hero.reassurance}</p>
      </div>
    </div>
  </Section>

  <Section padding="md" width="7xl">
    <div class="score-card" data-reveal>
      <svg class="score-gauge" data-gauge="idle" viewBox="0 0 120 70" aria-hidden="true">
        <path class="score-gauge__track" d="M10 62 A50 50 0 0 1 110 62" pathLength="100" />
        <path class="score-gauge__fill" d="M10 62 A50 50 0 0 1 110 62" pathLength="100" />
      </svg>
      <div class="flex flex-col gap-3">
        <h2 class="font-bold">{c.score.title}</h2>
        <p class="max-w-xl text-lg text-muted text-balance">
          {c.score.stat}<FootnoteRef id={c.score.footnoteId} />
        </p>
      </div>
      <div class="flex flex-col items-start gap-3 min-[56rem]:items-end">
        <Button variant="primary" size="lg" href={c.score.cta.href} icon class="w-full sm:w-auto">
          {c.score.cta.text}
        </Button>
        <p class="text-sm text-subtle text-pretty min-[56rem]:text-end">{c.score.reassurance}</p>
      </div>
    </div>
  </Section>

  <Section padding="sm" width="7xl">
    <div class="logos" data-reveal>
      <p class="eyebrow logos__label" id="works-with-label">{c.logos.label}</p>
      <div class="logos__viewport" data-marquee tabindex="0" role="region" aria-labelledby="works-with-label">
        <ul class="logos__track" aria-labelledby="works-with-label">
          {
            logoLoop.map((logo, i) => (
              <li class="logos__item" aria-hidden={i >= c.logos.items.length ? "true" : undefined}>
                <Icon name={logo.icon} class="logos__icon" aria-hidden="true" />
                <span class="logos__name">{logo.name}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <p class="logos__note text-subtle">{c.logos.note}</p>
    </div>
  </Section>

  <Section padding="lg" width="7xl">
    <div class="home-fix">
      <div class="home-head">
        <p class="section-index" data-reveal>{c.pillarsHeader.eyebrow}</p>
        <SectionHeader title={c.pillarsHeader.title} subtitle={c.pillarsHeader.lead} />
      </div>
      <ul class="cube" aria-label={c.pillarsLabel}>
        {
          c.pillars.map((p) => (
            <li class="cube__cell">
              <button type="button" class="cube__tile" aria-pressed="false" data-cube-tile>
                <span class="cube__face cube__face--front">
                  <span class="cube__letter" aria-hidden="true">{p.letter}</span>
                  <span class="cube__title">{p.title}</span>
                </span>
                <span class="cube__face cube__face--back">
                  <span class="cube__back-title">{p.title}</span>
                  <span class="cube__desc">{p.desc}</span>
                </span>
              </button>
            </li>
          ))
        }
      </ul>
    </div>
  </Section>

  <Section padding="lg" width="7xl">
    <div class="home-head">
      <p class="section-index" data-reveal>{c.ladder.eyebrow}</p>
      <SectionHeader title={c.ladder.title} subtitle={c.ladder.lead} />
    </div>
    <ol class="cards mt-10 md:mt-12">
      {
        c.cards.map((card, i) => (
          <li class="cards__cell" data-anim="rise" style={`--i:${i}`}>
            <a href={card.href} class="cards__card">
              <span class="mono-datum text-accent-2" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
              <h3 class="cards__title">{card.title}</h3>
              <p class="cards__desc text-muted">{card.desc}</p>
              <Icon name="mdi:arrow-right" class="cards__arrow" aria-hidden="true" />
            </a>
          </li>
        ))
      }
    </ol>
  </Section>

  <Section padding="lg" width="7xl">
    <div class="home-split">
      <div class="home-head">
        <p class="section-index" data-reveal>{c.segments.eyebrow}</p>
        <SectionHeader title={c.segments.title} subtitle={c.segments.lead} />
      </div>
      <div class="flex flex-col gap-6">
        <ul class="segments" aria-label={c.segments.listLabel}>
          {
            c.segments.rows.map((row, i) => (
              <li data-anim="rise" style={`--i:${i}`}>
                <a href={row.href} class="segments__row">
                  <h3 class="segments__name">{row.segment}</h3>
                  <span class="segments__offer">{row.offer}</span>
                  <span class="segments__line text-muted">{row.line}</span>
                  <Icon name="mdi:arrow-right" class="segments__arrow" aria-hidden="true" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </Section>

  <Section padding="lg" width="7xl">
    <div class="market" data-reveal>
      <div class="home-head">
        <p class="section-index">{c.marketplace.eyebrow}</p>
        <h2 class="text-3xl font-bold sm:text-4xl">{c.marketplace.title}</h2>
        <p class="lead max-w-2xl text-balance">{c.marketplace.lead}</p>
      </div>
      <div class="flex flex-col gap-6">
        <ul class="market__chips" aria-label={c.marketplace.chipsLabel}>
          {
            c.marketplace.chips.map((chip) => (
              <li>
                <a href={`${c.marketplace.chipBase}?category=${chip.slug}`} class="market__chip">{chip.label}</a>
              </li>
            ))
          }
        </ul>
        <div>
          <Button variant="primary" href={c.marketplace.cta.href} icon class="w-full sm:w-auto">{c.marketplace.cta.text}</Button>
        </div>
      </div>
    </div>
  </Section>

  {
    posts.length > 0 && (
      <Section padding="lg" width="7xl">
        <div class="home-head">
          <p class="section-index" data-reveal>{c.blog.eyebrow}</p>
          <SectionHeader title={c.blog.title} subtitle={c.blog.lead} />
        </div>
        <ul class="posts mt-10 md:mt-12">
          {posts.map((post, i) => (
            <li data-anim="rise" style={`--i:${i}`}>
              <article class="posts__card">
                {post.angle && <p class="posts__angle">{post.angle}</p>}
                <h3 class="posts__title">
                  <a href={post.href} class="posts__link">{post.title}</a>
                </h3>
                <p class="text-muted">{post.description}</p>
                <div class="posts__foot">
                  <span class="text-sm text-subtle">{post.author}</span>
                  <span class="posts__more" aria-hidden="true">
                    {c.blog.linkText}
                    <Icon name="mdi:arrow-right" />
                  </span>
                </div>
              </article>
            </li>
          ))}
        </ul>
        <div class="home-more">
          <Button variant="secondary" href={c.blog.cta.href} icon class="w-full sm:w-auto">{c.blog.cta.text}</Button>
        </div>
      </Section>
    )
  }

  <CtaSection
    title={c.cta.title}
    description={c.cta.description}
    ctaText={c.cta.ctaText}
    ctaHref={c.cta.ctaHref}
    reassurance={c.cta.reassurance}
  />
</BaseLayout>

<script>
  import { motionEnabled } from "../scripts/core/motion";

  function initGauge() {
    const g = document.querySelector<SVGElement>("[data-gauge]");
    if (!g) return;
    if (!motionEnabled()) {
      g.dataset.gauge = "done";
      return;
    }
    const io = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        g.dataset.gauge = "run";
      },
      { threshold: 0.6 },
    );
    io.observe(g);
  }

  function initMarquee() {
    const vp = document.querySelector<HTMLElement>("[data-marquee]");
    const track = vp?.firstElementChild;
    if (!vp || !track || vp.dataset.bound) return;
    vp.dataset.bound = "1";
    const SPEED = 40;
    let paused = false;
    let visible = false;
    let running = false;
    let resumeTimer = 0;
    let last = 0;
    let pos = vp.scrollLeft;
    let half = 0;
    let width = 0;
    const measure = () => {
      half = vp.scrollWidth / 2;
      width = vp.clientWidth;
    };
    const tick = (now: number) => {
      if (!vp.isConnected || !visible || !motionEnabled()) {
        running = false;
        last = 0;
        return;
      }
      const dt = last ? Math.min(now - last, 100) : 0;
      last = now;
      if (!paused && half > width) {
        pos += (SPEED * dt) / 1000;
        if (pos >= half) pos -= half;
        vp.scrollLeft = pos;
      } else {
        pos = vp.scrollLeft;
      }
      requestAnimationFrame(tick);
    };
    const start = () => {
      if (running || !visible || !motionEnabled()) return;
      running = true;
      requestAnimationFrame(tick);
    };
    const sync = () => {
      if (!vp.isConnected) {
        window.removeEventListener("auxo:motionchange", sync);
        return;
      }
      vp.toggleAttribute("data-static", !motionEnabled());
      measure();
      start();
    };
    const pause = () => {
      paused = true;
      clearTimeout(resumeTimer);
    };
    const resumeSoon = (ms: number) => {
      clearTimeout(resumeTimer);
      resumeTimer = window.setTimeout(() => {
        pos = half ? vp.scrollLeft % half : vp.scrollLeft;
        paused = false;
      }, ms);
    };
    vp.addEventListener("pointerenter", (e) => { if (e.pointerType === "mouse") pause(); });
    vp.addEventListener("pointerleave", (e) => { if (e.pointerType === "mouse") resumeSoon(0); });
    vp.addEventListener("touchstart", pause, { passive: true });
    vp.addEventListener("touchend", () => resumeSoon(2000), { passive: true });
    vp.addEventListener("focusin", pause);
    vp.addEventListener("focusout", () => resumeSoon(0));
    const ro = new ResizeObserver(measure);
    ro.observe(vp);
    ro.observe(track);
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      start();
    }).observe(vp);
    window.addEventListener("auxo:motionchange", sync);
    sync();
  }

  function initCube() {
    document.querySelectorAll<HTMLButtonElement>("[data-cube-tile]").forEach((tile) => {
      if (tile.dataset.bound) return;
      tile.dataset.bound = "1";
      tile.addEventListener("click", (e) => {
        if ((e as PointerEvent).pointerType === "mouse" && window.matchMedia("(hover: hover)").matches) return;
        const on = tile.getAttribute("aria-pressed") !== "true";
        tile.setAttribute("aria-pressed", String(on));
      });
      tile.addEventListener("blur", () => tile.setAttribute("aria-pressed", "false"));
    });
  }

  document.addEventListener("astro:page-load", () => {
    initGauge();
    initMarquee();
    initCube();
  });
</script>
