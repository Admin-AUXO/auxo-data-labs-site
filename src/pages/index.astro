---
import { Icon } from "astro-icon/components";
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/layout/Section.astro";
import SectionHeader from "../components/ui/SectionHeader.astro";
import Button from "../components/ui/Button.astro";
import HighlightText from "../components/ui/HighlightText.astro";
import FootnoteRef from "../components/ui/FootnoteRef.astro";
import CtaSection from "../components/sections/shared/CtaSection.astro";
import { homeContent as c } from "../data/home";
import "../styles/pages/home.css";

const logoLoop = [...c.logos.items, ...c.logos.items];
const restWord = c.hero.words[c.hero.words.length - 1];

const angleOrder = (slug: string) => {
  const i = c.blog.angles.findIndex((a) => a.slug === slug);
  return i === -1 ? c.blog.angles.length : i;
};

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf() || angleOrder(a.id) - angleOrder(b.id))
  .slice(0, 3)
  .map((post) => ({
    href: `/blog/${post.id}/`,
    title: post.data.title,
    angle: c.blog.angles.find((a) => a.slug === post.id)?.label ?? post.data.tags[0],
    description: post.data.description,
  }));
---
<BaseLayout title={c.meta.title} description={c.meta.description} footnotes>
  <Section padding="lg" width="7xl" class="home-hero">
    <div class="home-hero__inner">
      <div class="home-hero__main">
        <h1 class="home-hero__title" data-enter="headline" data-words={c.hero.words.join(" ")}>Your <span class="hero-word">{restWord},</span> {c.hero.titleRest} <span class="hl-accent">{c.hero.titleHighlight}</span></h1>
        <div class="home-hero__row">
          <p class="lead home-hero__lead" data-enter>{c.hero.subtitle}</p>
          <div class="home-hero__ctas" data-enter>
            <Button variant="primary" size="lg" href={c.hero.primaryCta.href} icon class="w-full sm:w-auto">
              {c.hero.primaryCta.text}
            </Button>
            <Button variant="secondary" size="lg" href={c.hero.secondaryCta.href} class="w-full sm:w-auto">
              {c.hero.secondaryCta.text}
            </Button>
          </div>
        </div>
      </div>
      <p class="home-proof" data-enter>
        <Icon name="mdi:account-tie-outline" class="home-proof__icon" aria-hidden="true" />
        <span>{c.proof.text}</span>
        <a href={c.proof.link.href} class="home-proof__link">{c.proof.link.text}</a>
      </p>
    </div>
  </Section>

  <Section padding="lg" width="7xl">
    <div class="home-fix">
      <div class="home-head">
        <SectionHeader title={c.problem.title} subtitle={c.problem.lead} />
      </div>
      <ol class="stuck" aria-label={c.problem.listLabel}>
        {
          c.problem.items.map((p, i) => (
            <li class="stuck__card" data-anim="rise" style={`--i:${i}`}>
              <span class="sq" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
              <h3 class="stuck__title">{p.title}</h3>
              <p class="stuck__desc">{p.desc}</p>
              <p class="stuck__fix">
                <Icon name="mdi:arrow-right" aria-hidden="true" />
                {p.fix}
              </p>
            </li>
          ))
        }
      </ol>
      <div class="score-card" data-reveal>
        <svg class="score-gauge" data-gauge="idle" viewBox="0 0 120 70" aria-hidden="true">
          <path class="score-gauge__track" d="M10 62 A50 50 0 0 1 110 62" pathLength="100" />
          <path class="score-gauge__fill" d="M10 62 A50 50 0 0 1 110 62" pathLength="100" />
        </svg>
        <div class="flex flex-col gap-3">
          <h2 class="font-bold">{c.score.title}</h2>
          <p class="max-w-xl text-lg text-muted text-balance">{c.score.stat}</p>
        </div>
        <div class="flex flex-col items-start gap-3 min-[56rem]:items-end">
          <Button variant="secondary" size="lg" href={c.score.cta.href} icon class="w-full sm:w-auto">
            {c.score.cta.text}
          </Button>
          <p class="text-sm text-subtle text-pretty min-[56rem]:text-end">{c.score.reassurance}</p>
        </div>
      </div>
    </div>
  </Section>

  <Section padding="sm" width="7xl">
    <div class="logos" data-reveal>
      <p class="eyebrow logos__label" id="works-with-label">{c.logos.label}</p>
      <div class="logos__viewport" data-marquee tabindex="0" role="region" aria-labelledby="works-with-label">
        <ul class="logos__track" aria-labelledby="works-with-label">
          {
            logoLoop.map((logo, i) => (
              <li class="logos__item" aria-hidden={i >= c.logos.items.length ? "true" : undefined}>
                <Icon name={logo.icon} class="logos__icon" aria-hidden="true" />
                <span class="logos__name">{logo.name}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <p class="logos__note text-subtle">{c.logos.note}</p>
    </div>
  </Section>

  <Section padding="lg" width="7xl">
    <div class="home-fix">
      <div class="home-head">
        <SectionHeader title={c.outcomes.title} subtitle={c.outcomes.lead} />
      </div>
      <ul class="proof" aria-label={c.outcomes.listLabel}>
        {
          c.outcomes.items.map((o, i) => (
            <li class:list={["proof__card", o.lead && "proof__card--lead"]} data-anim="rise" style={`--i:${i}`}>
              <p class="proof__figure">{o.figure}</p>
              <p class="proof__line">{o.line}</p>
              <p class="proof__source">
                {o.source}<FootnoteRef id={o.footnoteId} />
              </p>
            </li>
          ))
        }
      </ul>
      <div class="proof__foot">
        <p>{c.outcomes.note}</p>
        <Button variant="secondary" href={c.outcomes.cta.href} icon class="w-full sm:w-auto">{c.outcomes.cta.text}</Button>
      </div>
    </div>
  </Section>

  <Section padding="lg" width="7xl">
    <div class="home-fix">
      <div class="home-head">
        <SectionHeader title={c.pillarsHeader.title} subtitle={c.pillarsHeader.lead} />
      </div>
      <ul class="cube" aria-label={c.pillarsLabel}>
        {
          c.pillars.map((p) => (
            <li class="cube__cell">
              <button type="button" class="cube__tile" aria-pressed="false" data-cube-tile>
                <span class="cube__face cube__face--front">
                  <span class="cube__letter" aria-hidden="true">{p.letter}</span>
                  <span class="cube__title">{p.title}</span>
                </span>
                <span class="cube__face cube__face--back">
                  <span class="cube__back-title">{p.title}</span>
                  <span class="cube__desc">{p.desc}</span>
                </span>
              </button>
            </li>
          ))
        }
      </ul>
    </div>
  </Section>

  <Section padding="lg" width="7xl" background="accent">
    <div class="trace-band">
      <div class="compare-head">
        <h2 class="compare-head__title"><HighlightText text={c.path.title} soften /></h2>
        <p class="compare-head__lead">{c.path.lead}</p>
        <ol class="path">
          {
            c.path.steps.map((s, i) => (
              <li class="path__step">
                <span class="path__num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
                <div>
                  <h3 class="path__title">
                    {s.title}
                    {s.noCharge && <span class="path__tag">{c.path.noChargeLabel}</span>}
                  </h3>
                  <p class="path__desc">{s.desc}</p>
                </div>
              </li>
            ))
          }
        </ol>
        <a class="compare__link" href={c.path.link.href}>
          {c.path.link.text}
          <Icon name="mdi:arrow-right" aria-hidden="true" />
        </a>
      </div>
      <figure class="sample ground-night" data-reveal>
        <figcaption class="sample__label">{c.path.sample.label}</figcaption>
        <div class="sample__head">
          <p class="sample__title">{c.path.sample.title}</p>
          <p class="sample__total"><b>{c.path.sample.total}</b><small>/100</small></p>
          <span class="sample__band">{c.path.sample.band}</span>
        </div>
        <table class="sample__dims">
          <caption class="sr-only">{c.path.sample.title}, by check, out of 100</caption>
          <tbody>
            {
              c.path.sample.dims.map((d) => (
                <tr data-tone={d.value >= 60 ? "ok" : d.value >= 40 ? "warn" : "crit"}>
                  <th scope="row">{d.name}</th>
                  <td class="sample__meter"><span style={`inline-size:${d.value}%`}></span></td>
                  <td class="sample__value">{d.value}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
        <p class="sample__fix"><b>{c.path.sample.fixLabel}.</b> {c.path.sample.fix}</p>
        <a class="compare__link" href={c.path.cta.href}>
          {c.path.cta.text}
          <Icon name="mdi:arrow-right" aria-hidden="true" />
        </a>
      </figure>
    </div>
  </Section>

  <Section padding="lg" width="7xl">
    <ul class="explore" aria-label={c.explore.label}>
      {
        c.explore.items.map((item, i) => (
          <li data-anim="rise" style={`--i:${i}`}>
            <a class="explore__card" href={item.cta.href}>
              <h2 class="explore__title"><HighlightText text={item.title} soften /></h2>
              <p class="explore__lead">{item.lead}</p>
              <span class="explore__cta go">
                {item.cta.text}
                <span class="sq"><Icon name="mdi:arrow-right" aria-hidden="true" /></span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </Section>

  {
    posts.length > 0 && (
      <Section padding="lg" width="7xl">
        <div class="home-head">
          <SectionHeader title={c.blog.title} subtitle={c.blog.lead} />
        </div>
        <ul class="posts mt-8">
          {posts.map((post, i) => (
            <li data-anim="rise" style={`--i:${i}`}>
              <article class="posts__card">
                <p class="posts__angle">{post.angle}</p>
                <h3 class="posts__title">
                  <a href={post.href} class="posts__link">{post.title}</a>
                </h3>
                <p class="posts__desc">{post.description}</p>
                <div class="posts__foot go" aria-hidden="true">
                  {c.blog.linkText}
                  <span class="sq"><Icon name="mdi:arrow-right" /></span>
                </div>
              </article>
            </li>
          ))}
        </ul>
        <div class="home-more">
          <Button variant="secondary" href={c.blog.cta.href} icon class="w-full sm:w-auto">{c.blog.cta.text}</Button>
        </div>
      </Section>
    )
  }

  <CtaSection
    title={c.cta.title}
    description={c.cta.description}
    ctaText={c.cta.ctaText}
    ctaHref={c.cta.ctaHref}
    secondaryText={c.cta.secondaryText}
    secondaryHref={c.cta.secondaryHref}
    reassurance={c.cta.reassurance}
  />
</BaseLayout>

<script>
  import { motionEnabled } from "../scripts/core/motion";

  let wordTimers: number[] = [];

  function initHeroWords() {
    wordTimers.forEach(clearTimeout);
    wordTimers = [];
    const head = document.querySelector<HTMLElement>("[data-words]");
    const word = head?.querySelector<HTMLElement>(".hero-word");
    if (!head || !word || !motionEnabled()) return;
    const words = (head.dataset.words ?? "").split(" ").filter(Boolean);
    if (words.length < 2) return;
    const show = (w: string) => {
      word.textContent = `${w},`;
      word.style.animation = "none";
      void word.offsetWidth;
      word.style.animation = "m-word 0.42s var(--ease-asmr) both";
    };
    word.textContent = `${words[0]},`;
    words.slice(1).forEach((w, i) => {
      wordTimers.push(window.setTimeout(() => show(w), 1100 + i * 950));
    });
  }

  function initGauge() {
    const g = document.querySelector<SVGElement>("[data-gauge]");
    if (!g) return;
    g.style.setProperty("--gauge-off", String(20 + Math.round(Math.random() * 45)));
    if (!motionEnabled()) {
      g.dataset.gauge = "done";
      return;
    }
    const io = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        g.dataset.gauge = "run";
      },
      { threshold: 0.3 },
    );
    io.observe(g);
  }

  function initMarquee() {
    const vp = document.querySelector<HTMLElement>("[data-marquee]");
    const track = vp?.firstElementChild;
    if (!vp || !track || vp.dataset.bound) return;
    vp.dataset.bound = "1";
    const SPEED = 40;
    let paused = false;
    let visible = false;
    let running = false;
    let resumeTimer = 0;
    let last = 0;
    let pos = vp.scrollLeft;
    let half = 0;
    let width = 0;
    const measure = () => {
      half = vp.scrollWidth / 2;
      width = vp.clientWidth;
    };
    const tick = (now: number) => {
      if (!vp.isConnected || !visible || !motionEnabled()) {
        running = false;
        last = 0;
        return;
      }
      const dt = last ? Math.min(now - last, 100) : 0;
      last = now;
      if (!paused && half > width) {
        pos += (SPEED * dt) / 1000;
        if (pos >= half) pos -= half;
        vp.scrollLeft = pos;
      } else {
        pos = vp.scrollLeft;
      }
      requestAnimationFrame(tick);
    };
    const start = () => {
      if (running || !visible || !motionEnabled()) return;
      running = true;
      requestAnimationFrame(tick);
    };
    const sync = () => {
      if (!vp.isConnected) {
        window.removeEventListener("auxo:motionchange", sync);
        return;
      }
      vp.toggleAttribute("data-static", !motionEnabled());
      measure();
      start();
    };
    const pause = () => {
      paused = true;
      clearTimeout(resumeTimer);
    };
    const resumeSoon = (ms: number) => {
      clearTimeout(resumeTimer);
      resumeTimer = window.setTimeout(() => {
        pos = half ? vp.scrollLeft % half : vp.scrollLeft;
        paused = false;
      }, ms);
    };
    vp.addEventListener("pointerenter", (e) => { if (e.pointerType === "mouse") pause(); });
    vp.addEventListener("pointerleave", (e) => { if (e.pointerType === "mouse") resumeSoon(0); });
    vp.addEventListener("touchstart", pause, { passive: true });
    vp.addEventListener("touchend", () => resumeSoon(2000), { passive: true });
    vp.addEventListener("focusin", pause);
    vp.addEventListener("focusout", () => resumeSoon(0));
    const ro = new ResizeObserver(measure);
    ro.observe(vp);
    ro.observe(track);
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      start();
    }).observe(vp);
    window.addEventListener("auxo:motionchange", sync);
    sync();
  }

  function initCube() {
    document.querySelectorAll<HTMLButtonElement>("[data-cube-tile]").forEach((tile) => {
      if (tile.dataset.bound) return;
      tile.dataset.bound = "1";
      tile.addEventListener("click", (e) => {
        if ((e as PointerEvent).pointerType === "mouse" && window.matchMedia("(hover: hover)").matches) return;
        const on = tile.getAttribute("aria-pressed") !== "true";
        tile.setAttribute("aria-pressed", String(on));
      });
      tile.addEventListener("blur", () => tile.setAttribute("aria-pressed", "false"));
    });
  }

  document.addEventListener("astro:page-load", () => {
    initHeroWords();
    initGauge();
    initMarquee();
    initCube();
  });

  document.addEventListener("astro:before-swap", () => {
    wordTimers.forEach(clearTimeout);
    wordTimers = [];
  });
</script>
