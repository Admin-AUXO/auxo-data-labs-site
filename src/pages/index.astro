---
import { Icon } from "astro-icon/components";
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/layout/Section.astro";
import Button from "../components/ui/Button.astro";
import FootnoteRef from "../components/ui/FootnoteRef.astro";
import { homeContent as c } from "../data/home";
import { withBase } from "../lib/url";
import "../styles/pages/home.css";
import "../styles/pages/type-scale.css";

// Duplicate the logo set so the marquee loops seamlessly; the copy is hidden from assistive tech.
const logoLoop = [...c.logos.items, ...c.logos.items];
---

<BaseLayout
  title="Analytics & AI for Gulf businesses"
  description="We turn messy, fragmented data into decisions Gulf businesses act on. Analytics and AI, built to last and yours to keep."
>
  <!-- 1. Hero -->
  <Section padding="lg" width="7xl" class="home-hero">
    <div class="flex flex-col gap-6">
      <h1 class="text-display text-display--5xl max-w-[20ch]" data-enter="headline">{c.hero.title}</h1>
      <p class="lead max-w-2xl text-xl" data-enter>{c.hero.subtitle}</p>
      <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center" data-enter>
        <Button variant="primary" size="lg" href={c.hero.primaryCta.href} icon class="w-full sm:w-auto">
          {c.hero.primaryCta.text}
        </Button>
        <Button variant="secondary" size="lg" href={c.hero.secondaryCta.href} class="w-full sm:w-auto">
          {c.hero.secondaryCta.text}
        </Button>
      </div>
    </div>
  </Section>

  <!-- 2. AUXO Score -->
  <Section padding="md" width="6xl">
    <div class="score-card" data-reveal>
      <svg class="score-gauge" data-gauge="idle" viewBox="0 0 120 70" aria-hidden="true">
        <path class="score-gauge__track" d="M10 62 A50 50 0 0 1 110 62" pathLength="100" />
        <path class="score-gauge__fill" d="M10 62 A50 50 0 0 1 110 62" pathLength="100" />
      </svg>
      <div class="flex flex-col gap-3">
        <h2 class="text-3xl font-bold sm:text-4xl">{c.score.title}</h2>
        <p class="max-w-xl text-lg text-muted">
          {c.score.stat}<FootnoteRef id={c.score.footnoteId} />
        </p>
      </div>
      <div class="flex flex-col items-start gap-3 sm:items-end">
        <Button variant="primary" size="lg" href={c.score.cta.href} icon class="w-full sm:w-auto">
          {c.score.cta.text}
        </Button>
        <p class="text-sm text-subtle">{c.score.reassurance}</p>
      </div>
    </div>
  </Section>

  <!-- 3. Built on -->
  <Section padding="sm" width="7xl">
    <div class="logos" data-reveal>
      <p class="eyebrow logos__label" id="built-on-label">{c.logos.label}</p>
      <div class="logos__viewport" data-marquee>
        <ul class="logos__track" aria-labelledby="built-on-label">
          {
            logoLoop.map((logo, i) => (
              <li class="logos__item" aria-hidden={i >= c.logos.items.length ? "true" : undefined} style={logo.color ? `--brand:${logo.color}` : undefined}>
                {logo.icon ? (
                  <Icon name={logo.icon} class="logos__icon" aria-hidden="true" />
                ) : (
                  <span class="logos__wordmark" aria-hidden="true">{logo.name}</span>
                )}
                <span class="logos__name">{logo.name}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </Section>

  <!-- 4. Four pillars: a 2x2 cube like the AUXO mark; each tile flips to a short description -->
  <Section padding="md" width="7xl">
    <ul class="cube" aria-label="What we build">
      {
        c.pillars.map((p) => (
          <li class="cube__cell">
            <button type="button" class="cube__tile" aria-pressed="false" data-cube-tile>
              <span class="cube__face cube__face--front">
                <span class="cube__letter" aria-hidden="true">{p.letter}</span>
                <span class="cube__title">{p.title}</span>
              </span>
              <span class="cube__face cube__face--back">
                <span class="cube__back-title">{p.title}</span>
                <span class="cube__desc">{p.desc}</span>
              </span>
            </button>
          </li>
        ))
      }
    </ul>
  </Section>

  <!-- 5. Three cards -->
  <Section padding="md" width="7xl">
    <div class="cards">
      {
        c.cards.map((card, i) => (
          <a href={withBase(card.href)} class="cards__card" data-anim="rise" style={`--i:${i}`}>
            <span class="mono-datum text-accent-2">{String(i + 1).padStart(2, "0")}</span>
            <span class="cards__title">{card.title}</span>
            <Icon name="mdi:arrow-right" class="cards__arrow" aria-hidden="true" />
          </a>
        ))
      }
    </div>
  </Section>

  <!-- 6. Contact -->
  <Section padding="lg" width="6xl">
    <div class="home-cta" data-reveal>
      <h2 class="text-display text-display--4xl">{c.cta.title}</h2>
      <p class="lead mx-auto max-w-xl text-balance">{c.cta.description}</p>
      <Button variant="primary" size="lg" href={c.cta.ctaHref} icon class="w-full sm:w-auto">{c.cta.ctaText}</Button>
      <p class="text-sm text-subtle">{c.cta.reassurance}</p>
    </div>
  </Section>
</BaseLayout>

<script>
  import { motionEnabled } from "../scripts/core/motion";

  // Fill the score gauge once when it scrolls into view. Motion-off users see it filled already.
  function initGauge() {
    const g = document.querySelector<SVGElement>("[data-gauge]");
    if (!g) return;
    if (!motionEnabled()) {
      g.dataset.gauge = "done";
      return;
    }
    const io = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        g.dataset.gauge = "run";
      },
      { threshold: 0.6 },
    );
    io.observe(g);
  }

  document.addEventListener("astro:page-load", initGauge);

  // Logo marquee: runs by default (stops only for prefers-reduced-motion), pauses on hover,
  // on touch, and on keyboard focus; on phones it can also be swiped by hand.
  function initMarquee() {
    const vp = document.querySelector<HTMLElement>("[data-marquee]");
    if (!vp || vp.dataset.bound) return;
    vp.dataset.bound = "1";
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduce) {
      vp.dataset.static = "";
      return;
    }
    const SPEED = 40; // px per second
    let paused = false;
    let resumeTimer = 0;
    let last = 0;
    let pos = vp.scrollLeft;
    const tick = (now: number) => {
      if (!vp.isConnected) return;
      const dt = last ? Math.min(now - last, 100) : 0;
      last = now;
      const half = vp.scrollWidth / 2;
      if (!paused && !document.hidden && half > vp.clientWidth) {
        pos += (SPEED * dt) / 1000;
        if (pos >= half) pos -= half;
        vp.scrollLeft = pos;
      } else {
        pos = vp.scrollLeft;
      }
      requestAnimationFrame(tick);
    };
    const pause = () => {
      paused = true;
      clearTimeout(resumeTimer);
    };
    const resumeSoon = (ms: number) => {
      clearTimeout(resumeTimer);
      resumeTimer = window.setTimeout(() => {
        pos = vp.scrollLeft % (vp.scrollWidth / 2);
        paused = false;
      }, ms);
    };
    vp.addEventListener("pointerenter", (e) => { if (e.pointerType === "mouse") pause(); });
    vp.addEventListener("pointerleave", (e) => { if (e.pointerType === "mouse") resumeSoon(0); });
    vp.addEventListener("touchstart", pause, { passive: true });
    vp.addEventListener("touchend", () => resumeSoon(2000), { passive: true });
    vp.addEventListener("focusin", pause);
    vp.addEventListener("focusout", () => resumeSoon(0));
    requestAnimationFrame(tick);
  }

  // Cube tiles: hover flips on desktop (CSS); tap or Enter/Space toggles for touch and keyboard.
  function initCube() {
    document.querySelectorAll<HTMLButtonElement>("[data-cube-tile]").forEach((tile) => {
      if (tile.dataset.bound) return;
      tile.dataset.bound = "1";
      tile.addEventListener("click", () => {
        const on = tile.getAttribute("aria-pressed") !== "true";
        tile.setAttribute("aria-pressed", String(on));
      });
    });
  }

  document.addEventListener("astro:page-load", () => {
    initMarquee();
    initCube();
  });
</script>
