---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { servicePageDetails } from "../../data/services";
import ServiceHero from "../../components/sections/service-detail/ServiceHero.astro";
import ServiceSnapshot from "../../components/sections/service-detail/ServiceSnapshot.astro";
import ServiceOverview from "../../components/sections/service-detail/ServiceOverview.astro";
import ServiceBenefits from "../../components/sections/service-detail/ServiceBenefits.astro";
import ServiceProcess from "../../components/sections/service-detail/ServiceProcess.astro";
import ServiceOutcomes from "../../components/sections/service-detail/ServiceOutcomes.astro";
import ServiceFaq from "../../components/sections/service-detail/ServiceFaq.astro";
import CtaSection from "../../components/sections/shared/CtaSection.astro";

export function getStaticPaths() {
  return servicePageDetails.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
---

<BaseLayout title={service.name} description={service.shortDescription}>
  <ServiceHero category={service.category} hero={service.hero} />
  <ServiceSnapshot snapshot={service.snapshot} />
  <ServiceOverview overview={service.overview} />
  <ServiceBenefits benefits={service.benefits} />
  <ServiceProcess process={service.process} />
  <ServiceOutcomes outcomes={service.outcomes} />
  <ServiceFaq faq={service.faq} />
  <CtaSection
    eyebrow={service.category}
    title={service.cta.title}
    description={service.cta.description}
    descriptionHighlight={service.cta.descriptionHighlight}
    ctaText={service.cta.ctaText}
    ctaHref={service.cta.ctaHref}
  />
</BaseLayout>
