---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/layout/Section.astro";
---
<BaseLayout
  title="Marketplace: the AI stack for every team"
  description="AI tools vetted by AUXO, set up on your data in your own accounts, and managed if you want it. Plus AUXO's own sales and content agents."
>
  <Section padding="xl" width="7xl">
    <div class="flex max-w-3xl flex-col gap-6">
      <h1 class="text-display text-display--5xl max-w-[16ch]">The AI stack for every team.</h1>
      <p class="lead max-w-2xl text-xl">Tools vetted by AUXO. Set up on your data. Managed if you want it.</p>
    </div>
  </Section>
</BaseLayout>
