---
import { Icon } from "astro-icon/components";
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/layout/Section.astro";
import SectionHeader from "../components/ui/SectionHeader.astro";
import Button from "../components/ui/Button.astro";
import Accordion from "../components/ui/Accordion.astro";
import CtaSection from "../components/sections/shared/CtaSection.astro";
import StructuredData from "../components/layout/StructuredData.astro";
import { faqSchema } from "../lib/structured-data";
import {
  marketplaceContent as c,
  marketplaceCards as cards,
  addToStackHref,
  stackRequestBase,
} from "../data/marketplace";
import { escapeHtml, fill } from "../lib/text";
import "../styles/pages/marketplace.css";

const faqItems = c.faq.items.map((i) => ({ title: i.question, body: escapeHtml(i.answer) }));
const all = c.filters.categories[0];
---
<BaseLayout title={c.meta.title} description={c.meta.description}>
  <Section padding="lg" width="7xl">
    <div class="mkt-hero">
      <div class="flex flex-col gap-6">
        <p class="section-index" data-enter>{c.hero.eyebrow}</p>
        <h1 class="text-display text-display--hero max-w-[16ch]" data-enter="headline">{c.hero.title}</h1>
        <p class="lead max-w-xl" data-enter>{c.hero.lead}</p>
      </div>
      <div class="mkt-why" data-enter>
        <h2 class="mkt-why__title">{c.why.title}</h2>
        <ul class="mkt-why__list">
          {
            c.why.items.map((item) => (
              <li class="mkt-why__item">
                <Icon name={item.icon} class="mkt-why__icon" aria-hidden="true" />
                <h3 class="mkt-why__name">{item.title}</h3>
                <p class="mkt-why__body">{item.body}</p>
              </li>
            ))
          }
        </ul>
        <div class="mkt-how__faq" data-reveal>
          <Accordion items={faqItems.slice(1)} />
        </div>
      </div>
    </div>
  </Section>

  <Section id="tools" padding="sm" width="7xl" class="mkt-anchor">
    <div
      class="mkt"
      data-marketplace
      data-results-one={c.filters.resultsOne}
      data-results-many={c.filters.resultsMany}
      data-label-add={c.card.addToStack}
      data-label-added={c.card.addedState}
      data-count-one={c.tray.countOne}
      data-count-many={c.tray.countMany}
      data-request-base={stackRequestBase}
    >
      <div class="mkt-filters">
        <div class="mkt-filters__chips" role="group" aria-label={c.filters.ariaLabel}>
          <Icon name="mdi:filter-variant" class="mkt-filters__icon" aria-hidden="true" />
          {
            c.filters.categories.map((cat) => (
              <button
                type="button"
                class="mkt-chip"
                data-filter={cat.slug}
                data-description={cat.description}
                aria-pressed={cat.slug === "all" ? "true" : "false"}
              >
                <Icon name={cat.icon} class="mkt-chip__icon" aria-hidden="true" />
                {cat.label}
              </button>
            ))
          }
        </div>
        <div class="mkt-filters__status" aria-live="polite">
          <p class="mkt-filters__desc" data-filter-desc>{all.description}</p>
          <p class="mkt-filters__count" data-filter-count>
            {fill(c.filters.resultsMany, { n: cards.length })}
          </p>
        </div>
        <p class="mkt-paynote">{c.payNote}</p>
      </div>

      <ul class="mkt-grid">
        {
          cards.map((card) => {
            const badge = c.badges[card.badgeKey];
            const nameId = `tool-${card.slug}-name`;
            return (
              <li
                class="mkt-card"
                id={`tool-${card.slug}`}
                data-category={card.category}
                data-kind={card.kind}
                data-flipped="false"
              >
                <div class="mkt-flip">
                  <div class="mkt-face mkt-face--front" data-mkt-face="front">
                    <div class="mkt-card__top">
                      <span class="mkt-badge" data-badge={card.badgeKey} title={badge.meaning}>
                        <Icon name={badge.icon} aria-hidden="true" />
                        {card.badge}
                      </span>
                      <button
                        type="button"
                        class="mkt-more"
                        data-mkt-flip
                        aria-expanded="false"
                        aria-label={`${c.card.detailsLabel}: ${card.name}`}
                      >
                        {c.card.detailsLabel}
                        <span aria-hidden="true">&rarr;</span>
                      </button>
                    </div>
                    <div class="mkt-card__head">
                      <h2 class="mkt-card__name" id={nameId}>{card.name}</h2>
                      <p class="mkt-card__vendor">
                        {fill(c.card.vendorLabel, { vendor: card.vendor })}
                        {card.status && <span class="mkt-status">{card.status}</span>}
                      </p>
                    </div>
                    <p class="mkt-card__line">{card.short}</p>
                    <p class="mkt-card__live">
                      <Icon name="mdi:clock-outline" aria-hidden="true" />
                      <span>
                        {c.card.liveInLabel} <strong>{card.liveIn}</strong>{" "}
                        <span class="mkt-card__typical">{c.card.liveInSuffix}</span>
                      </span>
                    </p>
                    <div class="mkt-card__foot">
                      {card.kind === "built-by-auxo" && <p class="mkt-card__pay">{card.howYouPay}</p>}
                      <a
                        class="btn mkt-add"
                        data-no-cta
                        data-variant="outline"
                        data-size="sm"
                        href={addToStackHref(card.slug)}
                        aria-describedby={nameId}
                        data-add-to-stack={card.slug}
                      >
                        <Icon name="mdi:plus" class="mkt-add__plus" aria-hidden="true" />
                        <Icon name="mdi:check" class="mkt-add__check" aria-hidden="true" />
                        <span data-add-label>{c.card.addToStack}</span>
                      </a>
                    </div>
                  </div>
                  <div class="mkt-face mkt-face--back" data-mkt-face="back">
                    <div class="mkt-card__top">
                      <p class="mkt-card__back-name">{card.name}</p>
                      <button
                        type="button"
                        class="mkt-more"
                        data-mkt-flip
                        aria-expanded="true"
                        aria-label={`${c.card.backLabel}: ${card.name}`}
                      >
                        <span aria-hidden="true">&larr;</span>
                        {c.card.backLabel}
                      </button>
                    </div>
                    <dl class="mkt-card__spec">
                      <div>
                        <dt>{c.card.bestForLabel}</dt>
                        <dd>{card.bestFor}</dd>
                      </div>
                      <div>
                        <dt>{c.card.setupLabel}</dt>
                        <dd>{card.setup}</dd>
                      </div>
                    </dl>
                    {card.includes && (
                      <div class="mkt-card__includes">
                        <p class="mkt-card__label">{c.card.includesLabel}</p>
                        <ul class="mkt-card__chips">
                          {card.includes.map((inc) => (
                            <li class="mkt-mini-chip">{inc.name}</li>
                          ))}
                        </ul>
                        {card.note && <p class="mkt-card__note">{card.note}</p>}
                      </div>
                    )}
                    {card.kind === "built-by-auxo" && (
                      <div class="mkt-card__agent">
                        <ul class="mkt-card__facts">
                          {c.card.agentFacts.map((f) => (
                            <li>
                              <Icon name="mdi:check" aria-hidden="true" />
                              {f}
                            </li>
                          ))}
                        </ul>
                        <p class="mkt-card__note">{c.card.agentDetail}</p>
                      </div>
                    )}
                    <div class="mkt-card__terms">
                      <p>
                        <span>{c.card.payLabel}</span> {card.howYouPay}
                      </p>
                      {card.vendorBilling && (
                        <p>
                          <span>{c.card.vendorBillingLabel}</span> {card.vendorBilling}
                        </p>
                      )}
                      {card.kind === "third-party" && <p class="mkt-card__meaning">{badge.meaning}</p>}
                      {card.url && (
                        <a class="mkt-card__link" href={card.url} target="_blank" rel="noopener">
                          {c.card.vendorLink}
                          <span class="sr-only">: {card.name}</span>
                          <Icon name="mdi:open-in-new" aria-hidden="true" />
                        </a>
                      )}
                    </div>
                    {card.disclosures.map((d) => (
                      <p class="mkt-card__disclosure">{d}</p>
                    ))}
                  </div>
                </div>
              </li>
            );
          })
        }
      </ul>

      <p class="mkt-paynote">{c.liveInNote}</p>

      <div class="mkt-card mkt-card--custom" data-custom-stack={c.customStack.href}>
        <span class="mkt-card__glyph" aria-hidden="true">
          <Icon name="mdi:layers-outline" />
        </span>
        <div class="mkt-card__head">
          <h2 class="mkt-card__name">{c.customStack.title}</h2>
          <p class="mkt-card__vendor">{c.customStack.line}</p>
        </div>
        <p class="mkt-card__line">{c.customStack.body}</p>
        <div class="mkt-card__foot">
          <Button variant="primary" size="sm" href={c.customStack.href} icon>{c.customStack.cta}</Button>
        </div>
      </div>


      <div class="mkt-tray" data-stack-tray hidden>
        <p class="mkt-tray__count" data-stack-count aria-live="polite"></p>
        <div class="mkt-tray__actions">
          <button type="button" class="btn" data-variant="ghost" data-size="sm" data-stack-clear data-no-cta>
            <Icon name="mdi:close" aria-hidden="true" />
            {c.tray.clear}
          </button>
          <a class="btn" data-variant="primary" data-size="sm" href={stackRequestBase} data-stack-request>
            {c.tray.action}
            <Icon name="mdi:arrow-right" class="btn__icon" aria-hidden="true" />
          </a>
        </div>
      </div>
    </div>
  </Section>

  <Section padding="lg" width="7xl">
    <div class="mkt-how">
      <div class="mkt-how__col">
        <SectionHeader eyebrow={c.setup.eyebrow} title={c.setup.title} subtitle={c.setup.lead} />
        <ol class="mkt-how__steps">
          {
            c.setup.steps.map((step, i) => (
              <li class="mkt-how__step" data-anim="rise" style={`--i:${i}`}>
                <span class="mkt-how__num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
                <p>{step}</p>
              </li>
            ))
          }
        </ol>
        <div class="mkt-how__faq" data-reveal>
          <Accordion items={faqItems.slice(0, 1)} />
        </div>
      </div>
      <div class="mkt-how__col">
        <SectionHeader eyebrow={c.howWeGetPaid.eyebrow} title={c.howWeGetPaid.title} subtitle={c.howWeGetPaid.subline} />
        <ul class="mkt-how__paid">
          {
            c.howWeGetPaid.items.map((item, i) => (
              <li class="mkt-how__item" data-anim="rise" style={`--i:${i}`}>
                <Icon name={item.icon} class="mkt-how__icon" aria-hidden="true" />
                <h3 class="mkt-how__title">{item.title}</h3>
                <p class="mkt-how__body">{item.body}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </Section>

  <Section padding="lg" width="7xl">
    <SectionHeader eyebrow={c.vetting.eyebrow} title={c.vetting.title} subtitle={c.vetting.lead} />
    <ol class="mkt-vet mt-8">
      {
        c.vetting.items.map((v, i) => (
          <li class="mkt-vet__item" data-anim="rise" style={`--i:${i}`}>
            <span class="mkt-vet__check" aria-hidden="true">
              <Icon name="mdi:check" />
            </span>
            <div class="flex flex-col gap-1.5">
              <h3 class="mkt-vet__title">{v.title}</h3>
              <p class="text-muted">{v.body}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </Section>

  <CtaSection
    title={c.cta.title}
    description={c.cta.description}
    ctaText={c.cta.ctaText}
    ctaHref={c.cta.ctaHref}
    reassurance={c.cta.reassurance}
  />

  <StructuredData type="FAQPage" data={faqSchema(c.faq.items)} />
</BaseLayout>

<script>
  import { initMarketplace } from "../scripts/marketplace";

  initMarketplace();
  document.addEventListener("astro:page-load", initMarketplace);
</script>
