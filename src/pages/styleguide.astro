---
import "../styles/main.css";
import Section from "../components/layout/Section.astro";
import SectionHeader from "../components/ui/SectionHeader.astro";
import Button from "../components/ui/Button.astro";
import Card from "../components/ui/Card.astro";

const accent = [50, 100, 200, 300, 400, 500, 600, 700, 800, 900, 950];
const neutral = [0, 50, 100, 200, 300, 400, 500, 600, 700, 800, 850, 900, 950];
const semantics = ["background", "surface", "surface-raised", "surface-sunken", "border", "accent"];
const variants = ["primary", "secondary", "outline", "ghost"] as const;
const cards = [
  { icon: "mdi:chart-timeline-variant", title: "Decision velocity", description: "Turn data into decisions your teams can act on within the quarter.", link: "#" },
  { icon: "mdi:database-cog", title: "Data foundations", description: "Pipelines and models that stay reliable after the builder leaves.", link: "#" },
  { icon: "mdi:radar", title: "Signal clarity", description: "Cut noise so the metrics that move revenue stay visible.", metric: "3.2x" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>AUXO — Style Guide</title>
    <script is:inline>
      const t =
        localStorage.getItem("theme") ??
        (matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark");
      document.documentElement.dataset.theme = t;
    </script>
  </head>
  <body class="bg-background font-sans text-foreground">
    <Section as="div" padding="md" width="7xl">
      <header class="flex items-center justify-between gap-4">
        <div>
          <p class="font-brand text-2xl font-extrabold tracking-tight text-accent">AUXO</p>
          <h1 class="text-3xl font-bold">Design system</h1>
          <p class="text-muted">OKLCH refresh · dark + light · Tailwind 4</p>
        </div>
        <button
          id="theme-toggle"
          class="btn"
          data-variant="secondary"
          data-size="sm"
        >Toggle theme</button>
      </header>

      <div class="mt-10 space-y-3">
        <h2 class="text-xl font-semibold">Accent ramp</h2>
        <div class="grid grid-cols-6 gap-2 sm:grid-cols-11">
          {accent.map((n) => (
            <div class="space-y-1">
              <div class="h-12 rounded-md border border-border" style={`background:var(--color-accent-${n})`} />
              <p class="text-center text-xs text-muted">{n}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="mt-8 space-y-3">
        <h2 class="text-xl font-semibold">Neutral ramp</h2>
        <div class="grid grid-cols-7 gap-2 sm:grid-cols-13">
          {neutral.map((n) => (
            <div class="space-y-1">
              <div class="h-12 rounded-md border border-border" style={`background:var(--color-neutral-${n})`} />
              <p class="text-center text-xs text-muted">{n}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-6">
        {semantics.map((name) => (
          <div class="flex h-16 items-end rounded-lg border border-border p-2" style={`background:var(--${name})`}>
            <span class="rounded bg-background/60 px-1 text-[10px] text-foreground">{name}</span>
          </div>
        ))}
      </div>
    </Section>

    <Section background="surface" decoration="grid" padding="lg">
      <SectionHeader
        eyebrow="Components"
        title="A single, consistent primitive library"
        highlight="single"
        subtitle="Every button, card, and section is driven by the same semantic tokens, so dark and light stay perfectly in sync."
      />

      <div class="mt-12 space-y-4">
        <h3 class="text-lg font-semibold">Buttons — variants</h3>
        <div class="flex flex-wrap items-center gap-3">
          {variants.map((v) => <Button variant={v}>{v}</Button>)}
          <Button variant="primary" icon>With icon</Button>
          <Button variant="primary" disabled>Disabled</Button>
          <Button variant="outline" calendar>Book a call</Button>
        </div>
        <h3 class="mt-6 text-lg font-semibold">Buttons — sizes</h3>
        <div class="flex flex-wrap items-center gap-3">
          <Button size="sm">Small</Button>
          <Button size="md">Medium</Button>
          <Button size="lg" icon>Large</Button>
        </div>
      </div>

      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {cards.map((c) => (
          <Card icon={c.icon} title={c.title} description={c.description} link={c.link} metric={c.metric} interactive />
        ))}
      </div>
    </Section>

    <Section padding="lg" width="6xl">
      <h2 class="text-xl font-semibold">Type scale (fluid)</h2>
      <div class="mt-4 space-y-2">
        <p class="text-5xl font-bold tracking-tight">Display 5xl</p>
        <p class="text-4xl font-bold tracking-tight">Heading 4xl</p>
        <p class="text-3xl font-bold tracking-tight">Heading 3xl</p>
        <p class="text-2xl font-semibold">Heading 2xl</p>
        <p class="text-xl font-semibold">Heading xl</p>
        <p class="text-lg">Body large — measured, decisive analytics.</p>
        <p class="text-base">Body base — measured, decisive analytics.</p>
        <p class="text-sm text-muted">Small — supporting detail.</p>
        <p class="text-xs text-subtle">Caption — fine print.</p>
      </div>
    </Section>

    <script is:inline>
      document.getElementById("theme-toggle")?.addEventListener("click", () => {
        const next = document.documentElement.dataset.theme === "light" ? "dark" : "light";
        document.documentElement.dataset.theme = next;
        localStorage.setItem("theme", next);
      });
    </script>
  </body>
</html>
