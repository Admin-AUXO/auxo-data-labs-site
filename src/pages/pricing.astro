---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/layout/Section.astro";
---
<BaseLayout
  title="Pricing: start where you are"
  description="Free audit for funded startups, the AUXO Score for mid-sized companies, custom scope for enterprise. Every price is personal and sent privately."
>
  <Section padding="xl" width="7xl">
    <div class="flex max-w-3xl flex-col gap-6">
      <h1 class="text-display text-display--5xl max-w-[16ch]">Start where you are.</h1>
      <p class="lead max-w-2xl text-xl">Pick the path that fits your company. Every price is personal, and we send it privately after the first conversation and audit.</p>
    </div>
  </Section>
</BaseLayout>
