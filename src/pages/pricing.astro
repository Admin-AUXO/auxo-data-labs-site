---
import { Icon } from "astro-icon/components";
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/layout/Section.astro";
import SectionHeader from "../components/ui/SectionHeader.astro";
import Button from "../components/ui/Button.astro";
import Accordion from "../components/ui/Accordion.astro";
import CtaSection from "../components/sections/shared/CtaSection.astro";
import StructuredData from "../components/layout/StructuredData.astro";
import { faqSchema } from "../lib/structured-data";
import { pricingContent as c } from "../data/pricing";
import { escapeHtml } from "../lib/text";
import "../styles/pages/pricing.css";

const faqItems = c.faq.items.map((item) => ({ title: item.question, body: escapeHtml(item.answer) }));
const factKeys = ["first", "then", "time", "price", "stop"] as const;
const factIds = c.cards.items.map((p) => `${p.id}-facts`).join(" ");
const ladder = [
  { name: "Analyze", label: "Analyze" },
  { name: "Advise", label: "Advise" },
  { name: "Build", label: "Build" },
  { name: "Managed upkeep", label: "Upkeep" },
];
---
<BaseLayout title={c.metaTitle} description={c.metaDescription}>
  <Section padding="lg" width="7xl">
    <div class="plans-hero">
      <div class="flex flex-col gap-6">
        <h1 class="text-display text-display--5xl max-w-[16ch]" data-enter="headline">{c.hero.title}</h1>
        <p class="lead max-w-xl" data-enter>{c.hero.lead}</p>
      </div>
      <div class="plans-rules" data-enter>
        <h2 class="plans-rules__title">{c.hero.rulesTitle}</h2>
        <ul class="plans-rules__list">
          {
            c.hero.rules.map((r) => (
              <li class="plans-rules__item" data-tone={r.tone}>
                <Icon name={r.icon} class="plans-rules__icon" aria-hidden="true" />
                <span>{r.text}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </Section>

  <Section padding="sm" width="7xl" class="plans-section">
    <ul class="plans">
      {
        c.cards.items.map((p, i) => (
          <li id={p.id} class="plan" data-anim="rise" style={`--i:${i}`}>
            <article class="plan__body" aria-labelledby={`${p.id}-eyebrow ${p.id}-title`}>
              <header class="plan__head">
                <div class="plan__who">
                  <p id={`${p.id}-eyebrow`} class="plan__eyebrow">
                    <Icon name={p.icon} class="plan__icon" aria-hidden="true" />
                    {p.eyebrow}
                  </p>
                  <p class="plan__descriptor">{p.descriptor}</p>
                </div>
                <div class="plan__what">
                  <h2 id={`${p.id}-title`} class="plan__title">{p.title}</h2>
                  <p class="plan__subline">{p.subline}</p>
                </div>
              </header>

              <div class="plan__cta">
                <Button variant="secondary" size="lg" href={p.cta.href} icon class="w-full">
                  {p.cta.text}
                </Button>
                {p.secondary && (
                  <a class="plan__secondary" href={p.secondary.href}>
                    {p.secondary.text}
                    <Icon name="mdi:arrow-right" aria-hidden="true" />
                  </a>
                )}
                <button
                  type="button"
                  class="plan__toggle"
                  data-plans-toggle
                  aria-expanded="false"
                  aria-controls={factIds}
                  data-show={c.cards.detailsShow}
                  data-hide={c.cards.detailsHide}
                >
                  <span data-plans-label>{c.cards.detailsShow}</span>
                  <Icon name="mdi:plus" aria-hidden="true" />
                </button>
              </div>

              <dl class="plan__facts" id={`${p.id}-facts`}>
                {factKeys.map((k) => (
                  <div class="plan__fact" data-fact={k}>
                    <dt>{c.cards.factLabels[k]}</dt>
                    <dd>{p.facts[k]}</dd>
                  </div>
                ))}
              </dl>

              <div class="plan__tiers">
                <p id={`${p.id}-tiers`} class="plan__tiers-label">{c.cards.tiersLabel}</p>
                <ul class="plan__steps" aria-labelledby={`${p.id}-tiers`}>
                  {ladder.map((step) => {
                    const tier = p.tiers.find((t) => t.name === step.name);
                    return (
                      <li class="plan__step" data-on={tier ? "yes" : "no"}>
                        <Icon name={tier ? "mdi:check" : "mdi:minus"} class="plan__step-mark" aria-hidden="true" />
                        <span class="plan__step-name">{step.label}</span>
                        {tier?.note && <span class="plan__step-note">{tier.note}</span>}
                        {!tier && <span class="sr-only">{c.cards.notIncludedLabel}</span>}
                      </li>
                    );
                  })}
                </ul>
              </div>

              <p class="plan__fine">{p.finePrint}</p>
            </article>
          </li>
        ))
      }
    </ul>

    <div class="plans-includes" data-reveal>
      <h2 class="plans-includes__title">{c.includes.title}</h2>
      <ul class="plans-includes__list">
        {
          c.includes.items.map((item) => (
            <li class="plans-includes__item">
              <Icon name={item.icon} aria-hidden="true" />
              <span>{item.text}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </Section>

  <Section id="faq" padding="lg" width="7xl" class="plans-anchor">
    <div class="faq-split">
      <SectionHeader title={c.faq.title} />
      <div class="faq-split__list" data-reveal>
        <Accordion items={faqItems} openFirst />
      </div>
    </div>
  </Section>

  <CtaSection
    title={c.cta.title}
    description={c.cta.description}
    ctaText={c.cta.ctaText}
    ctaHref={c.cta.ctaHref}
    secondaryText={c.cta.secondaryText}
    secondaryHref={c.cta.secondaryHref}
    reassurance={c.cta.reassurance}
  />

  <StructuredData type="FAQPage" data={faqSchema(c.faq.items)} />
</BaseLayout>

<script>
  function initPlans(): void {
    const list = document.querySelector<HTMLElement>(".plans");
    if (!list || list.dataset.bound === "true") return;
    list.dataset.bound = "true";
    const buttons = Array.from(list.querySelectorAll<HTMLButtonElement>("[data-plans-toggle]"));
    const set = (open: boolean): void => {
      list.toggleAttribute("data-open", open);
      for (const b of buttons) {
        b.setAttribute("aria-expanded", String(open));
        const label = b.querySelector<HTMLElement>("[data-plans-label]");
        if (label) label.textContent = (open ? b.dataset.hide : b.dataset.show) ?? "";
      }
    };
    for (const b of buttons) b.addEventListener("click", () => set(!list.hasAttribute("data-open")));
    set(false);
  }

  document.addEventListener("astro:page-load", initPlans);
</script>
