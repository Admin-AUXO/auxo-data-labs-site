---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/layout/Section.astro";
import Receipt from "../components/ui/Receipt.astro";
import SectionHeader from "../components/ui/SectionHeader.astro";
import Button from "../components/ui/Button.astro";
import HighlightText from "../components/ui/HighlightText.astro";
import Accordion from "../components/ui/Accordion.astro";
import CtaSection from "../components/sections/shared/CtaSection.astro";
import StructuredData from "../components/layout/StructuredData.astro";
import { faqSchema } from "../lib/structured-data";
import { pricingContent as c } from "../data/pricing";
import { escapeHtml } from "../lib/text";
import "../styles/pages/pricing.css";

const faqItems = c.faq.items.map((item) => ({ title: item.question, body: escapeHtml(item.answer) }));
const factKeys = ["price"] as const;
---
<BaseLayout title={c.metaTitle} description={c.metaDescription}>
  <Section padding="lg" width="7xl">
    <div class="page-hero">
      <div class="page-hero__side" data-enter>
        <h1 class="page-hero__title page-hero__title--long" data-enter="headline">
          <HighlightText text={c.hero.title} soften />
        </h1>
        <p class="page-hero__lead">{c.hero.lead}</p>
        <div class="page-hero__ctas">
          <Button variant="primary" size="lg" href={c.hero.primaryCta.href} icon class="w-full sm:w-auto">
            {c.hero.primaryCta.text}
          </Button>
          <Button variant="secondary" size="lg" href={c.hero.secondaryCta.href} class="w-full sm:w-auto">
            {c.hero.secondaryCta.text}
          </Button>
        </div>
      </div>
      <Receipt data={c.hero.receipt} href="#ledger" />
    </div>
  </Section>

  <Section id="ledger" padding="lg" width="7xl" class="plans-anchor">
    <h2 class="ledger__title">{c.ledger.title}</h2>
    <ol class="costs">
      {
        c.ledger.rows.map((r, i) => (
          <li class="cost" data-tone={r.tone} data-anim="rise" style={`--i:${i}`}>
            <div class="cost__head">
              <span class="sq" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
              <h3 class="cost__step">{r.step}</h3>
            </div>
            <div class="cost__body">
              <p class="cost__get">{r.get}</p>
              {r.note && <p class="cost__note">{r.note}</p>}
            </div>
            <dl class="cost__rows">
              <div class="leader">
                <dt>{c.ledger.columns.takes}</dt>
                <span class="leader__dots" aria-hidden="true"></span>
                <dd>{r.takes}</dd>
              </div>
              <div class="leader">
                <dt>{c.ledger.columns.price}</dt>
                <span class="leader__dots" aria-hidden="true"></span>
                <dd data-tone={r.tone}>{r.price}</dd>
              </div>
            </dl>
          </li>
        ))
      }
    </ol>
    <div class="costs__foot">
      <p class="ledger__total">{c.ledger.total}</p>
      <p class="ledger__legend">
        <span data-tone="free">{c.ledger.legend.free}</span>
        <span data-tone="paid">{c.ledger.legend.paid}</span>
      </p>
    </div>
  </Section>

  <Section padding="lg" width="7xl" class="plans-section">
    <h2 class="plans__title">{c.cards.title}</h2>
    <ul class="plans">
      {
        c.cards.items.map((p, i) => (
          <li id={p.id} class:list={["plan", p.featured && "ground-lime"]} data-anim="rise" style={`--i:${i}`}>
            <article class="plan__body" aria-labelledby={`${p.id}-eyebrow`}>
              <div class="plan__who">
                <h3 id={`${p.id}-eyebrow`} class="plan__eyebrow">{p.eyebrow}</h3>
                <p class="plan__descriptor">{p.descriptor}</p>
              </div>
              <div class="plan__what">
                <p class="plan__label">{c.cards.startLabel}</p>
                <p class="plan__title">{p.title}</p>
                <p class="plan__subline">{p.subline}</p>
              </div>
              <dl class="plan__facts">
                {factKeys.map((k) => (
                  <div class="plan__fact">
                    <dt>{c.cards.factLabels[k]}</dt>
                    <dd>{p.facts[k]}</dd>
                  </div>
                ))}
              </dl>
            </article>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section padding="lg" width="7xl" background="sunken">
    <h2 class="includes__title">{c.includes.title}</h2>
    <ul class="includes" data-reveal>
      {
        c.includes.items.map((item) => (
          <li class="includes__item">
            <h3 class="includes__name">{item.title}</h3>
            <p class="includes__body">{item.body}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section id="faq" padding="lg" width="7xl" class="plans-anchor">
    <div class="faq-split">
      <SectionHeader title={c.faq.title} />
      <div class="faq-split__list" data-reveal>
        <Accordion items={faqItems} openFirst />
      </div>
    </div>
  </Section>

  <CtaSection
    title={c.cta.title}
    description={c.cta.description}
    ctaText={c.cta.ctaText}
    ctaHref={c.cta.ctaHref}
    reassurance={c.cta.reassurance}
  />

  <StructuredData type="FAQPage" data={faqSchema(c.faq.items)} />
</BaseLayout>

