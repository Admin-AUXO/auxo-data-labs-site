---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/layout/Section.astro";
import Button from "../components/ui/Button.astro";
import TicTacToe from "../components/ui/TicTacToe.astro";
import { notFoundContent as c } from "../data/not-found";
---
<BaseLayout title={c.meta.title} description={c.meta.description} noindex>
  <Section padding="xl" width="5xl" class="text-center">
    <div class="flex flex-col items-center gap-6">
      <span class="section-index">{c.index}</span>
      <h1 class="text-display text-display--5xl max-w-[16ch]">{c.title}</h1>
      <p class="lead mx-auto">{c.lead}</p>
      <div class="mt-4 mb-2 w-full max-w-lg mx-auto">
        <TicTacToe />
      </div>
      <div class="mt-2 flex flex-wrap justify-center gap-3">
        <Button variant="primary" size="lg" href={c.primaryCta.href} icon>{c.primaryCta.text}</Button>
        <Button variant="secondary" size="lg" href={c.secondaryCta.href}>{c.secondaryCta.text}</Button>
      </div>
    </div>
  </Section>

  <script>
    import { track } from "../scripts/analytics/track";
    document.addEventListener("astro:page-load", () => {
      if (document.title.startsWith("Page not found")) {
        track("page_not_found", {
          page_path: location.pathname + location.search,
          page_location: location.href,
          error_type: "404",
        });
      }
    });
  </script>
</BaseLayout>
