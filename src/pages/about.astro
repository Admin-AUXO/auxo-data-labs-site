---
import { Icon } from "astro-icon/components";
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/layout/Section.astro";
import SectionHeader from "../components/ui/SectionHeader.astro";
import Button from "../components/ui/Button.astro";
import HighlightText from "../components/ui/HighlightText.astro";
import CtaSection from "../components/sections/shared/CtaSection.astro";
import StructuredData from "../components/layout/StructuredData.astro";
import { personSchema } from "../lib/structured-data";
import { aboutContent as c } from "../data/about";
import "../styles/pages/about.css";
---
<BaseLayout title={c.meta.title} description={c.meta.description}>
  <Section padding="lg" width="7xl">
    <div class="flex max-w-3xl flex-col gap-6">
      <p class="section-index" data-enter>{c.hero.eyebrow}</p>
      <h1 class="text-display text-display--hero max-w-[14ch]" data-enter="headline">
        <HighlightText text={c.hero.title} highlight={c.hero.titleHighlight} soften />
      </h1>
      <p class="lead max-w-2xl text-xl" data-enter>{c.hero.lead}</p>
      <div class="flex flex-col gap-3" data-enter>
        <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center">
          <Button variant="primary" size="lg" href={c.hero.primaryCta.href} icon class="w-full sm:w-auto">
            {c.hero.primaryCta.text}
          </Button>
          <Button variant="secondary" size="lg" href={c.hero.secondaryCta.href} class="w-full sm:w-auto">
            {c.hero.secondaryCta.text}
          </Button>
        </div>
      </div>
    </div>
    <dl class="about-facts" data-enter>
      {
        c.hero.facts.map((f) => (
          <div class="about-facts__item">
            <dt>{f.label}</dt>
            <dd>{f.value}</dd>
          </div>
        ))
      }
    </dl>
  </Section>

  <Section padding="lg" width="7xl">
    <SectionHeader eyebrow={c.beliefs.eyebrow} title={c.beliefs.title} subtitle={c.beliefs.lead} />
    <ul class="about-grid mt-8">
      {
        c.beliefs.items.map((item, i) => (
          <li class="about-grid__item" data-anim="rise" style={`--i:${i}`}>
            <Icon name={item.icon} class="about-grid__icon" aria-hidden="true" />
            <h3 class="about-grid__title">{item.title}</h3>
            <p class="about-grid__desc">{item.desc}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section id="team" padding="lg" width="7xl" class="about-anchor">
    <SectionHeader eyebrow={c.team.eyebrow} title={c.team.title} subtitle={c.team.lead} />
    <div class="about-team mt-8">
      {
        c.team.founders.map((f) => (
          <article class="about-team__person" data-reveal>
            <h3 class="about-team__name">{f.name}</h3>
            <p class="about-team__role">{f.role}</p>
            {f.lines.map((l) => <p class="about-team__line">{l}</p>)}
            <a
              href={f.linkedin}
              class="about-team__link"
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${c.team.linkLabel}: ${f.name}`}
            >
              <Icon name="mdi:linkedin" aria-hidden="true" />
              {c.team.linkLabel}
            </a>
          </article>
        ))
      }
    </div>
  </Section>

  <Section padding="lg" width="7xl">
    <SectionHeader eyebrow={c.engagement.eyebrow} title={c.engagement.title} subtitle={c.engagement.lead} />
    <ul class="about-grid about-grid--three mt-8">
      {
        c.engagement.principles.map((principle, i) => (
          <li class="about-grid__item" data-anim="rise" style={`--i:${i}`}>
            <Icon name={principle.icon} class="about-grid__icon" aria-hidden="true" />
            <h3 class="about-grid__title">{principle.title}</h3>
            <p class="about-grid__desc">{principle.desc}</p>
          </li>
        ))
      }
    </ul>
    <p class="about-note">{c.engagement.reassurance}</p>
  </Section>

  <CtaSection
    title={c.cta.title}
    titleHighlight={c.cta.titleHighlight}
    description={c.cta.description}
    descriptionHighlight={c.cta.descriptionHighlight}
    ctaText={c.cta.ctaText}
    ctaHref={c.cta.ctaHref}
    reassurance={c.cta.reassurance}
  />

  {c.team.founders.map((f) => <StructuredData type="Person" data={personSchema(f)} />)}
</BaseLayout>
