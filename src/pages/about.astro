---
import { Icon } from "astro-icon/components";
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/layout/Section.astro";
import Button from "../components/ui/Button.astro";
import HighlightText from "../components/ui/HighlightText.astro";
import CtaSection from "../components/sections/shared/CtaSection.astro";
import StructuredData from "../components/layout/StructuredData.astro";
import { personSchema } from "../lib/structured-data";
import { aboutContent as c } from "../data/about";
import "../styles/pages/about.css";
---
<BaseLayout title={c.meta.title} description={c.meta.description}>
  <Section padding="lg" width="7xl">
    <div class="page-hero">
      <h1 class="page-hero__title" data-enter="headline">
        <HighlightText text={c.hero.title} soften />
      </h1>
      <div class="page-hero__side" data-enter>
        <p class="page-hero__lead">{c.hero.lead}</p>
        <div class="page-hero__ctas">
          <Button variant="primary" size="lg" href={c.hero.primaryCta.href} icon class="w-full sm:w-auto">
            {c.hero.primaryCta.text}
          </Button>
          <Button variant="secondary" size="lg" href={c.hero.secondaryCta.href} class="w-full sm:w-auto">
            {c.hero.secondaryCta.text}
          </Button>
        </div>
      </div>
    </div>
    <dl class="about-facts" data-enter>
      {
        c.hero.facts.map((f) => (
          <div class="about-facts__item">
            <dt>{f.label}</dt>
            <dd>{f.value}</dd>
          </div>
        ))
      }
    </dl>
  </Section>

  <Section id="team" padding="lg" width="7xl" background="accent" class="about-anchor">
    <div class="about-story" data-reveal>
      <h2 class="about-story__title">
        <HighlightText text={c.team.title} soften />
      </h2>
      <p class="about-story__lead">{c.team.story}</p>
    </div>
    <div class="about-team">
      {
        c.team.founders.map((f) => (
          <article class="about-team__person" data-reveal>
            <h3 class="about-team__name">{f.name.split(" ").map((part, i) => <span>{i > 0 && " "}{part}</span>)}</h3>
            <p class="about-team__role">{f.role}</p>
            <p class="about-team__drive">{f.drive}</p>
            {f.lines.map((l) => <p class="about-team__line">{l}</p>)}
            <a
              href={f.linkedin}
              class="about-team__link"
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${c.team.linkLabel}: ${f.name}`}
            >
              <Icon name="mdi:linkedin" aria-hidden="true" />
              {c.team.linkLabel}
            </a>
          </article>
        ))
      }
    </div>
  </Section>

  <Section padding="lg" width="7xl">
    <h2 class="about-heading">{c.commitments.title}</h2>
    <ol class="commit">
      {
        c.commitments.items.map((item, i) => (
          <li class="commit__item">
            <span class="sq" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
            <h3 class="commit__name">{item.title}</h3>
            <p class="commit__desc">{item.desc}</p>
          </li>
        ))
      }
    </ol>
    <p class="about-note">{c.commitments.note}</p>
  </Section>

  <CtaSection
    title={c.cta.title}
    titleHighlight={c.cta.titleHighlight}
    description={c.cta.description}
    descriptionHighlight={c.cta.descriptionHighlight}
    ctaText={c.cta.ctaText}
    ctaHref={c.cta.ctaHref}
    reassurance={c.cta.reassurance}
  />

  {c.team.founders.map((f) => <StructuredData type="Person" data={personSchema(f)} />)}
</BaseLayout>
