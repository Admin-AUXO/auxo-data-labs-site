---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/layout/Section.astro";
import SectionHeader from "../components/ui/SectionHeader.astro";
import Button from "../components/ui/Button.astro";
import HighlightText from "../components/ui/HighlightText.astro";
import CtaSection from "../components/sections/shared/CtaSection.astro";
import { aboutContent as c } from "../data/about";

const stepAnim = ["slide-right", "rise", "rise", "slide-left"] as const;

const purpose = [
  {
    label: "Our mission",
    statement: "Turn the data you already hold into decisions you can defend: clear, traceable, and fast enough to act on.",
    support:
      "We make the next move obvious and easy to prove, with the working shown at every step.",
  },
  {
    label: "Our vision",
    statement: "A region where every decision is backed by data worth trusting.",
    support:
      "Intelligence that is quiet, dependable, and always within reach: not a project, just how the work runs.",
  },
];
---

<BaseLayout
  title="Studio — Dubai analytics & AI for real estate"
  description="AUXO is a specialist analytics and AI studio for real estate, based in Dubai and working across the UAE and the wider Gulf. We turn the data you already hold into reporting, forecasts, and automation you can trust — built to last, and yours to keep."
>

  <Section padding="xl" width="7xl">    <div class="flex max-w-3xl flex-col gap-7">
      <h1 class="text-display text-display--5xl max-w-[14ch]" data-enter="headline">
        <HighlightText text={c.hero.title} highlight={c.hero.titleHighlight} />
      </h1>
      <p class="lead max-w-2xl text-xl" data-enter>{c.hero.lead}</p>
      <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center" data-enter>
        <Button variant="primary" size="lg" href={c.hero.primaryCta.href} icon class="w-full sm:w-auto">
          {c.hero.primaryCta.text}
        </Button>
        <Button variant="secondary" size="lg" href={c.hero.secondaryCta.href} class="w-full sm:w-auto">
          {c.hero.secondaryCta.text}
        </Button>
      </div>
    </div>
  </Section>


  <Section padding="lg" width="7xl">
    <SectionHeader
      title="Why AUXO exists"
      highlight="exists"
      subtitle="Two things hold steady behind everything we build — the work we do today, and the world we are working toward."
    />
    <div class="purpose mt-10 md:mt-12">
      {
        purpose.map((p) => (
          <article class="purpose__card" data-reveal>
            <div class="purpose__head">
              <span class="purpose__rule" aria-hidden="true" data-anim="draw" />
              <span class="eyebrow text-accent-2">{p.label}</span>
            </div>
            <p class="purpose__statement">{p.statement}</p>
            <p class="purpose__support text-muted">{p.support}</p>
          </article>
        ))
      }
    </div>
  </Section>


  <Section padding="lg" width="7xl">
    <div class="grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
      <div class="lg:self-start">
        <SectionHeader title={c.beliefs.title} highlight={c.beliefs.titleHighlight} />
        <p class="mt-5 max-w-xs text-muted">{c.beliefs.lead}</p>
      </div>
      <div class="flex flex-col border-t border-border" data-reveal>
        {
          c.beliefs.items.map((item) => (
            <article class="flex flex-col gap-3 border-b border-border py-6 sm:py-8 md:flex-row md:items-baseline md:gap-10">
              <span class="block h-px w-10 shrink-0 bg-accent md:mt-3.5" />
              <div class="max-w-2xl">
                <h3 class="text-2xl font-bold">{item.title}</h3>
                <p class="mt-2 text-lg text-muted">{item.desc}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </Section>


  <Section padding="lg" width="7xl">
    <SectionHeader
      title={c.how.title}
      highlight={c.how.titleHighlight}
      subtitle={c.how.subtitle}
    />
    <ol class="mt-10 grid gap-x-10 gap-y-8 sm:grid-cols-2 sm:gap-y-12 md:mt-12 md:grid-cols-4">
      {
        c.how.steps.map((step, i) => (
          <li class="relative flex flex-col gap-3 pt-6" data-anim={stepAnim[i]}>
            <span class="absolute inset-x-0 top-0 h-0.5 bg-foreground" />
            <span class="eyebrow text-accent-2">{step.label}</span>
            <h3 class="text-2xl font-bold">{step.title}</h3>
            <p class="text-muted">{step.desc}</p>
            {i < c.how.steps.length - 1 && (
              <span
                class="pointer-events-none absolute -right-7 top-7 hidden text-2xl leading-none text-subtle md:block"
                aria-hidden="true"
              >
                &rarr;
              </span>
            )}
          </li>
        ))
      }
    </ol>
  </Section>


  <Section padding="lg" width="7xl">
    <div class="flex flex-col gap-10">
      <div data-reveal>
        <span class="eyebrow text-accent">
          <HighlightText text={c.where.title} highlight={c.where.titleHighlight} />
        </span>
        <p class="mt-5 max-w-3xl text-lg font-medium sm:text-xl" data-anim="rise-in">
          {c.where.body}
        </p>
      </div>
      <dl class="grid gap-px border border-border bg-border sm:grid-cols-3" data-reveal>
        {
          c.where.points.map((point) => (
            <div class="flex flex-col gap-2 bg-surface p-6 sm:p-8">
              <dt class="mono-datum">{point.label}</dt>
              <dd class="text-xl font-bold">{point.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </Section>

  <Section padding="lg" width="7xl">
    <div class="flex max-w-3xl flex-col gap-4" data-reveal>
      <SectionHeader title={c.engagement.title} highlight={c.engagement.titleHighlight} />
      <p class="max-w-2xl text-lg text-muted">{c.engagement.lead}</p>
      <p class="flex items-start gap-3 text-sm text-subtle">
        <span class="mt-2 h-px w-6 shrink-0 bg-accent" aria-hidden="true"></span>
        {c.engagement.reassurance}
      </p>
    </div>
    <ol class="mt-12 grid gap-x-12 sm:mt-16 lg:grid-cols-2 lg:gap-x-20">
      {
        c.engagement.principles.map((principle, i) => (
          <li
            class="flex gap-5 border-t border-border py-7"
            data-anim={i % 2 === 0 ? "slide-right" : "slide-left"}
          >
            <span class="mono-datum pt-1">{String(i + 1).padStart(2, "0")}</span>
            <div class="flex flex-col gap-2">
              <h3 class="text-xl font-bold text-balance">{principle.title}</h3>
              <p class="text-muted">{principle.desc}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </Section>

  <CtaSection
    title={c.cta.title}
    titleHighlight={c.cta.titleHighlight}
    description={c.cta.description}
    descriptionHighlight={c.cta.descriptionHighlight}
    ctaText={c.cta.ctaText}
    ctaHref={c.cta.ctaHref}
    secondaryText={c.cta.secondaryText}
    secondaryHref={c.cta.secondaryHref}
    reassurance={c.cta.reassurance}
  />
</BaseLayout>

<style>
  .purpose {
    background: var(--border);
    border: 1px solid var(--border);
    display: grid;
    gap: 1px;
    grid-template-columns: 1fr;
  }

  .purpose__card {
    background: var(--background);
    display: grid;
    gap: 1.1rem;
    padding: clamp(1.5rem, 1rem + 2vw, 2.25rem);
  }

  .purpose__head {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .purpose__rule {
    background: var(--accent-2);
    block-size: 0.125rem;
    inline-size: 2.5rem;
  }

  .purpose__statement {
    font-family: var(--font-brand);
    font-size: var(--text-xl);
    font-weight: 700;
    letter-spacing: var(--tracking-display-xl);
    line-height: 1.2;
    text-wrap: balance;
  }

  .purpose__support {
    font-size: var(--text-base);
  }

  @media (width >= 48rem) {
    .purpose {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: auto auto auto;
    }

    .purpose__card {
      grid-row: span 3;
      grid-template-rows: subgrid;
    }
  }
</style>
