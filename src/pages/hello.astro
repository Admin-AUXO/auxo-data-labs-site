---
import { Icon } from "astro-icon/components";
import BaseLayout from "../layouts/BaseLayout.astro";
import Mark from "../components/layout/Mark.astro";
import CalendarDialog from "../components/layout/CalendarDialog.astro";
import { cardPage as c } from "../data/card-links";
import wallet from "../data/wallet.json";
import "../styles/pages/hello.css";

const ids = c.founders.map((f) => f.id);
const passes = wallet as Record<string, { google: string | null; apple: string | null }>;
---

<BaseLayout
  title="Meet the founders"
  description="Connect with Vignesh Ramesh and Ajay Kumar, co-founders of AUXO Data Labs."
  path="/hello/"
  noindex
  bare
>
  <section class="card" data-card data-pagefind-ignore="all">
    <div class="card__view card__choose" data-view="choose">
      <header class="card__brand">
        <Mark class="card__mark" />
        <p class="card__eyebrow">{c.company.name}</p>
        <h1 class="card__greeting">{c.greeting}</h1>
        <p class="card__lines">
          {c.company.lines.map((l) => <span>{l}</span>)}
        </p>
      </header>

      <div class="card__ask">
        <h2 class="card__label" id="ask-title">{c.chooser.title}</h2>
        <div class="card__people" role="group" aria-labelledby="ask-title">
          {
            c.founders.map((f) => (
              <button type="button" class="card__pick" data-founder={f.id} aria-controls={`panel-${f.id}`}>
                <span class="card__pick-text">
                  <span class="card__pick-name">{f.name.split(" ").map((part, i) => <span>{i > 0 && " "}{part}</span>)}</span>
                  <span class="card__pick-role">{f.role}</span>
                  <span class="card__pick-note">{f.note}</span>
                </span>
                <Icon name="mdi:arrow-right" class="card__pick-arrow" aria-hidden="true" />
              </button>
            ))
          }
        </div>
      </div>

      <footer class="card__foot">
        <span class="card__live" data-local-time><i aria-hidden="true"></i><span data-local-text>{c.local.city}</span></span>
        <a href={c.site.href} data-card-link="website">{c.site.label}</a>
      </footer>
    </div>

    {
      c.founders.map((f) => (
        <div class="card__view card__person" id={`panel-${f.id}`} data-panel={f.id} role="region" aria-label={f.name}>
          <div class="card__bar">
            <button type="button" class="card__change" data-change>
              <Icon name="mdi:arrow-left" aria-hidden="true" />
              {c.change}
            </button>
            <a href={c.site.href} class="card__bar-brand" aria-label={c.company.name}>
              <Mark class="card__mark card__mark--sm" />
            </a>
          </div>

          <header class="card__hero">
            <p class="card__eyebrow">{c.company.name}</p>
            <h2 class="card__name">
              {f.name.split(" ").map((part) => <span>{part}</span>)}
            </h2>
            <p class="card__role">{f.role}</p>
            <p class="card__note">{f.note}</p>
          </header>

          <div class="card__side">
            <div class="card__actions">
              <a class="card__save" href={f.vcard} download="" data-card-link={`${f.id}_save`}>
                <Icon name="mdi:account-plus-outline" aria-hidden="true" />
                {c.saveLabel}
              </a>
              {(passes[f.id]?.apple || passes[f.id]?.google) && (
                <div class="card__wallet">
                  {passes[f.id]?.apple && (
                    <a class="card__wallet-btn" data-wallet="apple" href={passes[f.id].apple} data-card-link={`${f.id}_apple_wallet`}>
                      <Icon name="mdi:apple" aria-hidden="true" />
                      {c.wallet.apple}
                    </a>
                  )}
                  {passes[f.id]?.google && (
                    <a
                      class="card__wallet-btn"
                      data-wallet="google"
                      href={passes[f.id].google}
                      target="_blank"
                      rel="noopener noreferrer"
                      data-card-link={`${f.id}_google_wallet`}
                    >
                      <Icon name="mdi:wallet-outline" aria-hidden="true" />
                      {c.wallet.google}
                    </a>
                  )}
                </div>
              )}
              <ul class="card__contacts" style={`--n:${f.contacts.length}`}>
                {f.contacts.map((l) => (
                  <li>
                    <a
                      class="card__contact"
                      href={l.href}
                      target={l.external ? "_blank" : undefined}
                      rel={l.external ? "noopener noreferrer" : undefined}
                      data-card-link={l.id}
                      aria-label={`${l.label}: ${l.hint}`}
                    >
                      <Icon name={l.icon} aria-hidden="true" />
                      <span>{l.label}</span>
                    </a>
                  </li>
                ))}
              </ul>
              <button type="button" class="card__meet" data-google-calendar-open data-card-link={`${f.id}_meeting`}>
                <Icon name="mdi:calendar-clock-outline" aria-hidden="true" />
                {c.meetLabel(f.first)}
              </button>
            </div>

            <a class="card__score" href={c.score.href} data-card-link={c.score.id}>
              <svg class="card__ring" viewBox="0 0 48 48" aria-hidden="true">
                <circle class="card__ring-track" cx="24" cy="24" r="20" />
                <circle class="card__ring-arc" cx="24" cy="24" r="20" pathLength="100" />
                <text x="24" y="24">?</text>
              </svg>
              <span class="card__score-text">
                <span class="card__score-eyebrow">{c.score.eyebrow}</span>
                <span class="card__score-label">{c.score.label}</span>
                <span class="card__score-hint">{c.score.hint}</span>
              </span>
              <Icon name="mdi:arrow-right" class="card__score-arrow" aria-hidden="true" />
            </a>
          </div>

          <footer class="card__foot">
            <span class="card__live" data-local-time><i aria-hidden="true"></i><span data-local-text>{c.local.city}</span></span>
          </footer>
        </div>
      ))
    }
  </section>

  <script is:inline define:vars={{ ids }}>
    (() => {
      let pick = location.hash.slice(1);
      if (!ids.includes(pick)) {
        try {
          pick = localStorage.getItem("auxo-card-founder") || "";
        } catch {}
      }
      const ua = navigator.userAgent;
      document.documentElement.dataset.platform = /iPhone|iPad|iPod/.test(ua) ? "ios" : /Android/.test(ua) ? "android" : "other";
      const view = ids.includes(pick) ? document.getElementById("panel-" + pick) : document.querySelector(".card__choose");
      view?.setAttribute("data-active", "");
    })();
  </script>

  <script>
    import { track } from "../scripts/analytics/track";
    import { cardPage } from "../data/card-links";

    const KEY = "auxo-card-founder";
    const ids = cardPage.founders.map((f) => f.id);
    let timer = 0;

    function remember(id: string | null) {
      try {
        if (id) localStorage.setItem(KEY, id);
        else localStorage.removeItem(KEY);
      } catch {}
    }

    function open(id: string | null) {
      const valid = !!id && ids.includes(id);
      const target = valid ? document.getElementById(`panel-${id}`) : document.querySelector(".card__choose");
      document.querySelectorAll("[data-card] .card__view").forEach((v) => v.toggleAttribute("data-active", v === target));
      if (valid) {
        history.replaceState(null, "", `#${id}`);
        document.querySelector<HTMLElement>(`#panel-${id} .card__save`)?.focus({ preventScroll: true });
      } else {
        history.replaceState(null, "", location.pathname);
        document.querySelector<HTMLElement>(".card__pick")?.focus({ preventScroll: true });
      }
      remember(valid ? id : null);
      window.scrollTo({ top: 0 });
    }

    function initTime() {
      const outs = Array.from(document.querySelectorAll<HTMLElement>("[data-local-text]"));
      if (!outs.length) return;
      const { timeZone, city, days, opens, closes, open, closed } = cardPage.local;
      const fmt = new Intl.DateTimeFormat("en-GB", { hour: "2-digit", minute: "2-digit", hourCycle: "h23", timeZone });
      const dayFmt = new Intl.DateTimeFormat("en-US", { weekday: "short", timeZone });
      const DAYS = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
      const tick = () => {
        if (!outs[0].isConnected) {
          clearInterval(timer);
          return;
        }
        const now = new Date();
        const time = fmt.format(now);
        const hour = Number(time.slice(0, 2));
        const working = days.includes(DAYS.indexOf(dayFmt.format(now))) && hour >= opens && hour < closes;
        const text = `${working ? open : closed} · ${time} in ${city}`;
        for (const o of outs) {
          o.textContent = text;
          o.closest("[data-local-time]")?.toggleAttribute("data-open", working);
        }
      };
      clearInterval(timer);
      tick();
      timer = window.setInterval(tick, 30_000);
    }

    initTime();
    document.addEventListener("astro:page-load", initTime);
    window.addEventListener("hashchange", () => {
      const id = location.hash.slice(1);
      if (ids.includes(id)) open(id);
    });
    document.addEventListener("click", (e) => {
      const t = e.target as Element | null;
      const pick = t?.closest<HTMLElement>("[data-founder]");
      if (pick) {
        open(pick.dataset.founder ?? null);
        track("card_founder_select", { founder: pick.dataset.founder ?? "" });
        return;
      }
      if (t?.closest("[data-change]")) {
        open(null);
        return;
      }
      const link = t?.closest<HTMLElement>("[data-card-link]");
      if (link) track("card_link_click", { link: link.dataset.cardLink });
    });
  </script>
  <CalendarDialog />
</BaseLayout>
