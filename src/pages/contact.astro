---
import { Icon } from "astro-icon/components";
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/layout/Section.astro";
import SectionHeader from "../components/ui/SectionHeader.astro";
import Button from "../components/ui/Button.astro";
import Accordion from "../components/ui/Accordion.astro";
import HighlightText from "../components/ui/HighlightText.astro";
import ContactForm from "../components/forms/ContactForm.astro";
import StructuredData from "../components/layout/StructuredData.astro";
import { faqSchema } from "../lib/structured-data";
import { contactContent as c } from "../data/contact";

const faqItems = c.faq.items.map((item) => ({ title: item.question, body: item.answer }));
---

<BaseLayout
  title="Contact — talk to a Gulf real estate data team"
  description="Tell us what's slowing your decisions down. A real person reads your note and replies within one business day. Dubai-based, working across the UAE and the wider Gulf."
>
  <Section padding="xl" width="7xl">    <div class="flex flex-col gap-8">
      <h1 class="text-display max-w-[12ch]" data-enter="headline">
        <HighlightText text={c.hero.title} highlight={c.hero.titleHighlight} />
      </h1>
      <p class="lead max-w-xl text-xl" data-enter>{c.hero.lead}</p>
    </div>
  </Section>

  <Section padding="lg" width="7xl">
    <div class="grid gap-12 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
      <div class="flex flex-col gap-8" data-reveal>
        <div class="flex flex-col gap-4">
          <span class="block h-0.5 w-14 bg-accent-2" data-anim="draw" aria-hidden="true"></span>
          <h2 class="text-2xl font-bold">{c.details.title}</h2>
        </div>

        <ul class="flex flex-col">
          {
            c.details.items.map((item, i) => (
              <li
                class:list={[
                  "flex items-start gap-4 py-4",
                  i > 0 && "border-t border-border",
                ]}
              >
                <Icon name={item.icon} class="mt-0.5 size-5 shrink-0 text-accent" aria-hidden="true" />
                <div class="flex flex-col gap-0.5">
                  <span class="text-sm text-subtle">{item.label}</span>
                  {item.href ? (
                    <a
                      href={item.href}
                      class="font-medium text-foreground transition-colors hover:text-accent"
                      target={item.external ? "_blank" : undefined}
                      rel={item.external ? "noopener noreferrer" : undefined}
                    >
                      {item.value}
                    </a>
                  ) : (
                    <span class="font-medium text-foreground">{item.value}</span>
                  )}
                </div>
              </li>
            ))
          }
        </ul>

        <p class="text-sm text-muted">{c.details.responseTime}</p>

        <div>
          <Button calendar variant="secondary" icon iconName="mdi:calendar-clock-outline">
            {c.details.cta.text}
          </Button>
        </div>
      </div>

      <div class="flex flex-col gap-6">
        <div class="flex flex-col gap-2">
          <h2 class="text-2xl font-bold">{c.form.title}</h2>
          <p class="text-muted">{c.form.description}</p>
        </div>
        <ContactForm />
      </div>
    </div>
  </Section>

  <Section padding="lg" width="7xl">
    <SectionHeader
      title={c.nextSteps.title}
      highlight={c.nextSteps.titleHighlight}
      subtitle={c.nextSteps.subtitle}
    />
    <ol class="mt-14 grid gap-x-10 gap-y-10 sm:grid-cols-3">
      {
        c.nextSteps.steps.map((step, i) => (
          <li
            class="flex flex-col gap-3 border-t-2 border-foreground pt-5"
            data-anim={i === 0 ? "rise" : i === 1 ? "slide-right" : "slide-left"}
          >
            <span class="font-mono text-sm font-semibold tabular-nums text-accent-2">0{i + 1}</span>
            <h3 class="text-2xl font-bold">{step.title}</h3>
            <p class="text-muted">{step.desc}</p>
          </li>
        ))
      }
    </ol>
  </Section>

  <Section padding="lg" width="5xl">
    <SectionHeader title={c.faq.title} highlight={c.faq.titleHighlight} subtitle={c.faq.description} />
    <div class="mt-10" data-reveal>
      <Accordion items={faqItems} openFirst />
    </div>
  </Section>

  <StructuredData type="FAQPage" data={faqSchema(c.faq.items)} />
</BaseLayout>
