---
import { Icon } from "astro-icon/components";
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/layout/Section.astro";
import SectionHeader from "../components/ui/SectionHeader.astro";
import Button from "../components/ui/Button.astro";
import Accordion from "../components/ui/Accordion.astro";
import HighlightText from "../components/ui/HighlightText.astro";
import ContactForm from "../components/forms/ContactForm.astro";
import { contactContent as c } from "../data/contact";

const faqItems = c.faq.items.map((item) => ({ title: item.question, body: item.answer }));
---

<BaseLayout
  title="Contact"
  description="Reach AUXO about messy reporting, slow decisions, or a stuck analytics initiative. Use the form or book a call — a short, honest summary is enough to start."
>
  <Section padding="xl" decoration="glow" width="7xl">
    <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)] lg:gap-16">
      <!-- Left: heading, intro, contact details, booking CTA -->
      <div class="flex flex-col gap-8">
        <div class="flex flex-col gap-5">
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-accent">{c.hero.eyebrow}</p>
          <h1 class="text-4xl font-bold leading-[1.05] tracking-tight sm:text-5xl">
            <HighlightText text={c.hero.title} highlight={c.hero.titleHighlight} />
          </h1>
          <p class="max-w-xl text-lg text-muted">{c.hero.description}</p>
          <ul class="flex flex-wrap gap-2.5">
            {
              c.hero.pills.map((pill) => (
                <li class="rounded-full border border-border bg-surface px-4 py-2 text-sm text-muted">
                  {pill}
                </li>
              ))
            }
          </ul>
        </div>

        <div class="rounded-2xl border border-border bg-surface p-6 sm:p-8">
          <h2 class="text-xl font-bold tracking-tight">{c.details.title}</h2>
          <ul class="mt-5 flex flex-col gap-4">
            {
              c.details.items.map((item) => (
                <li class="flex items-start gap-4">
                  <span class="icon-badge">
                    <Icon name={item.icon} aria-hidden="true" />
                  </span>
                  <div class="flex flex-col">
                    <span class="text-sm text-subtle">{item.label}</span>
                    {item.href ? (
                      <a
                        href={item.href}
                        class="font-semibold text-foreground transition-colors hover:text-accent"
                        target={item.external ? "_blank" : undefined}
                        rel={item.external ? "noopener noreferrer" : undefined}
                      >
                        {item.value}
                      </a>
                    ) : (
                      <span class="font-semibold text-foreground">{item.value}</span>
                    )}
                  </div>
                </li>
              ))
            }
          </ul>
          <div class="mt-7 border-t border-border pt-6">
            <Button calendar variant="outline" icon iconName="mdi:calendar-clock-outline">
              {c.details.cta.text}
            </Button>
          </div>
        </div>
      </div>

      <!-- Right: the form -->
      <div class="rounded-2xl border border-border bg-surface p-6 sm:p-8">
        <h2 class="text-2xl font-bold tracking-tight">{c.form.title}</h2>
        <p class="mt-3 text-muted">{c.form.description}</p>
        <div class="mt-7">
          <ContactForm />
        </div>
      </div>
    </div>
  </Section>

  <Section padding="lg" background="surface" width="5xl">
    <SectionHeader title={c.faq.title} subtitle={c.faq.description} />
    <div class="mt-12">
      <Accordion items={faqItems} openFirst />
    </div>
  </Section>
</BaseLayout>
