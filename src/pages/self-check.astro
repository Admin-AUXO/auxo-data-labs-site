---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/layout/Section.astro";

const SCALE = [
  { v: 1, k: "1", label: "Not really" },
  { v: 2, k: "2", label: "Rarely" },
  { v: 3, k: "3", label: "Sometimes" },
  { v: 4, k: "4", label: "Mostly" },
  { v: 5, k: "5", label: "Yes, reliably" },
];

interface Item { t: string; low: string; gloss?: string; }
interface Pillar { id: string; n: string; label: string; ease: string; scenario: string; note?: string; items: Item[]; }

const pillars: Pillar[] = [
  {
    id: "data",
    n: "01",
    label: "Trusted data",
    ease: "Start here — it's the foundation everything else sits on. There are no wrong answers; just what's true on a normal week.",
    scenario: "A number in the board pack gets questioned in the room. What happens next?",
    items: [
      { t: "Finance, registration, and CRM agree on the same figures — without manual reconciliation.", low: "Your systems disagree by default, so every figure starts the day needing a referee." },
      { t: "There's one agreed source of truth for units, sales, and collections — not three spreadsheets that drift.", low: "Three versions of the truth means the real one is whichever file happens to be open." },
      { t: "When a number is challenged, we trace it to its source in minutes, not days.", low: "When a number is challenged, you can't show your working fast enough to defend it." },
      { t: "New transactions land in our records without being re-keyed into several systems.", low: "The same data is typed in more than once — so it's wrong in at least one place." },
      { t: "We trust month-end figures on the first pass; errors rarely surface after sign-off.", low: "Month-end is a re-do, not a sign-off — every close quietly costs you a second pass." },
      { t: "Property, tenant, and owner master data is clean — few duplicates, blanks, or stale records.", low: "Duplicates and stale records mean the reports are built on sand you can't see." },
      { t: "We could hand raw data to an auditor or buyer tomorrow without cleaning it up first.", low: "A data request today would mean a clean-up scramble before you could answer it." },
    ],
  },
  {
    id: "reporting",
    n: "02",
    label: "Clear reporting",
    ease: "Now the part leadership actually sees. Picture your last close — the real one, not your best one.",
    scenario: "Leadership asks, plainly, “how are we actually doing?” How fast — and how sure — is your answer?",
    items: [
      { t: "The board pack is built the same way every period, not rebuilt from scratch.", low: "Every report is hand-rebuilt, so the work never compounds and small errors creep back in." },
      { t: "Leadership gets the numbers when they need them — not weeks after close.", low: "By the time the numbers land, the decision they were meant for has already been made." },
      { t: "Our reports answer “so what should we do?”, not just “here's what happened.”", low: "Your reports say what happened, not what to do — so leadership still has to guess." },
      { t: "We can break performance down by project, unit, channel, or community without a one-off pull.", low: "Any new angle on the numbers means a custom pull and a wait." },
      { t: "Two people pulling the same report get the same answer.", low: "The same question gives two answers depending on who runs it — so neither gets trusted." },
      { t: "Reporting doesn't hinge on one person who knows where everything lives.", low: "Reporting lives in one person's head — and walks out the door with them." },
      { t: "We compare against budget, forecast, and prior periods without stitching files by hand.", low: "Comparing to plan means stitching files by hand, so it rarely gets done." },
    ],
  },
  {
    id: "automation",
    n: "03",
    label: "Reliable automation",
    ease: "This one's about how much runs on people remembering. Be honest — most teams find their gaps here.",
    scenario: "Your key analyst is on leave for two weeks, over month-end. Does anything break?",
    items: [
      { t: "Recurring reports and consolidations run on a schedule, not because someone remembered.", low: "Reports run only when someone remembers — so eventually one won't." },
      { t: "Data moves between CRM, finance, registration, and bank without manual export-and-import.", low: "Data moves by copy-paste: slow on a good day, wrong on a bad one." },
      { t: "When a data process breaks, we're alerted — we don't find out from a wrong number.", low: "When something breaks, you find out from a wrong number, not an alert." },
      { t: "Routine reconciliations (collections, escrow, bank) are at least partly automated.", low: "Reconciliations are done by hand, so they're only as reliable as the busiest day allows." },
      { t: "A key person taking leave doesn't stall reporting or month-end.", low: "One person's leave can stall the close — your month-end has a single point of failure." },
      { t: "Our processes are documented well enough that a new hire could run them.", low: "The process isn't written down, so it can't be handed over or checked." },
      { t: "Analysts spend their time on analysis, not copying and pasting.", low: "Your analysts are paid to think but spend the month moving data by hand." },
    ],
  },
  {
    id: "compliance",
    n: "04",
    label: "Confident compliance",
    ease: "Last stretch — nearly there. This is about being ready to show your work, not legal advice, and nobody's marking it.",
    scenario: "A regulator, auditor, or investor asks for records tomorrow. Ready — or a fire drill?",
    note: "Operational readiness only — your ability to produce evidence on demand. Not legal advice; confirm your obligations with your own advisors.",
    items: [
      { t: "We can produce a clean audit trail for any transaction on request.", low: "You can't produce a clean trail on demand — so a simple request becomes a project." },
      { t: "AML-relevant checks and records (where they apply to us) are captured systematically.", low: "AML-relevant records are ad hoc, so the evidence is only as good as someone's memory.", gloss: "AML means anti-money-laundering — the checks that confirm who you're really dealing with and flag suspicious funds." },
      { t: "We could pull the data behind a goAML / REAR submission without a manual scramble.", low: "A goAML / REAR submission would mean a manual scramble against a deadline.", gloss: "goAML is the UAE regulator's online filing portal; a REAR is the real-estate activity report some firms submit through it. Both need records you can pull on demand." },
      { t: "Our reporting supports IFRS requirements without heavy period-end rework.", low: "IFRS reporting means heavy period-end rework, every single time.", gloss: "IFRS is the set of international accounting standards most companies' financial statements are expected to follow." },
      { t: "We're confident our corporate-tax figures rest on reconciled, traceable data.", low: "Your tax figures rest on numbers you haven't fully reconciled — a quiet, carried risk." },
      { t: "If asked for records tomorrow, we'd be ready in hours, not weeks.", low: "A records request would take weeks, not hours — exactly when speed matters most." },
      { t: "We know who owns each compliance-related report and how it's produced.", low: "No clear owner for compliance reports means they're everyone's job, and no one's." },
    ],
  },
];

const context = {
  role: ["Finance", "Operations", "Compliance / risk", "Founder / CEO / GM", "Something else"],
  business: ["Developer", "Brokerage", "Property / asset manager", "Owners' association", "Family office", "Something else"],
  scale: ["One asset or project", "A handful", "Dozens", "Hundreds+"],
};

const bands = [
  { id: "risk", min: 0, max: 24, name: "Foundations at risk",
    read: "The systems disagree, reporting is manual and late, and a request from a regulator or auditor would mean a scramble. The risk isn't abstract — it's a wrong number in the room or a missed filing, waiting to happen.",
    cta: "Don't try to fix it all at once. Find the one or two breaks costing you the most — your lowest pillar below is where to look — and start there." },
  { id: "patchy", min: 25, max: 49, name: "Patchy",
    read: "Some of it works — but it leans on specific people and a lot of manual effort. You get there, it just costs you time every period, and the cracks show under pressure.",
    cta: "It works, but it's carried by effort. Map where that effort and risk pile up, then take the highest-return fix first — one pillar at a time, not all of them." },
  { id: "manual", min: 50, max: 74, name: "Solid but manual",
    read: "The numbers are reliable — but you're paying for that reliability in hours and key-person dependency. You've outgrown the manual approach.",
    cta: "You've outgrown doing this by hand. The next gain is moving the routine, breakable work off people and onto something that runs on a schedule — start with your weakest pillar." },
  { id: "strong", min: 75, max: 100, name: "Strong",
    read: "Data agrees, reporting is fast and trusted, and you're ready for scrutiny. Genuinely well run.",
    cta: "Little here needs rescuing. The open question is what more you could pull from data you already trust — sharper forecasting, pricing, portfolio reads. A different question from fixing foundations." },
];

const roleTone: Record<string, string> = {
  Finance: " You'll feel this most at close and in the numbers you sign off.",
  Operations: " You'll feel this most in the handoffs between systems and people.",
  "Compliance / risk": " You'll feel this most the next time someone asks you to prove something.",
  "Founder / CEO / GM": " You'll feel this most in how much of this still runs through you.",
};

const pillarMoves: Record<string, string> = {
  data: "Agree one source of truth first. Until the numbers agree, everything downstream inherits the doubt.",
  reporting: "Make the board pack repeatable and traceable before adding another dashboard.",
  automation: "Take the routine, breakable work off people — put it on a schedule and watch it.",
  compliance: "Build the evidence trail into the workflow, so readiness is a by-product, not a scramble.",
};

const pillarCost: Record<string, string> = {
  data: "Left as-is, every {noun} you publish carries a number you can't fully stand behind — and you find out which one in the room.",
  reporting: "Left as-is, leadership keeps making calls on numbers that land too late or read two ways — the report arrives after the decision.",
  automation: "Left as-is, the close runs on specific people staying well and staying put — one leave, one resignation, and the month stalls.",
  compliance: "Left as-is, the next records request turns into a multi-day scramble, exactly when you can least afford one.",
};

const pillarReads: Record<string, Record<string, string>> = {
  data: {
    risk: "The numbers underneath everything aren't trustworthy yet — until that's fixed, every report built on them inherits the doubt.",
    patchy: "Right often enough to use, but not often enough to trust without checking — so someone is always quietly checking.",
    manual: "Largely sound; what's left is reconciliation that still falls on people rather than systems.",
    strong: "Holds up — agreement across systems, traceable to source. This is the asset the rest should be built on.",
  },
  reporting: {
    risk: "Effectively manual and ad hoc — every number is a fresh excavation, and that's a tax on every decision.",
    patchy: "Reports come together, but slowly and inconsistently — the answer can depend on who pulled it and when.",
    manual: "Works and arrives on time; the gap is from ‘what happened’ to ‘what to do’, and from one view to many.",
    strong: "A genuine strength — consistent, timely, and pointed at decisions rather than just records.",
  },
  automation: {
    risk: "Almost nothing runs without a hand on it — your close moves at the speed of one person's availability.",
    patchy: "Some of it's automated, but the chain breaks silently and recovery is manual — you find out when something's already late.",
    manual: "The routine mostly runs itself; the remaining manual steps are the ones that hurt most when a key person is out.",
    strong: "Largely runs itself, survives someone being on leave, and frees your people to analyse rather than copy-paste.",
  },
  compliance: {
    risk: "Reactive — a records or audit request would mean a scramble, and that exposure compounds quietly.",
    patchy: "You can meet requirements, but each one is a project rather than a routine, and the period-end rework is heavy.",
    manual: "Controls mostly in place; what's missing is the systematic capture that turns a fire-drill into a five-minute export.",
    strong: "Confident shape — clean trails, clear owners, requests answerable in hours. Hard-won and worth protecting.",
  },
};

const severityPrefix: Record<string, string> = {
  "One asset or project": "Even at one asset, ",
  "A handful": "Across a handful of assets, ",
  Dozens: "At dozens of assets this compounds — ",
  "Hundreds+": "At your scale this compounds hard — ",
};

const exampleNoun: Record<string, string> = {
  Developer: "board pack",
  Brokerage: "management report",
  "Property / asset manager": "owner report",
  "Owners' association": "committee report",
  "Family office": "investor update",
};

const blurbs: Record<string, string> = {
  data: "do your systems agree?",
  reporting: "can leadership act on it?",
  automation: "does it run without heroics?",
  compliance: "ready when someone asks?",
};

const trackShort: Record<string, string> = {
  data: "Data",
  reporting: "Reporting",
  automation: "Automation",
  compliance: "Compliance",
};

const pillarMeta = pillars.map((p) => ({ id: p.id, n: p.n, label: p.label, count: p.items.length }));
const total = pillars.reduce((s, p) => s + p.items.length, 0);
const cfg = { bands, pillarMeta, moves: pillarMoves, cost: pillarCost, reads: pillarReads, roleTone, severity: severityPrefix, exampleNoun };
const desc = "A 3-minute self-read on your data, reporting, automation, and compliance — with an honest, specific result. No grade, no pitch, nobody sees your answers.";
---

<BaseLayout title="The AUXO Score — a quick self-read" description={desc} path="/self-check/">
  <Section padding="lg" width="6xl">
    <div class="ac" data-assessment data-total={total}>
      <script type="application/json" id="ac-config" set:html={JSON.stringify(cfg)} />

      <div class="ac__sticky" data-bar hidden>
        <div class="ac__steps" aria-hidden="true">
          <span class="ac__seg"><i></i><em>Setup</em></span>
          {pillars.map((p) => (<span class="ac__seg"><i></i><em>{trackShort[p.id]}</em></span>))}
        </div>
        <div class="ac__bar">
          <button type="button" class="ac__navbtn" data-back aria-label="Back to previous section">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 18l-6-6 6-6"/></svg>
          </button>
          <span class="ac__steplabel" data-steplabel aria-live="polite"></span>
          <button type="button" class="ac__navbtn ac__navbtn--next" data-next disabled>
            <span data-next-label>Next</span>
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </button>
        </div>
        <div class="ac__legend" data-legend hidden aria-hidden="true">
          <span class="ac__legend-q">On a normal week, how true is each?</span>
          <ol class="ac__legend-scale">
            {SCALE.map((s) => (<li><b>{s.k}</b> {s.label}</li>))}
          </ol>
        </div>
      </div>

      <div class="ac__step is-active" data-step="intro">
        <span class="ac__kicker">The AUXO Score</span>
        <h1 class="ac__title">How much can your data actually tell you?</h1>
        <p class="ac__lead">
          Answer honestly and you'll walk away with a clear <b>0–100 score</b>, a read on each
          of the four things that decide whether your data works for you — and the one fix
          that would move the needle most.
        </p>
        <ul class="ac__pillars">
          {pillars.map((p) => (
            <li><span class="ac__pn">{p.n}</span> <b>{p.label}</b> <span class="ac__blurb">{blurbs[p.id]}</span></li>
          ))}
        </ul>
        <ul class="ac__meta" aria-label="What to expect">
          <li>4 short sections</li><li>~3 minutes</li><li>No sign-up</li><li>Stays in your browser</li>
        </ul>
        <div class="ac__actions">
          <button type="button" class="ac__btn" data-variant="primary" data-start>
            Get my score
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </button>
          <button type="button" class="ac__link" data-resume hidden>Pick up where I left off</button>
        </div>
        <p class="ac__fine">
          There are no right answers here — an honest read is the only thing that makes the score
          useful to you. Nobody sees it but you. Tap, or press <kbd>1</kbd>–<kbd>5</kbd>.
        </p>
      </div>

      <div class="ac__step" data-step="context" data-name="A little context" hidden>
        <h2 class="ac__qtitle">First — who's answering?</h2>
        <p class="ac__qsub">Optional, and it never changes your score. It just sharpens the read at the end. Skip it if you'd rather get straight in.</p>
        <div class="ac__ctx">
          <fieldset class="ac__field"><legend>Your role</legend>
            <div class="ac__chips" data-chips="role" data-single>
              {context.role.map((o) => (<button type="button" class="ac__chip" data-val={o}>{o}</button>))}
            </div>
          </fieldset>
          <fieldset class="ac__field"><legend>Your business</legend>
            <div class="ac__chips" data-chips="business" data-single>
              {context.business.map((o) => (<button type="button" class="ac__chip" data-val={o}>{o}</button>))}
            </div>
          </fieldset>
          <fieldset class="ac__field"><legend>Portfolio scale</legend>
            <div class="ac__chips" data-chips="scale" data-single>
              {context.scale.map((o) => (<button type="button" class="ac__chip" data-val={o}>{o}</button>))}
            </div>
          </fieldset>
        </div>
      </div>

      {pillars.map((p) => (
        <div class="ac__step" data-step="pillar" data-pillar={p.id} data-name={p.label} hidden>
          <p class="ac__scenario">{p.scenario}</p>
          <p class="ac__ease">{p.ease}</p>
          {p.note && <p class="ac__legal">{p.note}</p>}
          <ol class="ac__items">
            {p.items.map((it, ii) => (
              <li class="ac__item" data-item>
                <span class="ac__statement">{it.t}{it.gloss && (
                  <button type="button" class="ac__info ac__info--q" data-info aria-expanded="false" aria-label="What this term means">i</button>
                )}</span>
                <div class="ac__answer">
                  <div class="ac__scale" role="radiogroup" aria-label={it.t} data-scale data-q={`${p.id}-${ii}`}>
                    {SCALE.map((s) => (
                      <button type="button" class="ac__dot" role="radio" aria-checked="false"
                        data-score={s.v} aria-label={`${s.v} — ${s.label}`} title={s.label}>{s.k}</button>
                    ))}
                  </div>
                  <span class="ac__pick" data-pick aria-hidden="true"></span>
                </div>
                {it.gloss && <span class="ac__tip ac__tip--q" role="tooltip">{it.gloss}</span>}
              </li>
            ))}
          </ol>
        </div>
      ))}

      <div class="ac__step ac__results" data-step="results" hidden>
        <div class="ac__cachedbar" data-returning hidden>
          <span class="ac__cachedbar-kicker">Welcome back</span>
          <p data-returning-line>Here's the read you got last time. Nothing's changed unless you have.</p>
          <button type="button" class="ac__btn" data-variant="ghost" data-restart>Start over</button>
        </div>

        <span class="ac__kicker">Your AUXO Score</span>
        <p class="ac__sub" data-sub hidden></p>

        <div class="ac__scorewrap">
          <div class="ac__gauge">
            <svg viewBox="0 0 120 120" role="img" aria-label="Your AUXO Score out of 100">
              <g transform="rotate(-90 60 60)">
                <circle class="ac__gtrack" cx="60" cy="60" r="52"/>
                <circle class="ac__gfill" cx="60" cy="60" r="52" data-gauge-fill pathLength="100" stroke-dasharray="100" stroke-dashoffset="100"/>
              </g>
              <text class="ac__g-num" x="60" y="60" data-score-num text-anchor="middle" dominant-baseline="central">0</text>
              <text class="ac__g-unit" x="60" y="82" text-anchor="middle" dominant-baseline="central">/100</text>
            </svg>
          </div>
          <div class="ac__headline">
            <p class="ac__band" data-band>—</p>
            <p class="ac__tonext" data-tonext hidden></p>
            <div class="ac__levels-wrap">
              <button type="button" class="ac__levels-btn" data-info aria-expanded="false">See the four levels</button>
              <div class="ac__tip ac__tip--levels" role="tooltip">
                <ol class="ac__levels-list">
                  {bands.map((b) => (<li data-band-id={b.id}><b>{b.min}–{b.max}</b><span>{b.name}</span></li>))}
                </ol>
              </div>
            </div>
          </div>
        </div>
        <p class="ac__shape" data-shape></p>
        <p class="ac__read" data-read></p>

        <div class="ac__cards">
          <div class="ac__insight" data-pattern hidden>
            <span class="ac__insight-tag">What stands out</span>
            <h3 data-pattern-title>—</h3>
            <p data-pattern-body></p>
          </div>
          <div class="ac__start" data-start-block hidden>
            <span class="ac__start-tag">If you fix one thing</span>
            <p class="ac__start-lead" data-weak-name></p>
            <p class="ac__cost" data-weak-cost></p>
            <p data-weak-move></p>
            <p class="ac__aim-line" data-weak-aim></p>
          </div>
        </div>

        <div class="ac__barshead">
          <h3>The four pillars</h3>
          <span class="ac__aimkey"><i></i> aim for 75+ (“strong”)</span>
        </div>
        <div class="ac__bars" data-bars>
          {pillars.map((p) => (
            <div class="ac__pbar" data-pbar={p.id}>
              <div class="ac__pbar-top">
                <span class="ac__pbar-name"><span class="ac__pn">{p.n}</span> {p.label}
                  <button type="button" class="ac__info" data-info aria-expanded="false" aria-label={`What your ${p.label} score means`}>i</button>
                </span>
                <b><span data-pbar-num>0</span><small>/100</small></b>
              </div>
              <div class="ac__pbar-track"><i class="ac__pbar-aim"></i><span data-pbar-fill></span></div>
              <div class="ac__tip" data-pbar-read role="tooltip"></div>
            </div>
          ))}
        </div>

        <p class="ac__strength-line" data-strength-line hidden></p>

        <details class="ac__how">
          <summary>What's behind your number</summary>
          <div class="ac__how-body">
            <p>Each statement scores 1–5. Each pillar is normalised to 0–100 — <code>(sum of its answers − count) ÷ (4 × count) × 100</code> — so all 1s is 0 and all 5s is 100. Your AUXO Score is the equal-weighted average of the four. No hidden weighting, no curve.</p>
            <p class="ac__note">It's a self-read, so it's only as honest as your answers — enough to show you where to look, not a substitute for examining the real systems.</p>
          </div>
        </details>

        <div class="ac__close">
          <div class="ac__actions">
            <button type="button" class="ac__btn" data-variant="primary" data-copy>
              <span data-copy-label>Copy my summary</span>
            </button>
            <button type="button" class="ac__link" data-restart>Start over</button>
          </div>
          <p class="ac__fine">
            Your answers and result are cached in your browser so you can come back to them. If you've
            accepted analytics cookies, we record only your score, band, and weakest pillar — never your
            individual answers. Want a second pair of eyes? AUXO reads these:
            <button type="button" class="ac__inlinelink" data-google-calendar-open>book a 30-minute read-out</button>
            or email <a href="mailto:hello@auxodata.com">hello@auxodata.com</a>. No pitch — you'll get a straight answer.
          </p>
        </div>
      </div>
    </div>
  </Section>

  <style>
    .ac { --ac-1: .4rem; --ac-2: .7rem; --ac-3: 1.1rem; --ac-4: 1.6rem; --ac-5: 2.4rem; --ac-6: 3.2rem; max-width: 52rem; margin-inline: auto; }
    .ac [tabindex="-1"]:focus { outline: none; }
    .ac__step { opacity: 1; transform: none; }
    html[data-motion="on"] .ac__step.is-active { animation: ac-in .3s var(--ease-out) both; }
    @keyframes ac-in { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
    .ac__kicker { font: 600 var(--text-xs)/1 var(--font-mono); letter-spacing: var(--tracking-mono); text-transform: uppercase; color: var(--accent-2); display: block; margin-bottom: var(--ac-3); }
    .ac__pn { font: 600 0.85em/1 var(--font-mono); color: var(--accent-2); letter-spacing: var(--tracking-mono); }

    .ac__sticky { position: sticky; top: 0.5rem; z-index: 5; margin-bottom: var(--ac-4); padding: 0.65rem 0.75rem; background: color-mix(in oklch, var(--background) 88%, transparent); backdrop-filter: blur(8px); border: 1px solid var(--border); border-radius: var(--radius-lg); }
    .ac__steps { display: grid; grid-template-columns: repeat(5, 1fr); gap: var(--ac-1); margin-bottom: var(--ac-2); }
    .ac__seg { display: grid; gap: var(--ac-1); min-width: 0; }
    .ac__seg i { height: 4px; border-radius: var(--radius-full); background: var(--surface-sunken); }
    .ac__seg[data-state="done"] i { background: var(--accent); }
    .ac__seg[data-state="current"] i { background: var(--accent-2); }
    html[data-motion="on"] .ac__seg i { transition: background .35s var(--ease-glide); }
