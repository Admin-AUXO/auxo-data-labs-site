    .ac__pbar-track { position: relative; height: 9px; border-radius: var(--radius-full); background: var(--surface-raised); overflow: hidden; }
    .ac__pbar-track > span { display: block; height: 100%; width: 0; border-radius: inherit; background: var(--accent); }
    html[data-motion="on"] .ac__pbar-track > span { transition: width .9s var(--ease-glide); }
    .ac__pbar[data-weak] .ac__pbar-track > span { background: var(--accent-2); }
