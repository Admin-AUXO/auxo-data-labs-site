  </style>

  <script>
    const KEY = "auxo-self-check-v3";
    const RESULT_KEY = "auxo-self-check-result-v3";
    const BADGE_KEY = "auxo-self-check-badge-v1";
    const STORE_VERSION = 3;

    type Ctx = { role?: string; business?: string; scale?: string };
    type Store = { v: number; answers: Record<string, number>; ctx: Ctx; step: number };
    type Result = { v: number; ts: number; overall: number; band: string; weak: string; strong: string; scores: Record<string, number>; answers: Record<string, number>; ctx: Ctx };

    function init() {
      const root = document.querySelector<HTMLElement>("[data-assessment]");
      if (!root || root.dataset.bound === "1") return;
      root.dataset.bound = "1";

      const cfg = JSON.parse(document.getElementById("ac-config")?.textContent || "{}");
      const bands = cfg.bands as Array<{ id: string; min: number; max: number; name: string; read: string; cta: string }>;
      const meta = cfg.pillarMeta as Array<{ id: string; n: string; label: string; count: number }>;
      const moves = cfg.moves as Record<string, string>;
      const costs = cfg.cost as Record<string, string>;
      const reads = cfg.reads as Record<string, Record<string, string>>;
      const roleTone = cfg.roleTone as Record<string, string>;
      const severity = cfg.severity as Record<string, string>;
      const exNoun = cfg.exampleNoun as Record<string, string>;

      const steps = Array.from(root.querySelectorAll<HTMLElement>(".ac__step"));
      const resultsIdx = steps.findIndex((s) => s.dataset.step === "results");
      const lastPillarIdx = steps.map((s, i) => (s.dataset.step === "pillar" ? i : -1)).filter((i) => i >= 0).pop()!;
      const sticky = root.querySelector<HTMLElement>("[data-bar]")!;
      const legend = root.querySelector<HTMLElement>("[data-legend]")!;
      const journeySteps = steps.filter((s) => s.dataset.step === "context" || s.dataset.step === "pillar");
      const segEls = Array.from(root.querySelectorAll<HTMLElement>(".ac__seg"));
      const pillarCount = meta.length;

      const motionOn = document.documentElement.dataset.motion === "on";
      const reduce = !motionOn || matchMedia("(prefers-reduced-motion: reduce)").matches;
      const tierOf = (s: number) => (s < 25 ? "risk" : s < 50 ? "patchy" : s < 75 ? "manual" : "strong");

      const state: Store = { v: STORE_VERSION, answers: {}, ctx: {}, step: 0 };
      let lastSummary = "";
      let cameFromCache = false;
      let toastEl: HTMLElement | null = null;
      function toast(msg: string) {
        if (!toastEl) { toastEl = document.createElement("div"); toastEl.className = "ac__toast"; document.body.appendChild(toastEl); }
        toastEl.textContent = msg; toastEl.setAttribute("data-show", "");
        setTimeout(() => toastEl?.removeAttribute("data-show"), 1800);
      }

      function load(): Store {
        const empty: Store = { v: STORE_VERSION, answers: {}, ctx: {}, step: 0 };
        try { const raw = JSON.parse(localStorage.getItem(KEY) || "null"); if (!raw || raw.v !== STORE_VERSION) return empty; return { ...empty, ...raw }; }
        catch { return empty; }
      }
      function save() { try { localStorage.setItem(KEY, JSON.stringify(state)); } catch {} }
      function readResult(): Result | null { try { const r = JSON.parse(localStorage.getItem(RESULT_KEY) || "null"); return r && r.v === STORE_VERSION ? r : null; } catch { return null; } }

      Object.assign(state, load());

      root.querySelectorAll<HTMLElement>("[data-scale]").forEach((sc) => { const v = state.answers[sc.dataset.q!]; if (v) paint(sc, v); });
      root.querySelectorAll<HTMLElement>("[data-chips]").forEach((g) => {
        const key = g.dataset.chips!;
        g.querySelectorAll<HTMLButtonElement>(".ac__chip").forEach((c) => c.setAttribute("aria-pressed", (state.ctx as any)[key] === c.dataset.val ? "true" : "false"));
      });

      function paint(sc: HTMLElement, v: number) {
        let lbl = "";
        sc.querySelectorAll<HTMLButtonElement>(".ac__dot").forEach((d) => {
          const on = Number(d.dataset.score) === v;
          d.setAttribute("aria-checked", on ? "true" : "false"); d.tabIndex = on ? 0 : -1;
          if (on) lbl = d.getAttribute("title") || "";
        });
        const item = sc.closest<HTMLElement>(".ac__item");
        item?.setAttribute("data-answered", "");
        const pick = item?.querySelector<HTMLElement>("[data-pick]");
        if (pick) pick.textContent = lbl;
      }

      root.querySelectorAll<HTMLElement>("[data-scale]").forEach((sc) => {
        sc.addEventListener("click", (e) => {
          const dot = (e.target as HTMLElement).closest<HTMLButtonElement>(".ac__dot"); if (!dot) return;
          answer(sc, Number(dot.dataset.score));
        });
        sc.addEventListener("keydown", (e) => {
          const dots = Array.from(sc.querySelectorAll<HTMLButtonElement>(".ac__dot"));
          const cur = dots.findIndex((d) => d.getAttribute("aria-checked") === "true");
          let ni = -1;
          if (e.key === "ArrowRight" || e.key === "ArrowDown") ni = Math.min((cur < 0 ? -1 : cur) + 1, dots.length - 1);
          else if (e.key === "ArrowLeft" || e.key === "ArrowUp") ni = Math.max((cur < 0 ? dots.length : cur) - 1, 0);
          if (ni < 0) return;
          e.preventDefault(); answer(sc, Number(dots[ni].dataset.score)); dots[ni].focus();
        });
      });
      function answer(sc: HTMLElement, v: number) {
        state.answers[sc.dataset.q!] = v; paint(sc, v); save();
        const step = sc.closest<HTMLElement>('[data-step="pillar"]')!;
        refresh(step); advanceActive(step);
      }

      function advanceActive(step: HTMLElement) {
        const items = Array.from(step.querySelectorAll<HTMLElement>("[data-item]"));
        items.forEach((it) => it.removeAttribute("data-active"));
        const next = items.find((it) => !it.querySelector('.ac__dot[aria-checked="true"]'));
        if (next) next.setAttribute("data-active", "");
      }
      document.addEventListener("keydown", (e) => {
        if (root.dataset.bound !== "1" || !/^[1-5]$/.test(e.key)) return;
        const tag = (e.target as HTMLElement)?.tagName;
        if (tag === "INPUT" || tag === "TEXTAREA") return;
        if ((e.target as HTMLElement)?.closest?.(".ac__scale")) return;
        const step = steps.find((s) => !s.hidden); if (!step || step.dataset.step !== "pillar") return;
        const active = step.querySelector<HTMLElement>('[data-item][data-active]') || step.querySelector<HTMLElement>('[data-item]:not([data-answered])');
        const sc = active?.querySelector<HTMLElement>("[data-scale]"); if (!sc) return;
        e.preventDefault(); answer(sc, Number(e.key));
      });

      function refresh(step: HTMLElement) {
        const scales = step.querySelectorAll<HTMLElement>("[data-scale]");
        const done = Array.from(scales).every((s) => state.answers[s.dataset.q!]);
        const next = root.querySelector<HTMLButtonElement>("[data-next]")!;
        if (!step.hidden) next.disabled = !done;
      }

      root.querySelectorAll<HTMLElement>("[data-chips]").forEach((g) => {
        g.addEventListener("click", (e) => {
          const c = (e.target as HTMLElement).closest<HTMLButtonElement>(".ac__chip"); if (!c) return;
          const key = g.dataset.chips!;
          const wasOn = c.getAttribute("aria-pressed") === "true";
          g.querySelectorAll(".ac__chip").forEach((x) => x.setAttribute("aria-pressed", "false"));
          if (wasOn) { delete (state.ctx as any)[key]; }
          else { c.setAttribute("aria-pressed", "true"); (state.ctx as any)[key] = c.dataset.val!; }
          save();
        });
      });

      function show(i: number) {
        state.step = i; save();
        steps.forEach((s, idx) => { s.hidden = idx !== i; s.classList.toggle("is-active", idx === i); });
        const step = steps[i], kind = step.dataset.step;
        sticky.hidden = kind === "intro" || kind === "results";
        legend.hidden = kind !== "pillar";
        const nextLabel = root.querySelector<HTMLElement>("[data-next-label]")!;
        if (kind === "pillar") { advanceActive(step); refresh(step); nextLabel.textContent = i === lastPillarIdx ? "See score" : "Next"; }
        if (kind === "context") { root.querySelector<HTMLButtonElement>("[data-next]")!.disabled = false; nextLabel.textContent = "Start"; }
        progress(i);
        const h = step.querySelector<HTMLElement>("h1,h2,.ac__scenario,.ac__kicker"); h?.setAttribute("tabindex", "-1"); h?.focus({ preventScroll: true });
        window.scrollTo({ top: 0, behavior: reduce ? "auto" : "smooth" });
      }
      function progress(i: number) {
        const step = steps[i];
        const jIdx = journeySteps.indexOf(step);
        segEls.forEach((seg, idx) => { seg.dataset.state = jIdx < 0 ? "" : idx < jIdx ? "done" : idx === jIdx ? "current" : ""; });
        const lbl = root.querySelector<HTMLElement>("[data-steplabel]")!;
        if (step.dataset.step === "context") lbl.textContent = "Setup";
        else if (step.dataset.step === "pillar") lbl.textContent = `${step.dataset.name} · ${jIdx}/${pillarCount}`;
        else lbl.textContent = "";
      }

      root.querySelector("[data-start]")?.addEventListener("click", () => {
        try { (window as any).dataLayer = (window as any).dataLayer || []; (window as any).dataLayer.push({ event: "assessment_start", assessment: "auxo_self_check" }); } catch {}
        show(1);
      });
      root.querySelector("[data-resume]")?.addEventListener("click", () => show(Math.min(state.step || 1, steps.length - 1)));
      root.querySelector("[data-next]")?.addEventListener("click", () => {
        const i = steps.findIndex((s) => !s.hidden);
        if (i === lastPillarIdx) compute();
        show(Math.min(i + 1, steps.length - 1));
      });
      root.querySelector("[data-back]")?.addEventListener("click", () => show(Math.max(steps.findIndex((s) => !s.hidden) - 1, 0)));
      root.querySelectorAll("[data-restart]").forEach((b) => b.addEventListener("click", () => {
        state.answers = {}; state.ctx = {}; state.step = 0;
        try { localStorage.removeItem(KEY); } catch {}
        cameFromCache = false;
        resetForm();
        root.querySelector<HTMLElement>("[data-returning]")!.hidden = true;
        root.querySelector<HTMLElement>("[data-resume]")!.hidden = true;
        toast("Starting fresh — your last read stays until you finish a new one.");
        show(0);
      }));

      function resetForm() {
        root.querySelectorAll<HTMLElement>("[data-scale]").forEach((sc) => {
          sc.querySelectorAll<HTMLButtonElement>(".ac__dot").forEach((d, i) => { d.setAttribute("aria-checked", "false"); d.tabIndex = i === 0 ? 0 : -1; });
          const item = sc.closest<HTMLElement>(".ac__item");
          item?.removeAttribute("data-answered");
          item?.removeAttribute("data-active");
          const pick = item?.querySelector<HTMLElement>("[data-pick]"); if (pick) pick.textContent = "";
        });
        root.querySelectorAll<HTMLButtonElement>(".ac__chip").forEach((c) => c.setAttribute("aria-pressed", "false"));
        root.querySelectorAll<HTMLButtonElement>("[data-info]").forEach((b) => b.setAttribute("aria-expanded", "false"));
        root.querySelectorAll<HTMLElement>(".ac__tip").forEach((t) => t.removeAttribute("data-show"));
      }

      function closeTips() {
        root.querySelectorAll<HTMLElement>("[data-info]").forEach((o) => o.setAttribute("aria-expanded", "false"));
        root.querySelectorAll<HTMLElement>(".ac__tip").forEach((t) => t.removeAttribute("data-show"));
      }
      root.querySelectorAll<HTMLButtonElement>("[data-info]").forEach((btn) => {
        btn.addEventListener("click", (e) => {
          e.stopPropagation();
          const open = btn.getAttribute("aria-expanded") === "true";
          closeTips();
          if (!open) {
            btn.setAttribute("aria-expanded", "true");
            btn.closest(".ac__pbar, .ac__item, .ac__levels-wrap")?.querySelector<HTMLElement>(".ac__tip")?.setAttribute("data-show", "");
          }
        });
      });
      document.addEventListener("click", () => closeTips());
      document.addEventListener("keydown", (e) => { if (e.key === "Escape") closeTips(); });
      root.querySelector("[data-copy]")?.addEventListener("click", async () => {
        try { await navigator.clipboard.writeText(lastSummary); toast("Summary copied"); }
        catch { toast("Couldn't copy — select and copy manually"); }
      });

      function markNav() { try { (window as any).__auxoMarkSelfCheck?.(); } catch {} }

      function pScore(id: string) {
        const m = meta.find((p) => p.id === id)!; let sum = 0, a = 0;
        for (let i = 0; i < m.count; i++) { const v = state.answers[id + "-" + i]; if (v) { sum += v; a++; } }
        return a ? Math.round(((sum - a) / (4 * a)) * 100) : 0;
      }

      function compute() {
        const scores = meta.map((p) => ({ ...p, score: pScore(p.id) }));
        const byId: Record<string, number> = {}; scores.forEach((s) => (byId[s.id] = s.score));
        const overall = Math.round(scores.reduce((s, p) => s + p.score, 0) / scores.length);
        const band = bands.find((b) => overall >= b.min && overall <= b.max) || bands[0];
        let hi = scores[0], lo = scores[0];
        scores.forEach((s) => { if (s.score > hi.score) hi = s; if (s.score < lo.score) lo = s; });
        const spread = hi.score - lo.score;
        const even = spread <= 6;
        const d = byId.data, r = byId.reporting, a = byId.automation, c = byId.compliance;
        const noun = exNoun[state.ctx.business || ""] || "board pack";
        const col = overall < 25 ? "var(--color-danger)" : overall < 50 ? "var(--accent-2)" : "var(--accent)";
        const otherThreeAvg = (id: string) => { const o = scores.filter((s) => s.id !== id); return o.reduce((t, s) => t + s.score, 0) / o.length; };

        const gf = root.querySelector<SVGCircleElement>("[data-gauge-fill]")!;
        gf.style.stroke = col;
        if (reduce) gf.style.strokeDashoffset = String(100 - overall);
        else requestAnimationFrame(() => (gf.style.strokeDashoffset = String(100 - overall)));
        const numEl = root.querySelector<SVGTextElement>("[data-score-num]")!; numEl.style.fill = col;
        const bEl = root.querySelector<HTMLElement>("[data-band]")!; bEl.textContent = band.name; bEl.style.color = col;
        root.querySelectorAll<HTMLElement>("[data-band-id]").forEach((li) => li.toggleAttribute("data-current", li.getAttribute("data-band-id") === band.id));
        countTo(numEl, overall);

        const shapeEl = root.querySelector<HTMLElement>("[data-shape]")!;
        if (even && band.id === "strong") shapeEl.textContent = `All four pillars are strong and within a few points of each other (${lo.score}–${hi.score}) — a genuinely balanced operation.`;
        else if (even) shapeEl.textContent = `Your four pillars sit close together (${lo.score}–${hi.score}) — no single weak spot, which is its own kind of signal.`;
        else shapeEl.textContent = `${hi.label} is where you're strongest (${hi.score}). ${lo.label} is the drag (${lo.score}) — it's pulling the average down more than any other gap.`;

        const tone = state.ctx.role && roleTone[state.ctx.role] ? roleTone[state.ctx.role] : "";
        root.querySelector("[data-read]")!.textContent = band.read + tone;

        const subEl = root.querySelector<HTMLElement>("[data-sub]")!;
        if (state.ctx.role && state.ctx.role !== "Something else") { subEl.textContent = `${state.ctx.role} view`; subEl.hidden = false; }
        else { subEl.textContent = ""; subEl.hidden = true; }
        const nextBand = bands.find((b) => b.min > overall);
        const tn = root.querySelector<HTMLElement>("[data-tonext]")!; tn.hidden = false;
        if (nextBand) { const need = nextBand.min - overall; tn.textContent = `${need} point${need === 1 ? "" : "s"} from “${nextBand.name}.”`; }
        else tn.textContent = "Top band — genuinely well run.";

        const patterns = [
          { on: d < r - 12 && r >= 50, t: "Polished reports, shaky foundations", b: `Your reporting outruns your data — the riskiest gap to have. A ${noun} looks certain right up until one figure in it is wrong in the room.` },
          { on: a >= 60 && d < 45, t: "Automated, on numbers you don't fully trust", b: "You've automated the moving-around of data you haven't pinned down yet. Fast and confident is a liability when the source is shaky — you're scaling the error, not catching it." },
          { on: c < 45 && d >= 55 && r >= 55, t: "Trusted numbers, no paper trail", b: "The data's sound and the reports land — but you couldn't prove any of it on demand. Evidence is the layer you're missing, not accuracy." },
          { on: lo.id === "automation" && d >= 50 && r >= 50, t: "Right today, fragile tomorrow", b: "Your numbers are right because people force them to be. That holds — until someone leaves, or the volume doubles." },
          { on: r < d - 12 && d >= 50, t: "Good data you can't see", b: `You've done the hard part — the data is trustworthy. The gap is getting it into a ${noun} fast enough to matter.` },
          { on: c >= 60 && c - Math.max(d, r, a) >= 15, t: "Compliance is carrying the rest", b: "Compliance is your strongest pillar, which is unusual — it usually trails. Worth asking whether the discipline you've built there could pull everyday reporting up with it." },
          { on: r < 45 && c < 45, t: "The numbers don't travel", b: "Neither leadership nor an auditor gets what they need without a manual pull. Same root cause: too little of this is productised." },
          { on: spread >= 25 && lo.score < 40 && otherThreeAvg(lo.id) >= 60, t: "One weak link in a sound chain", b: `Three of your four pillars are in good shape — ${lo.label} is the outlier dragging the score down. That's the good kind of problem: a single, contained fix moves your whole number.` },
          { on: lo.id === "compliance" && c < 50, t: "Readiness is the cheapest cover you don't have", b: "If a regulator or investor asked tomorrow, the scramble would be real — and the fix is mostly plumbing you'd want anyway." },
          { on: spread <= 14 && overall < 50, t: "Even, and early", b: "No single disaster — just a foundation that's manual across the board. The upside: fix one pillar well and the others rise with it." },
          { on: spread <= 12 && overall >= 50 && overall < 75, t: "Solid all round, manual all round", b: "Nothing's broken and nothing's automated. You're carrying a reliable operation on effort — fine until the effort runs out." },
          { on: overall >= 75 && a < hi.score - 10, t: "Strong, but leaning on people", b: "You're well run — but automation is the soft spot in an otherwise strong picture. At your level the risk isn't accuracy, it's that too much still lives in specific people's hands." },
          { on: overall >= 75, t: "Well run — the question is what's next", b: "Little here needs rescuing. The upside is in what sharper analytics could pull from data you already trust." },
        ].filter((p) => p.on);
        const box = root.querySelector<HTMLElement>("[data-pattern]")!;
        if (patterns[0]) { box.hidden = false; box.querySelector("[data-pattern-title]")!.textContent = patterns[0].t; box.querySelector("[data-pattern-body]")!.textContent = patterns[0].b; }
        else box.hidden = true;

        scores.forEach((p) => {
          const el = root.querySelector<HTMLElement>(`[data-pbar="${p.id}"]`); if (!el) return;
          el.toggleAttribute("data-weak", p.id === lo.id && spread > 0);
          countTo(el.querySelector("[data-pbar-num]"), p.score);
          const w = p.score + "%";
          if (reduce) el.querySelector<HTMLElement>("[data-pbar-fill]")!.style.width = w;
          else requestAnimationFrame(() => (el.querySelector<HTMLElement>("[data-pbar-fill]")!.style.width = w));
          el.querySelector("[data-pbar-read]")!.textContent = reads[p.id][tierOf(p.score)];
        });

        const sl = root.querySelector<HTMLElement>("[data-strength-line]")!;
        sl.hidden = false;
        if (spread > 8) sl.textContent = `One thing you've already got: ${hi.label} is at ${hi.score}. That's a real asset — the goal is to bring the rest up to meet it, not to start from zero.`;
        else if (overall >= 50) sl.textContent = `You don't have a weak pillar to lean away from — ${hi.label} (${hi.score}) is your steadiest, and it's close. Build the next move on the habits that got it there.`;
        else sl.textContent = "Nothing here is broken beyond repair — your pillars are low but even, which means there's no deep hole to climb out of, just a floor to raise.";

        let target = lo;
        if (lo.id !== "data" && byId.data < 50 && byId.data - lo.score <= 8) target = scores.find((s) => s.id === "data")!;
        const sb = root.querySelector<HTMLElement>("[data-start-block]")!; sb.hidden = false;
        sb.querySelector("[data-weak-name]")!.textContent = (even && band.id === "strong")
          ? `Where the next gain is: ${target.label.toLowerCase()}.`
          : `Fix ${target.label.toLowerCase()} first.`;
        let cost = costs[target.id].replace("{noun}", noun);
        const sev = state.ctx.scale ? severity[state.ctx.scale] : "";
        if (sev) cost = sev + cost.charAt(0).toLowerCase() + cost.slice(1);
        sb.querySelector("[data-weak-cost]")!.textContent = cost;
        sb.querySelector("[data-weak-move]")!.textContent = moves[target.id];
        const head = 75 - target.score;
        sb.querySelector("[data-weak-aim]")!.textContent = head > 0
          ? `What “good” looks like: ${target.label} at 75+. You're at ${target.score} — ${head} point${head === 1 ? "" : "s"} of headroom.`
          : `What “good” looks like is holding ${target.label} where it is (${target.score}) — you're already past the bar.`;

        lastSummary = `AUXO Score: ${overall}/100 — ${band.name}\n`
          + scores.map((p) => `• ${p.label}: ${p.score}/100`).join("\n")
          + `\nStart with: ${target.label} (${target.score}/100).\n${band.cta}\n— auxodata.com/self-check`;

        try {
          localStorage.setItem(RESULT_KEY, JSON.stringify({ v: STORE_VERSION, ts: Date.now(), overall, band: band.id, weak: lo.id, strong: hi.id, scores: byId, answers: state.answers, ctx: state.ctx } as Result));
          localStorage.setItem(BADGE_KEY, String(overall));
        } catch {}
        markNav();

        if (!cameFromCache) {
          try { (window as any).dataLayer = (window as any).dataLayer || []; (window as any).dataLayer.push({ event: "assessment_complete", assessment: "auxo_self_check", auxo_score: overall, auxo_band: band.id, weak_pillar: lo.id }); } catch {}
        }
      }

      function countTo(el: Element | null, target: number) {
        if (!el) return; if (reduce) { el.textContent = String(target); return; }
        const t0 = performance.now();
        const tick = (t: number) => { const k = Math.min((t - t0) / 850, 1); el.textContent = String(Math.round((1 - Math.pow(1 - k, 3)) * target)); if (k < 1) requestAnimationFrame(tick); };
        requestAnimationFrame(tick);
      }

      const cached = readResult();
      if (cached) {
        state.answers = cached.answers; state.ctx = cached.ctx;
        root.querySelectorAll<HTMLElement>("[data-scale]").forEach((sc) => { const v = state.answers[sc.dataset.q!]; if (v) paint(sc, v); });
        cameFromCache = true;
        compute();
        const bar = root.querySelector<HTMLElement>("[data-returning]")!;
        bar.hidden = false;
        if (Date.now() - cached.ts > 90 * 864e5) root.querySelector("[data-returning-line]")!.textContent = "It's been a while. If your systems have moved on, it's worth a fresh read.";
        show(resultsIdx);
      } else {
        if (Object.keys(state.answers).length && state.step > 0) root.querySelector<HTMLElement>("[data-resume]")!.hidden = false;
        show(0);
      }
    }

    init();
    document.addEventListener("astro:page-load", init);
  </script>
</BaseLayout>
