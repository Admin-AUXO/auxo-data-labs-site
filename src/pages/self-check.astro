      .ac__steplabel { font-size: 0.68rem; letter-spacing: 0.04em; }
      .ac__legend { margin-top: 0.5rem; padding-top: 0.5rem; }
      .ac__legend-q { display: none; }
      .ac__legend-scale { gap: 0.25rem 0.7rem; }

      .ac__title { font-size: var(--text-2xl); }
      .ac__scenario { font-size: var(--text-base); }
      .ac__item { grid-template-columns: 1fr; gap: 0.45rem; padding: 0.6rem 0.7rem; }
      .ac__statement { font-size: var(--text-base); }
      .ac__answer { justify-items: stretch; }
      .ac__scale { gap: 0.35rem; }
      .ac__dot { width: 100%; height: 2.85rem; font-size: var(--text-base); }
      .ac__pick { text-align: left; }
      .ac__chip { padding: 0.6rem 1rem; }

      .ac__scorewrap { gap: 1rem; margin-bottom: var(--ac-2); }
      .ac__gauge { width: 104px; height: 104px; }
      .ac__headline { min-width: 9rem; }
      .ac__band { font-size: var(--text-xl); }
      .ac__shape { font-size: var(--text-base); }
      .ac__cards { grid-template-columns: 1fr; gap: var(--ac-2); }
      .ac__barshead { flex-direction: column; align-items: flex-start; gap: 0.3rem; }
      .ac__bars { padding: 0.1rem 0.9rem; }
      .ac__insight, .ac__start { padding: 0.95rem 1rem; }
      .ac__cachedbar { padding: 0.7rem 0.85rem; }
