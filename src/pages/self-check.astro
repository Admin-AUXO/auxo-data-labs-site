    .ac__strength-line { color: var(--muted); margin: 0 0 var(--ac-4); padding-left: 0.9rem; border-left: 2px solid var(--accent); font-size: var(--text-sm); max-width: 62ch; }
    .ac__strength-line[hidden] { display: none; }

    .ac__start { background: var(--surface-sunken); border: 1px solid var(--border); border-left: 3px solid var(--accent-2); border-radius: var(--radius-md); padding: 1.1rem 1.2rem; margin-bottom: var(--ac-4); }
    .ac__start-tag { display: inline-block; font: 600 var(--text-xs)/1 var(--font-mono); letter-spacing: var(--tracking-mono); text-transform: uppercase; color: var(--accent-2); margin-bottom: 0.6rem; }
