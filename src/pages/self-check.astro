    .ac__pbar:has([data-info]:focus-visible) .ac__tip, .ac__item:has([data-info]:focus-visible) .ac__tip, .ac__levels-wrap:has([data-info]:focus-visible) .ac__tip { opacity: 1; visibility: visible; transform: none; }
