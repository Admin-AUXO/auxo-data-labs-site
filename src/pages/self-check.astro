    .ac__how code { font-family: var(--font-mono); font-size: 0.9em; background: var(--surface-sunken); padding: 0.1rem 0.35rem; border-radius: var(--radius-sm); color: var(--foreground); }
    .ac__close { border-top: 1px solid var(--border); padding-top: var(--ac-4); }

    .ac__blurb { color: var(--subtle); font-weight: 400; font-size: var(--text-sm); }
    .ac__meta { list-style: none; display: flex; flex-wrap: wrap; gap: 0.5rem 1.2rem; padding: 0; margin: 0 0 var(--ac-4); }
    .ac__meta li { position: relative; padding-left: 1.1rem; font: 600 var(--text-xs)/1.3 var(--font-mono); letter-spacing: 0.02em; text-transform: uppercase; color: var(--muted); }
    .ac__meta li::before { content: ""; position: absolute; left: 0; top: 0.15em; width: 7px; height: 7px; border-radius: 2px; background: var(--accent); }
    .ac__sub { font: 600 var(--text-xs)/1 var(--font-mono); letter-spacing: var(--tracking-mono); text-transform: uppercase; color: var(--subtle); margin: 0 0 var(--ac-4); }

    :global(.ac__toast) { position: fixed; left: 50%; bottom: 1.5rem; transform: translateX(-50%) translateY(1rem); opacity: 0; background: var(--foreground); color: var(--background); font-weight: 600; font-size: var(--text-sm); padding: 0.6rem 1.1rem; border-radius: var(--radius-full); transition: opacity .25s, transform .25s; pointer-events: none; z-index: 1200; }
    :global(.ac__toast[data-show]) { opacity: 1; transform: translateX(-50%) translateY(0); }

    @media (max-width: 640px) {
      .ac { --ac-4: 1.3rem; --ac-5: 1.9rem; }
