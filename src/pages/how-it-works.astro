---
import { Icon } from "astro-icon/components";
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/layout/Section.astro";
import SectionHeader from "../components/ui/SectionHeader.astro";
import Button from "../components/ui/Button.astro";
import HighlightText from "../components/ui/HighlightText.astro";
import Specimen from "../components/ui/Specimen.astro";
import Accordion from "../components/ui/Accordion.astro";
import CtaSection from "../components/sections/shared/CtaSection.astro";
import StructuredData from "../components/layout/StructuredData.astro";
import { faqSchema } from "../lib/structured-data";
import { howItWorksContent as c } from "../data/how-it-works";
import { escapeHtml } from "../lib/text";
import "../styles/pages/how-it-works.css";

const faqItems = c.faq.items.map((item) => ({
  title: item.question,
  body:
    `<p>${escapeHtml(item.answer)}</p>` +
    ("link" in item && item.link
      ? `<p><a class="hiw-faq-link" href="${escapeHtml(item.link.href)}">${escapeHtml(item.link.text)}</a></p>`
      : ""),
}));

---
<BaseLayout title={c.meta.title} description={c.meta.description}>
  <Section padding="lg" width="7xl" class="hiw-hero-section">
    <div class="page-hero hiw-hero">
      <h1 class="page-hero__title hiw-title" aria-label={c.intro.title}>
        {
          c.ladder.steps.map((s) => (
            <span class="hiw-title__line" aria-hidden="true">{s.name}<span class="hl-accent">.</span></span>
          ))
        }
      </h1>
      <div class="page-hero__side">
        <p class="page-hero__lead">{c.intro.lead}</p>
        <div class="page-hero__ctas">
          <Button variant="primary" size="lg" href={c.intro.primaryCta.href} icon class="w-full sm:w-auto">
            {c.intro.primaryCta.text}
          </Button>
          <Button variant="secondary" size="lg" href={c.intro.secondaryCta.href} class="w-full sm:w-auto">
            {c.intro.secondaryCta.text}
          </Button>
        </div>
      </div>
    </div>
  </Section>

  <Section padding="sm" width="7xl">
    <div class="stack">
      {
        c.ladder.steps.map((step, i) => (
          <article
            id={step.id}
            class:list={["step", "hiw-anchor", step.id === "build" && "ground-lime"]}
            style={`--i:${i}`}
            aria-labelledby={`${step.id}-title`}
          >
            <header class="step__tab">
              <span class="sq" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
              <h2 id={`${step.id}-title`} class="step__name">{step.name}</h2>
              <p class="step__cost" data-tone={step.cost.tone}>{step.cost.label}</p>
            </header>

            <div class="step__inner">
              <div class="step__top">
                <div class="step__lede">
                  <p class="step__promise"><HighlightText text={step.promise} soften /></p>
                  {step.links.length > 0 && (
                    <ul class="step__links">
                      {step.links.map((l) => (
                        <li>
                          <a class="hiw-link" href={l.href}>
                            {l.text}
                            <Icon name="mdi:arrow-right" aria-hidden="true" />
                          </a>
                        </li>
                      ))}
                    </ul>
                  )}
                  {step.id === "build" && <p class="step__own">{c.ladder.build.ownershipLine}</p>}
                </div>
                <Specimen example={step.example} />
              </div>
              <h3 class="sr-only">{c.ladder.labels.whatYouGet}</h3>
              <ul class="step__gets">
                {step.whatYouGet.map((g) => (
                  <li class="step__get">
                    <h4 class="step__get-title">
                      {g.title}
                      {g.tag && <span class="step__tag" data-tone={g.tone}>{g.tag}</span>}
                    </h4>
                    <p class="step__get-body">{g.body}</p>
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }
    </div>

    <article id={c.ladder.upkeep.id} class="upkeep hiw-anchor" aria-labelledby="managed-upkeep-title">
      <span class="sq" aria-hidden="true">+</span>
      <div class="upkeep__text">
        <h2 id="managed-upkeep-title" class="upkeep__title">{c.ladder.upkeep.title}</h2>
        <p class="upkeep__body">{c.ladder.upkeep.promise} {c.ladder.upkeep.terms}</p>
      </div>
      <p class="upkeep__tag">{c.ladder.upkeep.label}</p>
    </article>
  </Section>

  <Section id="method" padding="lg" width="7xl" class="hiw-anchor">
    <div class="method-head">
      <h2 class="method-head__title"><HighlightText text={c.method.title} soften /></h2>
      <p class="method-head__lead">{c.method.lead}</p>
    </div>
    <ol class="method">
      {
        c.method.dimensions.map((d, i) => (
          <li class="method__item">
            <span class="sq" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
            <h3 class="method__name">{d.name}</h3>
            <p class="method__question">{d.question}</p>
          </li>
        ))
      }
    </ol>
    <div class="method__cta">
      <Button variant="secondary" size="md" href={c.method.cta.href} icon>{c.method.cta.text}</Button>
    </div>
  </Section>

  <Section id="faq" padding="lg" width="7xl" class="hiw-anchor">
    <div class="faq-split">
      <SectionHeader title={c.faq.title} />
      <div class="faq-split__list" data-reveal>
        <Accordion items={faqItems} openFirst />
      </div>
    </div>
  </Section>

  <CtaSection
    title={c.cta.title}
    description={c.cta.description}
    ctaText={c.cta.ctaText}
    ctaHref={c.cta.ctaHref}
    reassurance={c.cta.reassurance}
  />

  <StructuredData type="FAQPage" data={faqSchema(c.faq.items)} />
</BaseLayout>

<script>
  import "../scripts/how-it-works";
</script>
