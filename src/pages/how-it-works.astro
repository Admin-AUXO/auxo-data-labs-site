---
import { Icon } from "astro-icon/components";
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/layout/Section.astro";
import SectionHeader from "../components/ui/SectionHeader.astro";
import Button from "../components/ui/Button.astro";
import HighlightText from "../components/ui/HighlightText.astro";
import Accordion from "../components/ui/Accordion.astro";
import CtaSection from "../components/sections/shared/CtaSection.astro";
import StructuredData from "../components/layout/StructuredData.astro";
import { faqSchema } from "../lib/structured-data";
import { howItWorksContent as c } from "../data/how-it-works";
import { escapeHtml } from "../lib/text";
import "../styles/pages/how-it-works.css";

const faqItems = c.faq.items.map((item) => ({
  title: item.question,
  body:
    `<p>${escapeHtml(item.answer)}</p>` +
    ("link" in item && item.link
      ? `<p><a class="hiw-faq-link" href="${escapeHtml(item.link.href)}">${escapeHtml(item.link.text)}</a></p>`
      : ""),
}));

const mapItems = [
  ...c.ladder.steps.map((s) => ({
    id: s.id,
    icon: s.icon,
    name: s.name,
    tag: null as string | null,
  })),
  {
    id: c.ladder.upkeep.id,
    icon: c.ladder.upkeep.icon,
    tag: c.ladder.upkeep.label as string | null,
    name: c.ladder.upkeep.title,
  },
];

const facts = [
  { kind: "duration", label: c.ladder.labels.duration, icon: "mdi:clock-outline" },
  { kind: "suits", label: c.ladder.labels.suits, icon: "mdi:target" },
  { kind: "bring", label: c.ladder.labels.bring, icon: "mdi:account-group-outline" },
  { kind: "isNot", label: c.ladder.labels.isNot, icon: "mdi:close-circle-outline" },
] as const;
---
<BaseLayout title={c.meta.title} description={c.meta.description}>
  <Section padding="lg" width="7xl">
    <div class="hiw-hero">
      <div class="hiw-hero__head">
        <p class="section-index" data-enter>{c.intro.eyebrow}</p>
        <h1 class="hiw-hero__title" data-enter>
          <HighlightText text={c.intro.title} highlight={c.intro.titleHighlight} />
        </h1>
      </div>
      <div class="hiw-hero__side" data-enter>
        <p class="lead hiw-hero__lead">{c.intro.lead}</p>
        <Button variant="primary" size="lg" href={c.intro.primaryCta.href} icon class="w-full sm:w-auto">
          {c.intro.primaryCta.text}
        </Button>
      </div>
      <nav class="hiw-map" aria-label={c.ladder.navLabel} data-enter>
        <ol class="hiw-map__list">
          {
            mapItems.map((n) => (
              <li>
                <a class="hiw-map__link" href={`#${n.id}`}>
                  <Icon name={n.icon} class="hiw-map__icon" aria-hidden="true" />
                  <span class="hiw-map__text">
                    <span class="hiw-map__name">{n.name}</span>
                    {n.tag && <span class="hiw-map__tag">{n.tag}</span>}
                  </span>
                  <Icon name="mdi:arrow-right" class="hiw-map__go" aria-hidden="true" />
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
    </div>
  </Section>

  <Section padding="sm" width="7xl">
    <div class="ladder">
      <div class="ladder__stack">
      {
        c.ladder.steps.map((step) => (
          <article id={step.id} class="ladder__step hiw-anchor" aria-labelledby={`${step.id}-title`}>
            <div class="ladder__head" data-reveal>
              <Icon name={step.icon} class="ladder__icon" aria-hidden="true" />
              <h2 id={`${step.id}-title`} class="ladder__name">{step.name}</h2>
              <p class="ladder__promise">{step.promise}</p>
              {step.links.length > 0 && (
                <ul class="ladder__links">
                  {step.links.map((l) => (
                    <li>
                      <a class="hiw-link" href={l.href}>
                        {l.text}
                        <Icon name="mdi:arrow-right" aria-hidden="true" />
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </div>

            <dl class="ladder__facts" data-reveal>
              {facts.map((f) => (
                <div class="ladder__fact" data-kind={f.kind}>
                  <dt class="ladder__fact-label">
                    <Icon name={f.icon} aria-hidden="true" />
                    {f.label}
                  </dt>
                  <dd>{step[f.kind]}</dd>
                </div>
              ))}
            </dl>

            <div class="ladder__what" data-reveal>
              <h3 class="sr-only">{c.ladder.labels.whatYouGet}</h3>
              <ul class="ladder__gets" style={`--n:${step.whatYouGet.length}`}>
                {step.whatYouGet.map((g, i) => (
                  <li class="ladder__get" data-anim="rise" style={`--i:${i}`}>
                    <span class="ladder__get-icon" aria-hidden="true">
                      <Icon name={g.icon} />
                    </span>
                    <div class="ladder__get-head">
                      <h4 class="ladder__get-title">{g.title}</h4>
                      {g.tag && (
                        <span class="ladder__tag" data-tone={g.tone}>
                          {g.tag}
                        </span>
                      )}
                    </div>
                    <p class="ladder__get-body">{g.body}</p>
                  </li>
                ))}
              </ul>
            </div>

            {step.id === "build" && (
              <div class="ladder__own" data-reveal>
                <p class="ladder__own-line">{c.ladder.build.ownershipLine}</p>
                <p class="text-sm text-subtle">{c.ladder.build.aiBuiltNote}</p>
              </div>
            )}
          </article>
        ))
      }
      </div>

      <article id={c.ladder.upkeep.id} class="upkeep hiw-anchor" aria-labelledby="managed-upkeep-title" data-reveal>
        <Icon name={c.ladder.upkeep.icon} class="upkeep__icon" aria-hidden="true" />
        <div class="upkeep__head">
          <h2 id="managed-upkeep-title" class="upkeep__title">{c.ladder.upkeep.title}</h2>
          <span class="upkeep__tag">{c.ladder.upkeep.label}</span>
        </div>
        <p class="upkeep__body">
          {c.ladder.upkeep.promise} {c.ladder.upkeep.terms}
        </p>
      </article>
    </div>
  </Section>

  <Section id="method" padding="lg" width="7xl" class="hiw-anchor">
    <SectionHeader title={c.method.title} subtitle={c.method.lead} />
    <ol class="method mt-8">
      {
        c.method.dimensions.map((d, i) => (
          <li class="method__item" data-anim="rise" style={`--i:${i}`}>
            <span class="mono-datum text-accent-2">{String(i + 1).padStart(2, "0")}</span>
            <h3 class="method__name">{d.name}</h3>
            <p class="method__question text-muted">{d.question}</p>
          </li>
        ))
      }
    </ol>
  </Section>

  <Section id="faq" padding="lg" width="7xl" class="hiw-anchor">
    <div class="faq-split">
      <SectionHeader title={c.faq.title} />
      <div class="faq-split__list" data-reveal>
        <Accordion items={faqItems} openFirst />
      </div>
    </div>
  </Section>

  <CtaSection
    title={c.cta.title}
    description={c.cta.description}
    ctaText={c.cta.ctaText}
    ctaHref={c.cta.ctaHref}
    reassurance={c.cta.reassurance}
  />

  <StructuredData type="FAQPage" data={faqSchema(c.faq.items)} />
</BaseLayout>
