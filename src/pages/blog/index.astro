---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Section from "../../components/layout/Section.astro";
import HighlightText from "../../components/ui/HighlightText.astro";
import Card from "../../components/ui/Card.astro";
import {
  sortByPublishDate,
  formatBlogDate,
  getReadingTimeMinutes,
} from "../../lib/blog";

const posts = sortByPublishDate(await getCollection("blog"));
const [featured, ...rest] = posts;

const meta = (post: (typeof posts)[number]) => ({
  date: formatBlogDate(post.data.publishDate),
  readingTime: getReadingTimeMinutes(post.body ?? ""),
  tag: post.data.tags[0],
});
---

<BaseLayout
  title="Insights"
  description="Field notes on decision intelligence, operating models, and analytics from the AUXO team."
>
  <Section padding="lg" decoration="grid">
    <div class="mx-auto flex max-w-3xl flex-col items-center gap-4 text-center">
      <p class="text-sm font-semibold uppercase tracking-[0.14em] text-accent">Insights</p>
      <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">
        <HighlightText text="Notes on the decision layer" highlight="decision layer" />
      </h1>
      <p class="text-lg text-muted">
        Essays on why analytics investment hasn't moved decision speed — and what actually fixes it.
      </p>
    </div>

    {
      featured && (
        <div class="mt-12">
          <Card
            href={`/blog/${featured.id}/`}
            interactive
            class="grid gap-6 md:grid-cols-2 md:items-center"
          >
            {featured.data.heroImage && (
              <img
                src={featured.data.heroImage}
                alt=""
                loading="eager"
                class="aspect-[16/9] w-full rounded-lg border border-border object-cover"
              />
            )}
            <div class="flex flex-col gap-4">
              <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-subtle">
                <span class="font-semibold text-accent">Latest</span>
                <span aria-hidden="true">·</span>
                <span>{meta(featured).date}</span>
                <span aria-hidden="true">·</span>
                <span>{meta(featured).readingTime} min read</span>
                {meta(featured).tag && (
                  <>
                    <span aria-hidden="true">·</span>
                    <span>{meta(featured).tag}</span>
                  </>
                )}
              </div>
              <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">
                {featured.data.title}
              </h2>
              <p class="text-muted">{featured.data.description}</p>
              <span class="card__link mt-0">
                Read the article
                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <line x1="5" y1="12" x2="19" y2="12" />
                  <polyline points="12 5 19 12 12 19" />
                </svg>
              </span>
            </div>
          </Card>
        </div>
      )
    }

    {
      rest.length > 0 && (
        <div class="mt-6 grid gap-6 lg:grid-cols-3 md:grid-cols-2">
          {rest.map((post) => {
            const m = meta(post);
            return (
              <Card
                href={`/blog/${post.id}/`}
                interactive
                class="flex flex-col gap-4"
              >
                {post.data.heroImage && (
                  <img
                    src={post.data.heroImage}
                    alt=""
                    loading="lazy"
                    class="aspect-[16/9] w-full rounded-lg border border-border object-cover"
                  />
                )}
                <div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-subtle">
                  <span>{m.date}</span>
                  <span aria-hidden="true">·</span>
                  <span>{m.readingTime} min read</span>
                </div>
                <h3 class="card__title">{post.data.title}</h3>
                <p class="card__desc mt-0">{post.data.description}</p>
                {m.tag && (
                  <p class="mt-auto text-sm font-semibold text-accent">
                    {m.tag}
                  </p>
                )}
              </Card>
            );
          })}
        </div>
      )
    }
  </Section>
</BaseLayout>
