---
import { Icon } from "astro-icon/components";
import { siteData } from "../../data/site";

interface Props {
  class?: string;
}

const { class: cls = "" } = Astro.props;

const links = [
  { name: "LinkedIn", href: siteData.social.linkedin, icon: "mdi:linkedin" },
  { name: "X (Twitter)", href: siteData.social.twitter, icon: "simple-icons:x" },
];
---

<ul class={`social-links ${cls}`.trim()}>
  {
    links.map((l) => (
      <li>
        <a
          href={l.href}
          class="social-links__item"
          target="_blank"
          rel="noopener noreferrer"
          aria-label={l.name}
        >
          <Icon name={l.icon} aria-hidden="true" />
        </a>
      </li>
    ))
  }
</ul>
