---
import Dialog from "../ui/Dialog.astro";
import { siteData } from "../../data/site";
---

<Dialog id="calendar-dialog" title="Book a meeting" size="lg" class="calendar-dialog">
  <iframe
    title="Schedule a meeting with AUXO"
    data-src={siteData.bookingUrl}
    class="calendar-dialog__iframe"
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"
  ></iframe>
</Dialog>
