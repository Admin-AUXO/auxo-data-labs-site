---
interface Props {
  href?: string;
  showText?: boolean;
  class?: string;
}

const { href = "/", showText = true, class: cls = "" } = Astro.props;

const cells = [
  { x: 0, y: 0, label: "A", tx: 9, ty: 14 },
  { x: 22, y: 0, label: "U", tx: 31, ty: 14 },
  { x: 0, y: 22, label: "X", tx: 9, ty: 36 },
  { x: 22, y: 22, label: "O", tx: 31, ty: 36 },
];
---

<a href={href} class={`logo ${cls}`.trim()} aria-label="AUXO Data Labs home">
  <svg viewBox="0 0 40 40" class="logo__mark" fill="none" aria-hidden="true">
    {
      cells.map((c) => (
        <>
          <rect x={c.x} y={c.y} width="18" height="18" fill="var(--accent)" />
          <text
            x={c.tx}
            y={c.ty}
            text-anchor="middle"
            font-family="var(--font-brand)"
            font-weight="900"
            font-size="13"
            fill="var(--accent-foreground)">{c.label}</text>
        </>
      ))
    }
  </svg>
  {
    showText && (
      <span class="logo__text">
        <span class="logo__name">AUXO</span>
        <span class="logo__tagline">Data Labs</span>
      </span>
    )
  }
</a>
