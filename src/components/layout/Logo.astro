---
interface Props {
  href?: string;
  showText?: boolean;
  class?: string;
}

const { href = "/", showText = true, class: cls = "" } = Astro.props;

const tiles = [
  { x: 0, y: 0, cx: 9.35, label: "A" },
  { x: 21.3, y: 0, cx: 30.65, label: "U" },
  { x: 0, y: 21.3, cx: 9.35, label: "X" },
  { x: 21.3, y: 21.3, cx: 30.65, label: "O" },
];
---

<a href={href} class={`logo ${cls}`.trim()} aria-label="AUXO Data Labs home">
  <svg viewBox="0 0 40 40" class="logo__mark" role="img" aria-hidden="true">
    {tiles.map((t) => <rect x={t.x} y={t.y} width="18.7" height="18.7" fill="var(--accent)" />)}
    <g class="logo__letters" fill="var(--accent-foreground)">
      {
        tiles.map((t) => (
          <text x={t.cx} y={t.y === 0 ? 13.7 : 35} text-anchor="middle">
            {t.label}
          </text>
        ))
      }
    </g>
  </svg>
  {
    showText && (
      <span class="logo__text">
        <span class="logo__name">Data Labs</span>
        <span class="logo__sub">Look Beyond Data</span>
      </span>
    )
  }
</a>
