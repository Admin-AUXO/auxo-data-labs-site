---
import { withBase } from "../../lib/url";
import Mark from "./Mark.astro";

interface Props {
  href?: string;
  markOnly?: boolean;
  responsive?: boolean;
  class?: string;
}

const { href = "/", markOnly = false, responsive = false, class: cls = "" } = Astro.props;

const wordClass = ["logo__word", responsive && "logo__word--responsive"].filter(Boolean).join(" ");
---

<a href={withBase(href)} class={`logo ${cls}`.trim()} aria-label="AUXO Data Labs home">
  <Mark class="logo__mark" />
  {
    !markOnly && (
      <span class={wordClass}>
        AUXO<span class="logo__word-sub">Data Labs</span>
      </span>
    )
  }
</a>
