---
---
<div class="consent is-hidden" data-consent-banner role="region" aria-label="Cookie consent">
  <p class="consent__text">
    We use privacy-friendly analytics to understand how the site is used. See our
    <a href="/legal/cookie-policy/">Cookie Policy</a>.
  </p>
  <div class="consent__actions">
    <button type="button" class="btn" data-variant="ghost" data-size="sm" data-consent-decline>
      Decline
    </button>
    <button type="button" class="btn" data-variant="primary" data-size="sm" data-consent-accept>
      Accept
    </button>
  </div>
</div>

<style>
  .consent {
    align-items: center;
    background-color: var(--surface-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-lg);
    display: flex;
    gap: 0.75rem;
    inset-block-end: 0.75rem;
    inset-inline: 1rem;
    margin-inline: auto;
    max-inline-size: 42rem;
    padding: 0.5rem 0.5rem 0.5rem 1rem;
    position: fixed;
    z-index: var(--z-toast);
  }

  .consent.is-hidden {
    display: none;
  }

  .consent__text {
    color: var(--muted);
    flex: 1 1 auto;
    font-size: var(--text-xs);
  }

  .consent__text a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .consent__actions {
    display: flex;
    gap: 0.5rem;
    margin-inline-start: auto;
  }

  @media (width <= 40rem) {
    .consent {
      border-radius: var(--radius-lg);
      gap: 0.625rem;
      inset-block-end: 0.5rem;
      inset-inline: 0.5rem;
      padding: 0.5rem 0.5rem 0.5rem 0.75rem;
    }

    .consent__text {
      font-size: 0.75rem;
      line-height: 1.35;
    }

    .consent__actions {
      flex-shrink: 0;
      gap: 0.25rem;
    }

    .consent__actions :global(.btn) {
      min-block-size: 40px;
      padding-inline: 0.625rem;
    }

    :global(body:has([data-consent-banner]:not(.is-hidden))) {
      padding-block-end: 5rem;
    }
  }
</style>

<script>
  import { initConsent } from "../../scripts/analytics/consent";
  initConsent();
  document.addEventListener("astro:page-load", initConsent);
</script>
