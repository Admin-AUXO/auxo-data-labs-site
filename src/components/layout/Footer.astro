---
import { Icon } from "astro-icon/components";
import Logo from "./Logo.astro";
import SocialLinks from "./SocialLinks.astro";
import HighlightText from "../ui/HighlightText.astro";
import { footerContent } from "../../data/footer";
import { siteData } from "../../data/site";
import { withBase } from "../../lib/url";

const { statement, statementHighlight, tagline, sections, note } = footerContent;
const year = new Date().getFullYear();
const location = `${siteData.address.city}, ${siteData.address.country}`;
---

<footer class="footer" data-pagefind-ignore>
  <div class="footer__inner">
    <div class="footer__lead">
      <p class="footer__statement" data-anim="type">
        <HighlightText text={statement} highlight={statementHighlight} />
      </p>
    </div>

    <div class="footer__grid">
      <div class="footer__brand">
        <Logo />
        <p class="footer__tagline">{tagline}</p>
        <p class="footer__note">{note}</p>
        <SocialLinks />
      </div>

      {
        sections.map((s) => (
          <nav class="footer__col" aria-label={s.title}>
            <p class="footer__col-title">{s.title}</p>
            <ul class="footer__list">
              {s.links.map((l) => (
                <li>
                  <a href={withBase(l.href)} class="footer__link">
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }

      <div class="footer__col">
        <p class="footer__col-title">Connect</p>
        <ul class="footer__contact">
          <li>
            <Icon name="mdi:email-outline" aria-hidden="true" />
            <a href={`mailto:${siteData.email}`}>{siteData.email}</a>
          </li>
          <li>
            <Icon name="mdi:map-marker-outline" aria-hidden="true" />
            <span>{location}</span>
          </li>
          <li>
            <Icon name="mdi:clock-check-outline" aria-hidden="true" />
            <span>{siteData.stats.responseTime.value}</span>
          </li>
        </ul>
      </div>
    </div>

    <div class="footer__bar">
      <p class="footer__copy">© {year} {siteData.name}</p>
      <div class="footer__meta">
        <button
          type="button"
          class="footer__pill"
          data-motion-toggle
          aria-pressed="false"
        >
          <Icon name="mdi:motion-play-outline" aria-hidden="true" />
          <span data-motion-label>Motion off</span>
        </button>
        <button type="button" class="footer__pill" data-consent-reopen>Cookie settings</button>
        <a href="#main" class="footer__pill footer__top">
          Back to top
          <Icon name="mdi:arrow-up" aria-hidden="true" />
        </a>
      </div>
    </div>
  </div>
</footer>
