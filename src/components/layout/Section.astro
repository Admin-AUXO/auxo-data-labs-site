---
interface Props {
  as?: "section" | "div" | "footer";
  id?: string;
  padding?: "sm" | "md" | "lg" | "xl";
  background?: "default" | "surface" | "raised" | "sunken" | "accent" | "ink";
  width?: "prose" | "4xl" | "5xl" | "6xl" | "7xl" | "full";
  class?: string;
  containerClass?: string;
}

const {
  as = "section",
  id,
  padding = "md",
  background = "default",
  width = "7xl",
  class: className = "",
  containerClass = "",
} = Astro.props;

const Tag = as;
---

<Tag
  id={id}
  class={`section ${className}`.trim()}
  data-pad={padding}
  data-bg={background === "default" ? undefined : background}
>
  <slot name="bg" />
  <div class={`section__container ${containerClass}`.trim()} data-w={width}>
    <slot />
  </div>
</Tag>
