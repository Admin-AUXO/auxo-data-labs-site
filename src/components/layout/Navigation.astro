---
import { Icon } from "astro-icon/components";
import Logo from "./Logo.astro";
import SocialLinks from "./SocialLinks.astro";
import Dialog from "../ui/Dialog.astro";
import { navigationContent } from "../../data/navigation";
import { siteData } from "../../data/site";
import { withBase } from "../../lib/url";

const { items, cta } = navigationContent;
const here = Astro.url.pathname;
const isActive = (href: string) => {
  const target = withBase(href);
  return here === target || (href !== "/" && here.startsWith(target));
};
---

<header class="nav" data-nav data-pagefind-ignore>
  <div class="nav__inner">
    <Logo responsive />

    <nav class="nav__links" aria-label="Primary">
      {
        items.map((item) => (
          <a
            href={withBase(item.href)}
            class="nav__link"
            aria-current={isActive(item.href) ? "page" : undefined}
          >
            {item.name}
          </a>
        ))
      }
    </nav>

    <div class="nav__actions">
      <button type="button" class="icon-btn" data-dialog-open="site-search" data-search-open aria-label="Search the site">
        <Icon name="mdi:magnify" aria-hidden="true" />
      </button>
      <a href={withBase(cta.href)} class="btn nav__cta" data-variant="primary" data-size="sm">
        {cta.label}
      </a>
      <button type="button" class="icon-btn nav__burger" data-dialog-open="mobile-nav" aria-label="Open menu">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <line x1="3" y1="7" x2="21" y2="7"></line>
          <line x1="3" y1="17" x2="21" y2="17"></line>
        </svg>
      </button>
    </div>
  </div>
</header>

<Dialog id="mobile-nav" title="Menu" size="full" class="mobile-nav">
  <nav class="mobile-nav__links" aria-label="Mobile">
    {
      items.map((item) => (
        <a
          href={withBase(item.href)}
          class="mobile-nav__link"
          aria-current={isActive(item.href) ? "page" : undefined}
          data-dialog-close
        >
          <span>{item.name}</span>
          <Icon name="mdi:arrow-right" class="mobile-nav__link-icon" aria-hidden="true" />
        </a>
      ))
    }
  </nav>

  <div class="mobile-nav__foot">
    <a href={withBase(cta.href)} class="btn mobile-nav__cta" data-variant="primary" data-size="lg" data-dialog-close>
      {cta.label}
    </a>
    <div class="mobile-nav__meta">
      <a href={`mailto:${siteData.email}`} class="mobile-nav__email">{siteData.email}</a>
      <SocialLinks />
    </div>
  </div>
</Dialog>

<Dialog id="site-search" title="Search" size="lg" class="search-dialog">
  <div id="pagefind-search" class="search-dialog__ui" data-search-status="idle">
    <p class="search-dialog__loading" hidden>Loading search…</p>
  </div>
  <p class="search-dialog__hint">Search insights and pages across the site.</p>
</Dialog>

<script>
  const PAGEFIND_BASE = import.meta.env.BASE_URL.replace(/\/$/, "");
  let prefetched = false;
  let initPromise: Promise<void> | null = null;

  function prefetchSearch() {
    if (prefetched) return;
    prefetched = true;
    const css = document.createElement("link");
    css.rel = "stylesheet";
    css.href = `${PAGEFIND_BASE}/pagefind/pagefind-ui.css`;
    document.head.appendChild(css);
    const js = document.createElement("link");
    js.rel = "prefetch";
    js.as = "script";
    js.href = `${PAGEFIND_BASE}/pagefind/pagefind-ui.js`;
    document.head.appendChild(js);
  }

  function setStatus(status: string) {
    const el = document.getElementById("pagefind-search");
    if (!el) return;
    el.dataset.searchStatus = status;
    const loading = el.querySelector<HTMLElement>(".search-dialog__loading");
    if (loading) loading.hidden = status !== "loading";
  }

  function loadSearch() {
    if (initPromise) return initPromise;
    prefetchSearch();
    setStatus("loading");
    initPromise = (async () => {
      try {
        await new Promise<void>((resolve, reject) => {
          const s = document.createElement("script");
          s.src = `${PAGEFIND_BASE}/pagefind/pagefind-ui.js`;
          s.onload = () => resolve();
          s.onerror = () => reject(new Error("pagefind"));
          document.head.appendChild(s);
        });
        const w = window as unknown as { PagefindUI?: new (o: unknown) => void };
        if (w.PagefindUI) {
          new w.PagefindUI({
            element: "#pagefind-search",
            bundlePath: `${PAGEFIND_BASE}/pagefind/`,
            showSubResults: true,
            showImages: false,
            resetStyles: false,
            translations: { placeholder: "Search AUXO…" },
          });
        }
        setStatus("ready");
      } catch {
        const el = document.getElementById("pagefind-search");
        if (el) el.textContent = "Search is available on the published site.";
        setStatus("error");
        initPromise = null;
      }
    })();
    return initPromise;
  }

  function bind() {
    document.querySelectorAll<HTMLElement>("[data-search-open]").forEach((btn) => {
      if (btn.dataset.searchBound) return;
      btn.dataset.searchBound = "true";
      btn.addEventListener("pointerenter", prefetchSearch);
      btn.addEventListener("mouseenter", prefetchSearch);
      btn.addEventListener("focus", prefetchSearch);
      btn.addEventListener("click", loadSearch);
    });
  }

  bind();
  document.addEventListener("astro:page-load", bind);
</script>
