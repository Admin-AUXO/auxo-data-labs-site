---
import { siteData } from "../../data/site";
import { withBase } from "../../lib/url";

interface Props {
  title?: string;
  description?: string;
  path?: string;
  ogImage?: string;
  type?: "website" | "article";
  publishedTime?: string;
  modifiedTime?: string;
  noindex?: boolean;
}

const {
  title,
  description = siteData.description,
  path = Astro.url.pathname,
  ogImage,
  type = "website",
  publishedTime,
  modifiedTime,
  noindex = false,
} = Astro.props;

const fullTitle = title ? `${title} | ${siteData.name}` : `${siteData.name} — ${siteData.tagline}`;
const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
const relPath = path.startsWith(basePath) ? path.slice(basePath.length) || "/" : path;
const canonical = new URL(path, siteData.url).href;
const ogSlug = relPath === "/" ? "index" : relPath.replace(/^\/+|\/+$/g, "").replace(/\//g, "-");
const ogImageUrl = new URL(withBase(ogImage ?? `/og/${ogSlug}.png`), siteData.url).href;
const robots = noindex
  ? "noindex, nofollow"
  : "index, follow, max-image-preview:large, max-snippet:-1";
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={siteData.author} />
<link rel="canonical" href={canonical} />
<meta name="robots" content={robots} />

<meta name="color-scheme" content="dark" />
<meta name="theme-color" content="#0d0d0d" />

<link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />

<link rel="icon" href={withBase("/favicon.svg")} type="image/svg+xml" />
<link rel="apple-touch-icon" href={withBase("/apple-touch-icon.svg")} />
<link rel="manifest" href={withBase("/manifest.json")} />

<link rel="preload" href={withBase("/fonts/Sora-Variable.woff2")} as="font" type="font/woff2" crossorigin />
<link
  rel="preload"
  href={withBase("/fonts/PlusJakartaSans-VariableFont_wght.woff2")}
  as="font"
  type="font/woff2"
  crossorigin
/>

<meta property="og:type" content={type} />
<meta property="og:site_name" content={siteData.name} />
<meta property="og:locale" content="en_US" />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageUrl} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@AuxoData" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />

{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
