---
interface Props {
  class?: string;
}

const { class: cls = "" } = Astro.props;
---

<div class={`particle-field ${cls}`.trim()} aria-hidden="true">
  <canvas data-particle-field class="particle-field__canvas"></canvas>
</div>

<style>
  .particle-field {
    -webkit-mask: radial-gradient(125% 100% at 50% 0%, #000 35%, transparent 78%);
    mask: radial-gradient(125% 100% at 50% 0%, #000 35%, transparent 78%);
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    position: absolute;
    z-index: var(--z-base);
  }

  .particle-field__canvas {
    --field-color: var(--accent);
    block-size: 100%;
    display: block;
    inline-size: 100%;
    opacity: 0.7;
  }
</style>

<script>
  import { initParticleField } from "../../scripts/effects/particle-field";
  initParticleField();
  document.addEventListener("astro:page-load", initParticleField);
</script>
