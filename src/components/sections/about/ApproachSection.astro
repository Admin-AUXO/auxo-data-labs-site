---
import Section from "../../layout/Section.astro";
import SectionHeader from "../../ui/SectionHeader.astro";
import Card from "../../ui/Card.astro";
import HighlightText from "../../ui/HighlightText.astro";
import type { AboutContent } from "../../../data/about";

interface Props {
  content: AboutContent["approach"];
}

const { content } = Astro.props;
---

<Section id="approach" padding="lg" background="surface" decoration="grid">
  <SectionHeader title={content.title} />
  <p class="mx-auto mt-4 max-w-3xl text-center text-lg text-muted">
    <HighlightText text={content.description} highlight={content.descriptionHighlight} />
  </p>
  <div class="mt-12 grid gap-5 md:grid-cols-2">
    {
      content.principles.map((principle) => (
        <Card class="flex flex-col gap-4">
          <span class="flex size-12 shrink-0 items-center justify-center rounded-xl border border-border bg-surface-sunken text-xl font-bold text-accent">
            {principle.letter}
          </span>
          <div>
            <h3 class="card__title">{principle.title}</h3>
            <p class="card__desc">
              <HighlightText
                text={principle.description}
                highlight={principle.descriptionHighlight}
              />
            </p>
          </div>
        </Card>
      ))
    }
  </div>
</Section>
