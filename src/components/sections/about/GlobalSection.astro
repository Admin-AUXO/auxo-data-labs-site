---
import Section from "../../layout/Section.astro";
import SectionHeader from "../../ui/SectionHeader.astro";
import HighlightText from "../../ui/HighlightText.astro";
import type { AboutContent } from "../../../data/about";

interface Props {
  content: AboutContent["global"];
}

const { content } = Astro.props;
---

<Section padding="lg" background="surface" width="5xl">
  <SectionHeader title={content.title} />
  <p class="mx-auto mt-5 max-w-3xl text-center text-lg text-muted">
    <HighlightText text={content.description} highlight={content.descriptionHighlight} />
  </p>
</Section>
