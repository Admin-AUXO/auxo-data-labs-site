---
import Section from "../../layout/Section.astro";
import SectionHeader from "../../ui/SectionHeader.astro";
import Card from "../../ui/Card.astro";
import HighlightText from "../../ui/HighlightText.astro";
import type { AboutContent } from "../../../data/about";

interface Props {
  content: AboutContent["partnership"];
}

const { content } = Astro.props;
---

<Section padding="lg">
  <SectionHeader title={content.title} />
  <p class="mx-auto mt-4 max-w-3xl text-center text-lg text-muted">
    <HighlightText text={content.description} highlight={content.descriptionHighlight} />
  </p>
  <div class="mt-12 grid gap-5 md:grid-cols-3">
    {
      content.commitments.map((commitment) => (
        <Card icon={commitment.icon} title={commitment.title} description={commitment.description} />
      ))
    }
  </div>
</Section>
