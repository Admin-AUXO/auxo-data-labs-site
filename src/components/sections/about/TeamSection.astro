---
import { Icon } from "astro-icon/components";
import Section from "../../layout/Section.astro";
import SectionHeader from "../../ui/SectionHeader.astro";
import Card from "../../ui/Card.astro";
import type { AboutContent } from "../../../data/about";

interface Props {
  content: AboutContent["team"];
}

const { content } = Astro.props;
---

<Section padding="lg" background="surface">
  <SectionHeader title={content.title} subtitle={content.description} />
  <div class="mt-12 grid gap-5 md:grid-cols-3">
    {
      content.profiles.map((profile) => (
        <Card class="flex flex-col gap-4">
          <div class="flex items-center gap-3">
            <span class="icon-badge"><Icon name={profile.icon} aria-hidden="true" /></span>
            <p class="text-sm font-semibold text-accent">{profile.focus}</p>
          </div>
          <div>
            <h3 class="card__title">{profile.title}</h3>
            <p class="card__desc">{profile.description}</p>
          </div>
        </Card>
      ))
    }
  </div>
  <p class="mx-auto mt-8 max-w-2xl text-center text-sm text-subtle">{content.note}</p>
</Section>
