---
import Section from "../../layout/Section.astro";
import SectionHeader from "../../ui/SectionHeader.astro";
import HighlightText from "../../ui/HighlightText.astro";
import type { AboutContent } from "../../../data/about";

interface Props {
  content: AboutContent["mission"];
}

const { content } = Astro.props;
---

<Section padding="lg">
  <SectionHeader title={content.title} />
  <div class="mt-12 grid gap-5 md:grid-cols-2">
    <div class="rounded-2xl border border-border bg-surface p-8">
      <p class="text-sm font-semibold uppercase tracking-[0.14em] text-accent">Mission</p>
      <p class="mt-4 text-lg text-muted">
        <HighlightText text={content.missionText} highlight={content.missionHighlight} />
      </p>
    </div>
    <div class="rounded-2xl border border-border bg-surface p-8">
      <p class="text-sm font-semibold uppercase tracking-[0.14em] text-accent">Vision</p>
      <p class="mt-4 text-lg text-muted">
        <HighlightText text={content.visionText} highlight={content.visionHighlight} />
      </p>
    </div>
  </div>
</Section>
