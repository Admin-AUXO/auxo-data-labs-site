---
import Section from "../../layout/Section.astro";
import type { HomepageContent } from "../../../data/home";

interface Props {
  content: HomepageContent["valueProposition"];
}

const { content } = Astro.props;
---

<Section padding="lg" width="5xl" class="text-center">
  <p class="text-2xl font-medium leading-snug text-muted sm:text-3xl">{content.line1}</p>
  <p class="mt-6 text-2xl font-semibold leading-snug sm:text-3xl">{content.line2}</p>
</Section>
