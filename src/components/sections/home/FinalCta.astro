---
import Section from "../../layout/Section.astro";
import Button from "../../ui/Button.astro";
import HighlightText from "../../ui/HighlightText.astro";
import type { HomepageContent } from "../../../data/home";

interface Props {
  content: HomepageContent["finalCta"];
}

const { content } = Astro.props;
---

<Section padding="lg" width="5xl">
  <div class="relative overflow-hidden rounded-2xl border border-border bg-surface p-8 text-center sm:p-12">
    <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">{content.title}</h2>
    <p class="mx-auto mt-5 max-w-2xl text-lg text-muted">
      <HighlightText text={content.body} highlight={content.bodyHighlight} />
    </p>
    <div class="mt-8 flex justify-center">
      <Button variant="primary" href={content.ctaHref} icon>{content.ctaText}</Button>
    </div>
    <p class="mt-4 text-sm text-subtle">{content.reassuranceLine}</p>
  </div>
</Section>
