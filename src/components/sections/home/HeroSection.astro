---
import Section from "../../layout/Section.astro";
import Button from "../../ui/Button.astro";
import HighlightText from "../../ui/HighlightText.astro";
import type { HomepageContent } from "../../../data/home";

interface Props {
  hero: HomepageContent["hero"];
}

const { hero } = Astro.props;
---

<Section padding="xl" decoration="aurora" width="6xl" class="text-center">
  <h1 class="mx-auto max-w-4xl text-5xl font-bold leading-[1.05] tracking-tight">
    <HighlightText
      text={`${hero.title} ${hero.titleHighlight}`}
      highlight={hero.titleHighlight}
      class="text-gradient-accent"
    />
  </h1>
  <p class="mx-auto mt-6 max-w-2xl text-lg text-muted">
    <HighlightText text={hero.subtitle} highlight={hero.subtitleHighlight} />
  </p>
  <div class="mt-9 flex justify-center">
    <Button variant="primary" href={hero.primaryCta.href} icon>{hero.primaryCta.text}</Button>
  </div>
</Section>
