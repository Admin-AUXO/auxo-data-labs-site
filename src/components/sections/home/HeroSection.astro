---
import Section from "../../layout/Section.astro";
import Button from "../../ui/Button.astro";
import HighlightText from "../../ui/HighlightText.astro";
import type { HomepageContent } from "../../../data/home";

interface Props {
  hero: HomepageContent["hero"];
}

const { hero } = Astro.props;
---

<Section padding="xl" decoration="glow" width="6xl" class="text-center">
  <p class="text-sm font-semibold uppercase tracking-[0.18em] text-accent">{hero.scrollIndicator}</p>
  <h1 class="mx-auto mt-5 max-w-4xl text-4xl font-bold leading-[1.05] tracking-tight sm:text-5xl">
    <HighlightText text={`${hero.title} ${hero.titleHighlight}`} highlight={hero.titleHighlight} />
  </h1>
  <p class="mx-auto mt-6 max-w-2xl text-lg text-muted">
    <HighlightText text={hero.subtitle} highlight={hero.subtitleHighlight} />
  </p>
  <div class="mt-8 flex justify-center">
    <Button variant="primary" href={hero.primaryCta.href} icon>{hero.primaryCta.text}</Button>
  </div>
  <ul class="mx-auto mt-10 flex max-w-3xl flex-wrap justify-center gap-2.5">
    {
      hero.proofPoints.map((p) => (
        <li class="rounded-full border border-border bg-surface px-4 py-2 text-sm text-muted">{p}</li>
      ))
    }
  </ul>
</Section>
