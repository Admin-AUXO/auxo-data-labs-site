---
import { Icon } from "astro-icon/components";
import Section from "../../layout/Section.astro";
import Button from "../../ui/Button.astro";
import HighlightText from "../../ui/HighlightText.astro";
import type { ServicePageDetail } from "../../../data/services";

interface Props {
  category: ServicePageDetail["category"];
  hero: ServicePageDetail["hero"];
}

const { category, hero } = Astro.props;
---

<Section padding="xl" decoration="glow" width="6xl" class="text-center">
  <p class="text-sm font-semibold uppercase tracking-[0.18em] text-accent">{category}</p>
  <h1 class="mx-auto mt-5 max-w-4xl text-4xl font-bold leading-[1.05] tracking-tight sm:text-5xl">
    {hero.title}
  </h1>
  <p class="mx-auto mt-6 max-w-2xl text-lg text-muted">
    <HighlightText text={hero.description} highlight={hero.descriptionHighlight} />
  </p>
  <div class="mt-8 flex justify-center">
    <Button variant="primary" calendar icon>Book a call</Button>
  </div>
  <ul class="mx-auto mt-10 grid max-w-3xl gap-3 text-left sm:grid-cols-2">
    {
      hero.keyBenefits.map((benefit) => (
        <li class="flex items-start gap-3 rounded-lg border border-border bg-surface px-4 py-3 text-sm text-muted">
          <Icon
            name="mdi:check-circle-outline"
            class="mt-0.5 shrink-0 text-base text-accent"
            aria-hidden="true"
          />
          <span>{benefit}</span>
        </li>
      ))
    }
  </ul>
</Section>
