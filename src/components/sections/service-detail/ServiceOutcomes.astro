---
import { Icon } from "astro-icon/components";
import Section from "../../layout/Section.astro";
import SectionHeader from "../../ui/SectionHeader.astro";
import Card from "../../ui/Card.astro";
import HighlightText from "../../ui/HighlightText.astro";
import type { ServicePageDetail } from "../../../data/services";

interface Props {
  outcomes: ServicePageDetail["outcomes"];
}

const { outcomes } = Astro.props;
---

<Section padding="lg" background="surface">
  <SectionHeader
    title={outcomes.title}
    subtitle={outcomes.description}
    highlight={outcomes.descriptionHighlight}
  />
  <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
    {
      outcomes.metrics.map((metric) => (
        <Card class="flex flex-col gap-2">
          <span class="card__icon">
            <Icon name={metric.icon} aria-hidden="true" />
          </span>
          <p class="card__metric text-2xl">{metric.value}</p>
          <h3 class="font-semibold">{metric.label}</h3>
          <p class="text-sm text-muted">{metric.description}</p>
        </Card>
      ))
    }
  </div>
  <p class="mx-auto mt-10 max-w-3xl text-center text-sm text-subtle">{outcomes.note}</p>
</Section>
