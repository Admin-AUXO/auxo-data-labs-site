---
import { Icon } from "astro-icon/components";
import Section from "../../layout/Section.astro";
import SectionHeader from "../../ui/SectionHeader.astro";
import Card from "../../ui/Card.astro";
import HighlightText from "../../ui/HighlightText.astro";
import type { ServicePageDetail } from "../../../data/services";

interface Props {
  process: ServicePageDetail["process"];
}

const { process } = Astro.props;
---

<Section padding="lg" decoration="grid">
  <SectionHeader
    title={process.title}
    subtitle={process.description}
    highlight={process.descriptionHighlight}
  />
  <div class="mt-12 grid gap-5 md:grid-cols-2">
    {
      process.steps.map((step) => (
        <Card class="flex flex-col gap-3">
          <div class="flex items-center justify-between">
            <span class="icon-badge font-bold">
              {String(step.step).padStart(2, "0")}
            </span>
            <span class="text-xs font-semibold uppercase tracking-[0.1em] text-subtle">
              Step {step.step}
            </span>
          </div>
          <h3 class="card__title">{step.title}</h3>
          <p class="text-sm text-muted">{step.description}</p>
          <div class="mt-auto border-t border-border pt-4">
            <p class="text-xs font-semibold uppercase tracking-[0.1em] text-subtle">Deliverables</p>
            <ul class="mt-2 grid gap-2 sm:grid-cols-2">
              {step.deliverables.map((item) => (
                <li class="flex items-start gap-2 text-sm text-muted">
                  <Icon
                    name="mdi:check-circle-outline"
                    class="mt-0.5 shrink-0 text-base text-accent"
                    aria-hidden="true"
                  />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </Card>
      ))
    }
  </div>
</Section>
