---
import { Icon } from "astro-icon/components";
import Section from "../../layout/Section.astro";
import Card from "../../ui/Card.astro";
import type { ServicePageDetail } from "../../../data/services";

interface Props {
  snapshot: ServicePageDetail["snapshot"];
}

const { snapshot } = Astro.props;
---

<Section padding="lg" background="surface">
  <div class="grid gap-6 lg:grid-cols-2">
    <Card class="flex flex-col gap-5">
      <div>
        <span class="text-sm font-semibold uppercase tracking-[0.14em] text-accent">
          {snapshot.title}
        </span>
        <p class="card__desc mt-2 text-base">{snapshot.description}</p>
      </div>
      <dl class="grid gap-4 rounded-lg border border-border bg-surface-sunken p-4">
        {
          snapshot.details.map((detail) => (
            <div class="flex flex-col gap-1 sm:flex-row sm:gap-4">
              <dt class="shrink-0 text-xs font-semibold uppercase tracking-[0.1em] text-subtle sm:w-40">
                {detail.label}
              </dt>
              <dd class="text-sm text-muted">{detail.value}</dd>
            </div>
          ))
        }
      </dl>
    </Card>

    <Card class="flex flex-col gap-4">
      <h3 class="card__title">Signs this is the right fit</h3>
      <ul class="flex flex-col gap-3">
        {
          snapshot.triggers.map((trigger) => (
            <li class="flex items-start gap-3 text-sm text-muted">
              <Icon
                name="mdi:check-circle-outline"
                class="mt-0.5 shrink-0 text-base text-accent"
                aria-hidden="true"
              />
              <span>{trigger}</span>
            </li>
          ))
        }
      </ul>
    </Card>
  </div>
</Section>
