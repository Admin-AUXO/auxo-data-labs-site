---
import Section from "../../layout/Section.astro";
import SectionHeader from "../../ui/SectionHeader.astro";
import Accordion from "../../ui/Accordion.astro";
import type { ServicePageDetail } from "../../../data/services";

interface Props {
  faq: ServicePageDetail["faq"];
}

const { faq } = Astro.props;

const items = faq.items.map((item) => ({
  title: item.question,
  body: item.answer,
}));
---

<Section padding="lg" width="4xl">
  <SectionHeader title={faq.title} subtitle={faq.description} />
  <Accordion class="mt-12" items={items} openFirst />
</Section>
