---
import { Icon } from "astro-icon/components";
import Section from "../../layout/Section.astro";
import SectionHeader from "../../ui/SectionHeader.astro";
import Card from "../../ui/Card.astro";
import type { ServicePageDetail } from "../../../data/services";

interface Props {
  benefits: ServicePageDetail["benefits"];
}

const { benefits } = Astro.props;
---

<Section padding="lg" background="surface">
  <SectionHeader
    title={benefits.title}
    subtitle={benefits.description}
    highlight={benefits.descriptionHighlight}
  />
  <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
    {
      benefits.features.map((feature) => (
        <Card class="flex flex-col gap-3">
          <span class="card__icon">
            <Icon name={feature.icon} aria-hidden="true" />
          </span>
          <h3 class="card__title">{feature.title}</h3>
          <p class="card__desc">{feature.description}</p>
        </Card>
      ))
    }
  </div>
</Section>
