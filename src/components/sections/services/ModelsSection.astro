---
import { Icon } from "astro-icon/components";
import Section from "../../layout/Section.astro";
import SectionHeader from "../../ui/SectionHeader.astro";
import Card from "../../ui/Card.astro";
import HighlightText from "../../ui/HighlightText.astro";
import type { ServicesOverviewContent } from "../../../data/services-overview";

interface Props {
  content: ServicesOverviewContent["engagementModels"];
}

const { content } = Astro.props;
---

<Section id="models" padding="lg">
  <SectionHeader
    title={content.title}
    subtitle={content.description}
    highlight={content.descriptionHighlight}
  />
  <div class="mt-12 grid gap-6 lg:grid-cols-2">
    {
      content.models.map((model) => (
        <Card class="flex flex-col gap-5">
          <div>
            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
              <h3 class="card__title">{model.name}</h3>
              <span class="text-sm font-semibold text-accent">{model.commercialModel}</span>
            </div>
            <p class="mt-1 text-sm font-medium text-muted">{model.subheadline}</p>
            <p class="card__desc">
              <HighlightText text={model.description} highlight={model.descriptionHighlight} />
            </p>
          </div>

          <dl class="grid gap-4 rounded-lg border border-border bg-surface-sunken p-4 sm:grid-cols-2">
            <div>
              <dt class="text-xs font-semibold uppercase tracking-[0.1em] text-subtle">Best for</dt>
              <dd class="mt-1 text-sm text-muted">
                <HighlightText text={model.bestFor} highlight={model.bestForHighlight} />
              </dd>
            </div>
            <div>
              <dt class="text-xs font-semibold uppercase tracking-[0.1em] text-subtle">
                Working rhythm
              </dt>
              <dd class="mt-1 text-sm text-muted">{model.workingRhythm}</dd>
            </div>
          </dl>

          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.1em] text-subtle">Deliverables</p>
            <ul class="mt-2 grid gap-2 sm:grid-cols-2">
              {model.deliverables.map((item) => (
                <li class="flex items-start gap-2 text-sm text-muted">
                  <Icon
                    name="mdi:check-circle-outline"
                    class="mt-0.5 shrink-0 text-base text-accent"
                    aria-hidden="true"
                  />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="mt-auto flex flex-wrap items-center justify-between gap-x-6 gap-y-2 border-t border-border pt-4">
            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.1em] text-subtle">Pricing</p>
              <p class="card__metric text-xl">{model.pricingRange}</p>
            </div>
            <div class="text-right">
              <p class="text-xs font-semibold uppercase tracking-[0.1em] text-subtle">
                Typical timeframe
              </p>
              <p class="mt-1 font-semibold">{model.typicalTimeframe}</p>
            </div>
          </div>
        </Card>
      ))
    }
  </div>
</Section>
