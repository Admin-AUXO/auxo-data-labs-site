---
import Section from "../../layout/Section.astro";
import SectionHeader from "../../ui/SectionHeader.astro";
import Card from "../../ui/Card.astro";
import type { ServicesOverviewContent } from "../../../data/services-overview";

interface Props {
  content: ServicesOverviewContent["chooser"];
}

const { content } = Astro.props;
---

<Section id="services-chooser" padding="lg" background="surface" decoration="grid">
  <SectionHeader title={content.title} subtitle={content.description} highlight="problem" />
  <div class="mt-12 grid gap-5 md:grid-cols-3">
    {
      content.tracks.map((track, i) => (
        <Card class="flex flex-col gap-4">
          <div>
            <span class="text-sm font-bold text-accent">{String(i + 1).padStart(2, "0")}</span>
            <h3 class="card__title mt-1">{track.name}</h3>
            <p class="card__desc">{track.summary}</p>
          </div>
          <ul class="flex flex-wrap gap-2">
            {track.services.map((service) => (
              <li class="rounded-full border border-border bg-surface-sunken px-3 py-1.5 text-sm text-muted">
                {service}
              </li>
            ))}
          </ul>
          <p class="mt-auto border-t border-border pt-4 text-sm font-medium text-accent">
            {track.outcome}
          </p>
        </Card>
      ))
    }
  </div>
</Section>
