---
import { Icon } from "astro-icon/components";
import Section from "../../layout/Section.astro";
import SectionHeader from "../../ui/SectionHeader.astro";
import Card from "../../ui/Card.astro";
import HighlightText from "../../ui/HighlightText.astro";
import type { ServicesOverviewContent } from "../../../data/services-overview";

interface Props {
  content: ServicesOverviewContent["industries"];
}

const { content } = Astro.props;
---

<Section padding="lg" background="surface">
  <SectionHeader
    title={content.title}
    subtitle={content.description}
    highlight={content.descriptionHighlight}
  />
  <div class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
    {
      content.industries.map((industry) => (
        <Card class="flex flex-col gap-2">
          <span class="card__icon">
            <Icon name={industry.icon} aria-hidden="true" />
          </span>
          <h3 class="card__title">{industry.name}</h3>
          <p class="card__desc">
            <HighlightText text={industry.description} highlight={industry.descriptionHighlight} />
          </p>
          <p class="mt-auto border-t border-border pt-3 text-sm text-subtle">
            <HighlightText text={industry.keyBenefit} highlight={industry.keyBenefitHighlight} />
          </p>
        </Card>
      ))
    }
  </div>
  <p class="mx-auto mt-10 max-w-3xl text-center text-lg text-muted">
    <HighlightText text={content.goal} highlight={content.goalHighlight} />
  </p>
</Section>
