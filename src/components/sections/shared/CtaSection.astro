---
import Section from "../../layout/Section.astro";
import Button from "../../ui/Button.astro";
import HighlightText from "../../ui/HighlightText.astro";

interface Props {
  eyebrow?: string;
  title: string;
  titleHighlight?: string | string[];
  description?: string;
  descriptionHighlight?: string | string[];
  ctaText: string;
  ctaHref: string;
  reassurance?: string;
  secondaryText?: string;
  secondaryHref?: string;
}

const {
  title,
  titleHighlight,
  description,
  descriptionHighlight,
  ctaText,
  ctaHref,
  reassurance,
  secondaryText,
  secondaryHref,
} = Astro.props;
---

<Section padding="lg" width="6xl">
  <div
    class="cta-card mx-auto flex max-w-3xl flex-col items-center gap-7 rounded-2xl border border-border bg-surface px-6 py-14 text-center sm:px-12 sm:py-16"
    style="box-shadow: var(--shadow-md);"
    data-reveal
  >
    <h2 class="text-display text-display--4xl" data-anim="blur-in">
      <HighlightText text={title} highlight={titleHighlight} />
    </h2>
    {
      description && (
        <p class="lead mx-auto text-balance">
          <HighlightText text={description} highlight={descriptionHighlight} />
        </p>
      )
    }
    <div class="flex w-full flex-col items-center justify-center gap-3 sm:w-auto sm:flex-row sm:flex-wrap">
      <Button variant="primary" size="lg" href={ctaHref} icon class="w-full sm:w-auto">{ctaText}</Button>
      {
        secondaryText && secondaryHref && (
          <Button variant="secondary" size="lg" href={secondaryHref} class="w-full sm:w-auto">
            {secondaryText}
          </Button>
        )
      }
    </div>
    {reassurance && <p class="text-sm text-subtle">{reassurance}</p>}
  </div>
</Section>

<style>
  .cta-card {
    isolation: isolate;
    overflow: hidden;
    position: relative;
  }

  .cta-card::before {
    background: linear-gradient(
      120deg,
      transparent 0%,
      color-mix(in oklab, var(--accent) 12%, transparent) 22%,
      transparent 48%,
      color-mix(in oklab, var(--accent-2) 12%, transparent) 74%,
      transparent 100%
    );
    background-size: 220% 220%;
    border-radius: inherit;
    content: "";
    inset: 0;
    opacity: 0.7;
    position: absolute;
    z-index: -1;
    animation: cta-sheen 18s ease-in-out infinite;
  }

  @keyframes cta-sheen {
    0% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
    100% {
      background-position: 0% 50%;
    }
  }

  html:not([data-motion="on"]) .cta-card::before {
    animation: none;
  }
</style>
