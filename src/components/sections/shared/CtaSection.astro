---
import Section from "../../layout/Section.astro";
import Button from "../../ui/Button.astro";
import HighlightText from "../../ui/HighlightText.astro";

interface Props {
  eyebrow?: string;
  title: string;
  titleHighlight?: string | string[];
  description?: string;
  descriptionHighlight?: string | string[];
  ctaText: string;
  ctaHref: string;
  reassurance?: string;
  secondaryText?: string;
  secondaryHref?: string;
}

const {
  title,
  titleHighlight,
  description,
  descriptionHighlight,
  ctaText,
  ctaHref,
  reassurance,
  secondaryText,
  secondaryHref,
} = Astro.props;
---
<Section padding="md" width="7xl">
  <div class="cta-band" data-reveal>
    <div class="cta-band__text">
      <h2 class="cta-band__title">
        <HighlightText text={title} highlight={titleHighlight} soften />
      </h2>
      {
        description && (
          <p class="cta-band__desc">
            <HighlightText text={description} highlight={descriptionHighlight} />
          </p>
        )
      }
    </div>
    <div class="cta-band__actions">
      <div class="flex w-full flex-col gap-3 sm:w-auto sm:flex-row sm:flex-wrap">
        <Button variant="primary" size="lg" href={ctaHref} icon class="w-full sm:w-auto">{ctaText}</Button>
        {
          secondaryText && secondaryHref && (
            <Button variant="secondary" size="lg" href={secondaryHref} class="w-full sm:w-auto">
              {secondaryText}
            </Button>
          )
        }
      </div>
      {reassurance && <p class="text-sm text-subtle">{reassurance}</p>}
    </div>
  </div>
</Section>

<style>
  .cta-band {
    display: grid;
    gap: 1.5rem 3rem;
    padding-block: clamp(2rem, 1.5rem + 1.5vw, 2.75rem);
  }

  @media (width >= 64rem) {
    .cta-band {
      align-items: center;
      grid-template-columns: minmax(0, 1fr) auto;
    }
  }

  .cta-band__text {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .cta-band__title {
    font-size: var(--text-3xl);
  }

  .cta-band__desc {
    color: var(--muted);
    font-size: var(--text-lg);
    line-height: 1.5;
    max-inline-size: 36rem;
  }

  .cta-band__actions {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  @media (width >= 64rem) {
    .cta-band__actions {
      align-items: flex-end;
    }
  }
</style>
