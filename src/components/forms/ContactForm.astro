---
import Button from "../ui/Button.astro";
import { contactContent } from "../../data/contact";

const { form } = contactContent;
---

<form id="contact-form" class="flex flex-col gap-5" novalidate>
  {
    form.fields.map((field) => {
      const errorId = `${field.name}-error`;
      const isMessage = field.type === "textarea";
      const counterId = isMessage ? `${field.name}-counter` : undefined;
      const describedBy = [errorId, counterId].filter(Boolean).join(" ");
      return (
        <div class="field">
          <div class={isMessage ? "field__head" : undefined}>
            <label class="field__label" for={field.name}>
              {field.label}
              {field.required && <span class="field__required" aria-hidden="true">*</span>}
              {field.optional && <span class="field__optional"> (optional)</span>}
            </label>
            {isMessage && (
              <span class="field__counter" id={counterId} data-counter={field.name} aria-live="polite">
                0/{field.maxLength}
              </span>
            )}
          </div>

          {field.type === "textarea" ? (
            <textarea
              id={field.name}
              name={field.name}
              class="textarea"
              placeholder={field.placeholder}
              maxlength={field.maxLength}
              required={field.required}
              aria-describedby={describedBy}
            />
          ) : field.type === "select" ? (
            <select id={field.name} name={field.name} class="select" aria-describedby={errorId}>
              {field.options?.map((option) => <option value={option}>{option}</option>)}
            </select>
          ) : (
            <input
              type={field.type}
              id={field.name}
              name={field.name}
              class="input"
              placeholder={field.placeholder}
              maxlength={field.maxLength}
              required={field.required}
              autocomplete={field.type === "email" ? "email" : field.name === "name" ? "name" : field.name === "company" ? "organization" : undefined}
              aria-describedby={errorId}
            />
          )}

          <p class="field__error" id={errorId} role="alert" />
        </div>
      );
    })
  }

  <div class="field-honeypot" aria-hidden="true">
    <label for="contact-company-url">Company URL (leave this field empty)</label>
    <input
      type="text"
      id="contact-company-url"
      name="company_url"
      data-honeypot
      tabindex="-1"
      autocomplete="off"
    />
  </div>

  <label class="field-consent">
    <input type="checkbox" name="consent" class="field-consent__checkbox" required />
    <span class="field-consent__text">{form.consentNote}</span>
  </label>

  <div class="form-status" role="status" aria-live="polite" />

  <Button type="submit" variant="primary" size="lg" icon iconName="mdi:send">
    {form.submitText}
  </Button>

  <p class="text-sm text-subtle">{form.note}</p>

  <noscript>
    <p class="text-sm text-subtle">
      This form needs JavaScript. You can email us directly and we'll reply within one business day.
    </p>
  </noscript>
</form>

<script>
  import { init } from "../../scripts/forms/contact";
  init();
  document.addEventListener("astro:page-load", init);
</script>

<style>
  .field-honeypot {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .field-consent {
    align-items: flex-start;
    color: var(--subtle);
    display: flex;
    font-size: var(--text-sm);
    gap: 0.6rem;
    line-height: 1.45;
  }

  .field-consent__checkbox {
    accent-color: var(--accent);
    block-size: 1.05rem;
    flex: none;
    inline-size: 1.05rem;
    margin-block-start: 0.15rem;
  }
</style>
