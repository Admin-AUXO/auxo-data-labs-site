---
import Button from "../ui/Button.astro";
import { contactContent } from "../../data/contact";

const { form } = contactContent;
---

<form id="contact-form" class="flex flex-col gap-5" novalidate>
  {
    form.fields.map((field) => {
      const errorId = `${field.name}-error`;
      const isMessage = field.type === "textarea";
      const counterId = isMessage ? `${field.name}-counter` : undefined;
      const describedBy = [errorId, counterId].filter(Boolean).join(" ");
      return (
        <div class="field">
          <div class={isMessage ? "field__head" : undefined}>
            <label class="field__label" for={field.name}>
              {field.label}
              {field.required && <span class="field__required" aria-hidden="true">*</span>}
              {field.optional && <span class="field__optional"> (optional)</span>}
            </label>
            {isMessage && (
              <span class="field__counter" id={counterId} data-counter={field.name} aria-live="polite">
                0/{field.maxLength}
              </span>
            )}
          </div>

          {field.type === "textarea" ? (
            <textarea
              id={field.name}
              name={field.name}
              class="textarea"
              placeholder={field.placeholder}
              maxlength={field.maxLength}
              required={field.required}
              aria-describedby={describedBy}
            />
          ) : field.type === "select" ? (
            <select id={field.name} name={field.name} class="select" aria-describedby={errorId}>
              {field.options?.map((option) => <option value={option}>{option}</option>)}
            </select>
          ) : (
            <input
              type={field.type}
              id={field.name}
              name={field.name}
              class="input"
              placeholder={field.placeholder}
              maxlength={field.maxLength}
              required={field.required}
              autocomplete={field.type === "email" ? "email" : field.name === "name" ? "name" : field.name === "company" ? "organization" : undefined}
              aria-describedby={errorId}
            />
          )}

          <p class="field__error" id={errorId} role="alert" />
        </div>
      );
    })
  }

  <div class="form-status" role="status" aria-live="polite" />

  <Button type="submit" variant="primary" size="lg" icon iconName="mdi:send">
    {form.submitText}
  </Button>

  <p class="text-sm text-subtle">{form.note}</p>
</form>

<script>
  import { init } from "../../scripts/forms/contact";
  init();
  document.addEventListener("astro:page-load", init);
</script>
