---
import { Icon } from "astro-icon/components";

interface Props {
  id: string;
  loop?: boolean;
  autoplay?: boolean;
  align?: "start" | "center" | "end";
  controls?: boolean;
  class?: string;
}

const {
  id,
  loop = true,
  autoplay = false,
  align = "start",
  controls = true,
  class: cls = "",
} = Astro.props;
---

<div
  id={id}
  class={`carousel ${cls}`.trim()}
  data-carousel
  data-loop={String(loop)}
  data-autoplay={String(autoplay)}
  data-align={align}
>
  <div class="carousel__viewport embla">
    <div class="carousel__track embla__container">
      <slot />
    </div>
  </div>
  {
    controls && (
      <div class="carousel__controls">
        <button type="button" class="carousel__btn" data-carousel-prev aria-label="Previous slide">
          <Icon name="mdi:arrow-left" aria-hidden="true" />
        </button>
        <button type="button" class="carousel__btn" data-carousel-next aria-label="Next slide">
          <Icon name="mdi:arrow-right" aria-hidden="true" />
        </button>
      </div>
    )
  }
</div>

<script>
  import { initCarousels } from "../../scripts/ui/carousel";
  initCarousels();
  document.addEventListener("astro:page-load", initCarousels);
</script>
