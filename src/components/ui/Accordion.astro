---
interface Item {
  title: string;
  body: string;
}

interface Props {
  items: Item[];
  single?: boolean;
  openFirst?: boolean;
  class?: string;
}

let accordionCounter = 0;
function nextAccordionId(): number {
  accordionCounter += 1;
  return accordionCounter;
}

const { items, single = true, openFirst = false, class: cls = "" } = Astro.props;
const accordionId = nextAccordionId();
const name = single ? `acc-${accordionId}` : undefined;
---

<div class={`accordion ${cls}`.trim()}>
  {
    items.map((it, i) => (
      <details class="accordion__item" name={name} open={openFirst && i === 0 ? true : undefined}>
        <summary class="accordion__summary">
          <span class="accordion__index" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
          <span class="accordion__question">{it.title}</span>
          <span class="accordion__toggle" aria-hidden="true"></span>
        </summary>
        <div class="accordion__content">
          <div class="accordion__content-inner" set:html={it.body} />
        </div>
      </details>
    ))
  }
</div>
