---
import { Icon } from "astro-icon/components";

interface Item {
  title: string;
  body: string;
}

interface Props {
  items: Item[];
  /** Exclusive (one open at a time) via native <details name>. */
  single?: boolean;
  openFirst?: boolean;
  class?: string;
}

const { items, single = true, openFirst = false, class: cls = "" } = Astro.props;
const name = single ? `acc-${Math.random().toString(36).slice(2, 9)}` : undefined;
---

<div class={`accordion ${cls}`.trim()}>
  {
    items.map((it, i) => (
      <details class="accordion__item" name={name} open={openFirst && i === 0 ? true : undefined}>
        <summary class="accordion__summary">
          <span>{it.title}</span>
          <Icon name="mdi:chevron-down" class="accordion__chevron" aria-hidden="true" />
        </summary>
        <div class="accordion__content">
          <div class="accordion__content-inner" set:html={it.body} />
        </div>
      </details>
    ))
  }
</div>
