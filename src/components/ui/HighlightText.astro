---
interface Props {
  text: string;
  highlight?: string | string[];
  soften?: boolean;
  class?: string;
}

const { text, highlight, soften = false, class: cls = "hl-accent" } = Astro.props;

const terms = (Array.isArray(highlight) ? highlight : highlight ? [highlight] : [])
  .map(String)
  .filter(Boolean);

type Part = { t: string; cls: string | null };

const mark = (segment: string, base: string | null): Part[] => {
  if (terms.length === 0) return [{ t: segment, cls: base }];
  const escaped = terms.map((t) => t.replace(/[.*+?^${}()|[\]\\]/g, "\\$&"));
  const re = new RegExp(`(${escaped.join("|")})`, "gi");
  const lower = new Set(terms.map((t) => t.toLowerCase()));
  return segment
    .split(re)
    .filter((s) => s !== "")
    .map((s) => ({ t: s, cls: lower.has(s.toLowerCase()) ? cls : base }));
};

const split = soften ? text.match(/^(.+?[.?!])(\s+)(\S.*)$/) : null;
const parts: Part[] = split
  ? [...mark(split[1], null), { t: split[2], cls: null }, ...mark(split[3], "tone-soft")]
  : mark(text, null);
---
{parts.map((p) => (p.cls ? <span class={p.cls}>{p.t}</span> : <Fragment>{p.t}</Fragment>))}
