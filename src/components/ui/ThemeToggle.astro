---
import { Icon } from "astro-icon/components";

interface Props {
  class?: string;
}

const { class: cls = "" } = Astro.props;
---

<button type="button" data-theme-toggle class={`theme-toggle ${cls}`.trim()} aria-label="Toggle color theme">
  <Icon name="mdi:white-balance-sunny" class="theme-toggle__sun" aria-hidden="true" />
  <Icon name="mdi:moon-waning-crescent" class="theme-toggle__moon" aria-hidden="true" />
</button>

<script>
  import { initTheme } from "../../scripts/core/theme";
  initTheme();
  document.addEventListener("astro:page-load", initTheme);
</script>
