---
import { Icon } from "astro-icon/components";
import { withBase } from "../../lib/url";

interface Props {
  variant?: "primary" | "secondary" | "outline" | "ghost";
  size?: "sm" | "md" | "lg";
  href?: string;
  target?: string;
  rel?: string;
  type?: "button" | "submit" | "reset";
  disabled?: boolean;
  calendar?: boolean;
  icon?: boolean;
  iconName?: string;
  class?: string;
  id?: string;
  ariaLabel?: string;
}

const {
  variant = "primary",
  size = "md",
  href,
  target,
  rel,
  type = "button",
  disabled = false,
  calendar = false,
  icon = false,
  iconName = "mdi:arrow-right",
  class: className = "",
  id,
  ariaLabel,
} = Astro.props;

const isLink = Boolean(href) && !calendar;
const Tag = isLink ? "a" : "button";

const tagProps = isLink
  ? {
      href: disabled || !href ? undefined : withBase(href),
      target,
      rel: target === "_blank" ? "noopener noreferrer" : rel,
      "aria-disabled": disabled ? "true" : undefined,
    }
  : {
      type,
      disabled,
      ...(calendar ? { "data-google-calendar-open": "" } : {}),
    };
---

<Tag
  id={id}
  class={`btn ${className}`.trim()}
  data-variant={variant}
  data-size={size}
  aria-label={ariaLabel}
  {...tagProps}
>
  <slot />
  {icon && <Icon name={iconName} class="btn__icon" aria-hidden="true" />}
</Tag>
