---
import HighlightText from "./HighlightText.astro";

interface Props {
  title: string;
  eyebrow?: string;
  subtitle?: string;
  highlight?: string | string[];
  align?: "left" | "center";
  class?: string;
}

const {
  title,
  eyebrow,
  subtitle,
  highlight,
  align = "left",
  class: className = "",
} = Astro.props;

const wrap =
  align === "center"
    ? "items-center text-center mx-auto max-w-2xl"
    : "items-start text-left max-w-3xl";
---
<div class={`flex flex-col gap-3 ${wrap} ${className}`.trim()} data-reveal>
  {eyebrow && <p class="section-index">{eyebrow}</p>}
  <h2 class="text-4xl" data-anim="clip-up">
    <HighlightText text={title} highlight={highlight} soften />
  </h2>
  {subtitle && <p class="lead max-w-2xl text-lg text-balance">{subtitle}</p>}
</div>
