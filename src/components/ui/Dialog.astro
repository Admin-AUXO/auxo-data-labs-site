---
import { Icon } from "astro-icon/components";

interface Props {
  id: string;
  title?: string;
  size?: "md" | "lg" | "full";
  class?: string;
}

const { id, title, size = "md", class: cls = "" } = Astro.props;
---

<dialog
  id={id}
  class={`dialog ${cls}`.trim()}
  data-size={size}
  aria-labelledby={title ? `${id}-title` : undefined}
>
  <div class="dialog__panel">
    <header class="dialog__header">
      {title ? <h2 id={`${id}-title`} class="dialog__title">{title}</h2> : <span></span>}
      <button type="button" class="dialog__close" data-dialog-close aria-label="Close dialog">
        <Icon name="mdi:close" aria-hidden="true" />
      </button>
    </header>
    <div class="dialog__body"><slot /></div>
  </div>
</dialog>

<script>
  import { initDialogs } from "../../scripts/ui/dialog";
  initDialogs();
  document.addEventListener("astro:page-load", initDialogs);
</script>
