---
import { footnotes } from "../../data/footnotes";
---

<ol class="fn-list" aria-label="Footnotes">
  {
    footnotes.map((f, i) => (
      <li id={f.id} class="fn-list__item">
        <a href={`#${f.id}-ref`} class="fn-list__back" aria-label={`Back to reference ${i + 1}`}>
          {f.marker}
        </a>
        <p>
          {f.text} <cite>{f.source}</cite>
        </p>
      </li>
    ))
  }
</ol>

<style>
  .fn-list {
    color: var(--subtle);
    display: grid;
    font-size: var(--text-xs, 0.75rem);
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .fn-list__item {
    display: flex;
    gap: 0.25rem;
    scroll-margin-top: 6rem;
  }

  .fn-list__item:target p {
    color: var(--foreground);
  }

  .fn-list__back {
    align-items: center;
    color: var(--muted);
    display: inline-flex;
    flex-shrink: 0;
    justify-content: center;
    margin-block: -0.75rem;
    min-block-size: 44px;
    min-inline-size: 44px;
    margin-inline-start: -0.9rem;
    text-decoration: none;
  }

  .fn-list cite {
    font-style: italic;
  }
</style>
