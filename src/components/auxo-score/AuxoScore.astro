---
import ExtendedGate from "./ExtendedGate.astro";
import { DIMENSIONS, IDK_LIMIT } from "../../lib/auxo-score/scoring";
import { CARDS } from "../../lib/auxo-score/cards";
import { LOAD_STEPS, SCORE_COPY } from "./copy";
import "../../styles/pages/auxo-score.css";

const { intro, result, inconclusive } = SCORE_COPY;
const { deeper, reviewCall } = result;
---
<div
  class="score"
  data-auxo-score
  data-report-url={import.meta.env.PUBLIC_N8N_REPORT_WEBHOOK ?? ""}
  data-extended-url={import.meta.env.PUBLIC_N8N_EXTENDED_WEBHOOK ?? ""}
>
  <section class="score__screen" id="s-intro" data-screen="intro">
    <span class="score__eyebrow">
      <span data-path="default">{intro.default.eyebrow}</span>
      <span data-path="startup" hidden>{intro.startup.eyebrow}</span>
    </span>
    <h1 class="score__h1" tabindex="-1">
      <span data-path="default">{intro.default.title}</span>
      <span data-path="startup" hidden>{intro.startup.title}</span>
    </h1>
    <p class="score__lede">
      <span data-path="default">{intro.default.lede(CARDS.length)}</span>
      <span data-path="startup" hidden>{intro.startup.lede}</span>
    </p>
    <ul class="score__dims" aria-label={intro.dimensionsLabel} data-path="default">
      {DIMENSIONS.map((d) => <li>{d}</li>)}
    </ul>
    <ol class="score__steps" aria-label={intro.startup.stepsLabel} data-path="startup" hidden>
      {
        intro.startup.steps.map((step, i) => (
          <li>
            <span class="score__step-num" aria-hidden="true">{i + 1}</span>
            <span>{step}</span>
          </li>
        ))
      }
    </ol>
    <p class="score__eligibility" data-path="startup" hidden>{intro.startup.eligibility}</p>
    <script is:inline>
      (function () {
        var s = document.currentScript;
        var root = s && s.closest("[data-auxo-score]");
        if (!root) return;
        var offer = "free-audit";
        var on = false;
        try {
          on =
            new URLSearchParams(location.search).get("offer") === offer ||
            JSON.parse(sessionStorage.getItem("auxo-score-offer") || "null") === offer;
        } catch (e) {
          on = false;
        }
        if (!on) return;
        root.dataset.offer = offer;
        root.querySelectorAll("[data-path]").forEach(function (n) {
          n.hidden = n.dataset.path !== "startup";
        });
      })();
    </script>
    <div class="score__facts">
      <div><b>{CARDS.length}</b><small>{intro.facts.rounds}</small></div>
      <div><b>~3</b><small>{intro.facts.minutes}</small></div>
      <div><b>/100</b><small>{intro.facts.score}</small></div>
    </div>
    <div class="score__resume" id="resumeBar" hidden>
      <p id="resumeText">{intro.resume(1, CARDS.length)}</p>
      <div class="score__btn-row">
        <button class="score__btn" type="button" id="resumeBtn">{intro.resumeButton}</button>
        <button class="score__btn score__btn--ghost" type="button" id="startOverBtn">{intro.startOverButton}</button>
      </div>
    </div>
    <div class="score__btn-row">
      <button class="score__btn" type="button" id="startBtn">{intro.startButton}</button>
    </div>
    <p class="score__note">{intro.note(IDK_LIMIT)}</p>
    <p class="score__privacy">{intro.privacy}</p>
  </section>

  <section class="score__screen" id="s-quiz" data-screen="quiz" data-pagefind-ignore="all" hidden>
    <div class="score__qhead">
      <button class="score__back" id="backBtn" type="button">← Back</button>
      <span class="score__pill" id="dimPill">ACCURATE</span>
      <span class="score__count" id="count">1 / {CARDS.length}</span>
    </div>
    <div class="score__bar" aria-hidden="true"><i id="progress"></i></div>
    <h2 class="score__question" id="question" aria-live="polite" tabindex="-1">{CARDS[0].question}</h2>
    <div class="score__grid" id="grid" role="group" aria-label="Answer options"></div>
    <div class="score__qfoot">
      <button class="score__idk" id="idkBtn" type="button" aria-pressed="false">I don't know</button>
      <button class="score__keep" id="keepBtn" type="button" hidden>Keep and continue →</button>
      <span class="score__hint">Keys: A · U · X · O · I for "I don't know"</span>
    </div>
  </section>

  <section class="score__screen" id="s-loader" data-screen="loader" data-pagefind-ignore="all" hidden>
    <div class="score__loader">
      <div class="score__cube" aria-hidden="true"><span>A</span><span>U</span><span>X</span><span>O</span></div>
      <h2 class="score__loadmsg" id="loadmsg" aria-live="polite" tabindex="-1">{LOAD_STEPS[0]}</h2>
    </div>
  </section>

  <section class="score__screen" id="s-result" data-screen="result" data-pagefind-ignore="all" hidden>
    <span class="score__eyebrow">Your AUXO Score</span>
    <div class="score__head">
      <h2 class="score__big" id="bigScore" tabindex="-1">0<small>/100</small></h2>
      <div class="score__band">
        <span class="score__chip" id="bandChip">Stable</span>
        <p class="score__band-line" id="bandLine"></p>
      </div>
    </div>
    <div class="score__panel">
      <p class="score__panel-title">Score by area, out of 100</p>
      <svg class="score__radar" id="radar" viewBox="0 0 360 330" role="img" aria-label="Radar chart of the five dimension scores"></svg>
      <table class="score__table" id="dimTable"></table>
      <ul class="score__legend" aria-label="Colour key">
        <li data-tone="ok">60+ solid</li>
        <li data-tone="warn">40–59 needs work</li>
        <li data-tone="crit">Under 40 at risk</li>
      </ul>
    </div>
    <div class="score__focus" id="focus"></div>
    <div class="score__gaps" id="gaps" hidden></div>

    <div class="score__cta">
      <button class="score__btn score__btn--full" type="button" id="emailBtn" aria-expanded="false" aria-controls="emailForm">
        Email my full report
      </button>
      <p class="score__note score__note--center">Includes a step-by-step plan for your weakest areas.</p>
      <form class="score__mail" id="emailForm" novalidate hidden>
        <label for="emailInput">Work email</label>
        <div class="score__mail-row">
          <input id="emailInput" name="email" type="email" autocomplete="email" placeholder="name@company.com" required />
          <button class="score__btn" type="submit">Send</button>
        </div>
        <input class="score__hp" type="text" name="company_website" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <p class="score__consent">
          We'll email your report and may follow up once. No spam. <a href="/legal/privacy-policy/">Privacy Policy</a>
        </p>
        <p class="score__msg" id="emailMsg" role="status"></p>
      </form>
    </div>

    <div class="score__deeper" data-path="default">
      <h3 class="score__deeper-title">{deeper.title}</h3>
      <p class="score__note">{deeper.body}</p>
      <button class="score__text-link" type="button" id="extLink" aria-expanded="false" aria-controls="extCheck">
        {deeper.link}
      </button>
      <form class="score__check" id="extCheck" hidden>
        <p class="score__check-title">{deeper.checkTitle}</p>
        <label class="score__tick"><input type="checkbox" id="chk1" /> {deeper.ticks[0]}</label>
        <label class="score__tick"><input type="checkbox" id="chk2" /> {deeper.ticks[1]}</label>
        <button class="score__btn score__btn--ghost" type="submit" id="extContinue" disabled>{deeper.continue}</button>
      </form>
      <p class="score__note score__startup-line">
        {deeper.startupLine} <a class="score__inline-link" href={deeper.startupLink.href}>{deeper.startupLink.text}</a>
      </p>
    </div>

    <div class="score__deeper score__call" data-path="startup" hidden>
      <h3 class="score__call-title" id="callTitle">{reviewCall.title}</h3>
      <p class="score__note">{reviewCall.body}</p>
      <div class="score__check" role="group" aria-labelledby="callTitle">
        <label class="score__tick"><input type="checkbox" id="callChk1" /> {reviewCall.ticks[0]}</label>
        <label class="score__tick"><input type="checkbox" id="callChk2" /> {reviewCall.ticks[1]}</label>
        <button class="score__btn" type="button" id="callBtn" data-google-calendar-open disabled>{reviewCall.button}</button>
      </div>
      <button class="score__text-link" type="button" id="callTip" aria-controls="emailForm">{reviewCall.tip}</button>
      <p class="score__note">{reviewCall.reassurance}</p>
      <p class="score__note">
        {reviewCall.notEligible.before}<button class="score__inline-link" type="button" data-google-calendar-open>{reviewCall.notEligible.bookText}</button>{reviewCall.notEligible.middle}<a class="score__inline-link" href={reviewCall.notEligible.deepDive.href}>{reviewCall.notEligible.deepDive.text}</a>{reviewCall.notEligible.after}
      </p>
    </div>
  </section>

  <ExtendedGate />

  <section class="score__screen" id="s-inconclusive" data-screen="inconclusive" hidden>
    <span class="score__status">{inconclusive.status}</span>
    <h2 class="score__h2" tabindex="-1">{inconclusive.title}</h2>
    <p class="score__lede">
      <span data-path="default">{inconclusive.default.lede}</span>
      <span data-path="startup" hidden>{inconclusive.startup.lede}</span>
    </p>
    <div class="score__btn-row">
      <a class="score__btn" href={inconclusive.default.talk.href} data-path="default">{inconclusive.default.talk.text}</a>
      <button class="score__btn" type="button" id="inconclusiveCallBtn" data-google-calendar-open data-path="startup" hidden>
        {inconclusive.startup.book}
      </button>
      <button class="score__btn score__btn--ghost" type="button" id="retakeBtn">{inconclusive.retake}</button>
    </div>
  </section>
</div>

<script>
  import { initAuxoScore } from "./controller";
  document.addEventListener("astro:page-load", initAuxoScore);
</script>
