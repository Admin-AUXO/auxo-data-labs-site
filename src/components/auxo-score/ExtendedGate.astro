---
import { SCORE_COPY } from "./copy";

const c = SCORE_COPY.extended;
---
<section class="score__screen" id="s-extended" data-screen="extended" hidden>
  <span class="score__eyebrow">{c.eyebrow}</span>
  <h2 class="score__h2" tabindex="-1">{c.title}</h2>
  <p class="score__lede">{c.lede}</p>
  <form class="score__mail" id="seatForm" novalidate>
    <label for="seatInput">{c.label}</label>
    <div class="score__mail-row">
      <input id="seatInput" name="email" type="email" autocomplete="email" placeholder={c.placeholder} required />
      <button class="score__btn" type="submit">{c.submit}</button>
    </div>
    <input class="score__hp" type="text" name="company_website" tabindex="-1" autocomplete="off" aria-hidden="true" />
    <p class="score__consent">
      {c.consent} <a href="/legal/privacy-policy/">{c.privacyLink}</a>
    </p>
    <p class="score__msg" id="seatMsg" role="status"></p>
  </form>
  <button class="score__text-link" type="button" id="backToResult">{c.back}</button>
</section>
