---
interface Step {
  label: string;
  note?: string;
  tone?: "fast" | "slow";
}

interface Props {
  title: string;
  steps: Step[];
  caption?: string;
}

const { title, steps, caption } = Astro.props;
---
<figure class="flow not-prose">
  <figcaption class="flow__title">{title}</figcaption>
  <ol class="flow__steps">
    {
      steps.map((step, i) => (
        <li class="flow__step" data-tone={step.tone}>
          <span class="sq" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
          <span class="flow__label">{step.label}</span>
          {step.note && <span class="flow__note">{step.note}</span>}
        </li>
      ))
    }
  </ol>
  {caption && <p class="flow__caption">{caption}</p>}
</figure>

<style>
  .flow {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    display: grid;
    gap: 1.25rem;
    margin-block: 2rem;
    margin-inline: 0;
    padding: var(--card-pad);
  }

  .flow__title {
    color: var(--foreground);
    font-family: var(--font-brand);
    font-size: var(--text-lg);
    font-weight: 700;
    line-height: 1.25;
  }

  .flow__steps {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(auto-fit, minmax(9.5rem, 1fr));
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .flow__step {
    align-content: start;
    background: color-mix(in oklch, var(--foreground) 5%, transparent);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    display: grid;
    gap: 0.5rem;
    padding: 0.9rem 1rem;
  }

  .flow__step .sq {
    block-size: 1.75rem;
    font-size: var(--text-xs);
    inline-size: 1.75rem;
  }

  .flow__step[data-tone="slow"] {
    border-color: var(--accent-2);
  }

  .flow__step[data-tone="slow"] .sq {
    background: var(--accent-2);
  }

  .flow__step[data-tone="fast"] {
    border-color: color-mix(in srgb, var(--accent) 55%, transparent);
  }

  .flow__label {
    color: var(--foreground);
    font-weight: 600;
    line-height: 1.3;
  }

  .flow__note {
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: 1.4;
  }

  .flow__caption {
    border-block-start: 1px solid var(--border);
    color: var(--subtle);
    font-size: var(--text-sm);
    margin: 0;
    padding-block-start: 0.9rem;
  }
</style>
