---
interface Props {
  label?: string;
}

const { label = "Key point" } = Astro.props;
---
<aside class="callout">
  <p class="callout__label">{label}</p>
  <div class="callout__body"><slot /></div>
</aside>

<style>
  .callout {
    background: var(--surface);
    border: 1px solid var(--border);
    border-inline-start: 0.35rem solid var(--accent);
    border-radius: var(--radius-xl);
    display: grid;
    gap: 0.5rem;
    margin-block: 2rem;
    padding: var(--card-pad);
  }

  .callout__label {
    color: var(--accent);
    font-size: var(--text-sm);
    font-weight: 600;
    line-height: 1.3;
    margin: 0;
  }

  .callout__body {
    color: var(--foreground);
    font-family: var(--font-brand);
    font-size: var(--text-xl);
    font-weight: 700;
    letter-spacing: var(--tracking-display-xl);
    line-height: 1.3;
    text-wrap: balance;
  }

  .callout__body :global(p) {
    line-height: inherit;
    margin: 0;
  }
</style>
