---
import "../styles/main.css";
import { ClientRouter } from "astro:transitions";
import MetaTags from "../components/layout/MetaTags.astro";
import StructuredData from "../components/layout/StructuredData.astro";
import Navigation from "../components/layout/Navigation.astro";
import Footer from "../components/layout/Footer.astro";
import CalendarDialog from "../components/layout/CalendarDialog.astro";
import { organizationSchema, websiteSchema, webPageSchema } from "../lib/structured-data";

interface Props {
  title?: string;
  description?: string;
  path?: string;
  ogImage?: string;
  type?: "website" | "article";
  noindex?: boolean;
}

const { title, description, path, ogImage, type, noindex } = Astro.props;
const pagePath = path ?? Astro.url.pathname;
const pageTitle = title ?? "AUXO Data Labs";
const pageDesc = description ?? "";
---

<!doctype html>
<html lang="en">
  <head>
    <MetaTags
      title={title}
      description={description}
      path={pagePath}
      ogImage={ogImage}
      type={type}
      noindex={noindex}
    />
    <script is:inline>
      const t =
        localStorage.getItem("theme") ??
        (matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark");
      document.documentElement.dataset.theme = t;
    </script>
    <StructuredData type="Organization" data={organizationSchema()} />
    <StructuredData type="WebSite" data={websiteSchema()} />
    <StructuredData
      type="WebPage"
      data={webPageSchema({ title: pageTitle, description: pageDesc, path: pagePath })}
    />
    <ClientRouter />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <div class="scroll-progress" aria-hidden="true"></div>
    <Navigation />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <CalendarDialog />

    <script>
      import { initRuntime } from "../scripts/core/runtime";
      initRuntime();
      document.addEventListener("astro:page-load", initRuntime);
    </script>
  </body>
</html>
