---
import "../styles/main.css";
import MetaTags from "../components/layout/MetaTags.astro";
import StructuredData from "../components/layout/StructuredData.astro";
import Navigation from "../components/layout/Navigation.astro";
import Footer from "../components/layout/Footer.astro";
import CalendarDialog from "../components/layout/CalendarDialog.astro";
import CookieConsent from "../components/layout/CookieConsent.astro";
import { ClientRouter } from "astro:transitions";
import {
  organizationSchema,
  localBusinessSchema,
  websiteSchema,
  webPageSchema,
} from "../lib/structured-data";
import { siteData } from "../data/site";
import { env } from "../config/env";

interface Props {
  title?: string;
  description?: string;
  path?: string;
  ogImage?: string;
  type?: "website" | "article";
  noindex?: boolean;
}

const { title, description, path, ogImage, type, noindex } = Astro.props;
const pagePath = path ?? Astro.url.pathname;
const pageTitle = title ?? "AUXO Data Labs";
const pageDesc = description ?? siteData.description;
const gtmId = env.gtm.containerId;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    {gtmId && (
      <script is:inline set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('consent','default',{ad_storage:'denied',ad_user_data:'denied',ad_personalization:'denied',analytics_storage:'denied',functionality_storage:'granted',security_storage:'granted',wait_for_update:500});gtag('set','ads_data_redaction',true);gtag('set','url_passthrough',true);if(document.cookie.indexOf('auxo_consent=granted')!==-1){gtag('consent','update',{analytics_storage:'granted'});}var _gtmL=false;function _loadGTM(){if(_gtmL)return;_gtmL=true;(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','${gtmId}');}['pointerdown','keydown','scroll','touchstart'].forEach(function(e){addEventListener(e,_loadGTM,{passive:true,once:true});});addEventListener('load',function(){setTimeout(_loadGTM,2500);});`} />
    )}
    <MetaTags
      title={title}
      description={description}
      path={pagePath}
      ogImage={ogImage}
      type={type}
      noindex={noindex}
    />
    <ClientRouter />
    <script is:inline>
      (() => {
        try {
          document.documentElement.dataset.motion =
            localStorage.getItem("auxo-motion") === "on" ? "on" : "off";
        } catch (e) {
          document.documentElement.dataset.motion = "off";
        }
      })();
    </script>
    <script is:inline>
      (() => {
        document.documentElement.dataset.js = "1";
        setTimeout(() => {
          document
            .querySelectorAll('[data-enter="headline"]:not([data-split])')
            .forEach((h) => {
              h.dataset.split = "";
            });
        }, 2000);
      })();
    </script>
    <noscript>
      <style>
        [data-enter="headline"] { opacity: 1 !important; }
      </style>
    </noscript>
    <script>
      import { initAnalytics } from "../scripts/analytics/track";
      import { initWebVitals } from "../scripts/analytics/webVitals";
      initAnalytics();
      initWebVitals();
    </script>
    <StructuredData type="Organization" data={organizationSchema()} />
    <StructuredData type="LocalBusiness" data={localBusinessSchema()} />
    <StructuredData type="WebSite" data={websiteSchema()} />
    <StructuredData
      type="WebPage"
      data={webPageSchema({ title: pageTitle, description: pageDesc, path: pagePath })}
    />
  </head>
  <body>
    {gtmId && (
      <noscript set:html={`<iframe src="https://www.googletagmanager.com/ns.html?id=${gtmId}" height="0" width="0" style="display:none;visibility:hidden"></iframe>`} />
    )}
    <canvas id="particle-field" class="particle-field" aria-hidden="true" transition:persist></canvas>
    <div class="scroll-progress" aria-hidden="true" transition:persist><span data-scroll-progress></span></div>
    <a href="#main" class="skip-link">Skip to content</a>
    <Navigation />
    <main id="main" data-pagefind-body>
      <slot />
    </main>
    <Footer />
    <CalendarDialog />
    <CookieConsent />
    <button type="button" class="to-top" data-to-top aria-label="Back to top" transition:persist>
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 19V5M5 12l7-7 7 7"></path>
      </svg>
    </button>
    <script>
      import { initHeroText } from "../scripts/core/hero-text";
      import { initScrollUI } from "../scripts/core/scroll-ui";
      import { initPWA } from "../scripts/core/pwa";
      import { initCountUp } from "../scripts/ui/count-up";
      import { initMotion } from "../scripts/core/motion";

      function boot() {
        initMotion();
        initHeroText();
        initScrollUI();
        initPWA();
        initCountUp();
      }

      function bootField() {
        if (!window.matchMedia("(min-width: 48rem) and (pointer: fine)").matches) return;
        const run = () =>
          import("../scripts/core/particle-field").then((m) => m.initParticleField());
        if ("requestIdleCallback" in window) requestIdleCallback(run, { timeout: 2500 });
        else setTimeout(run, 300);
      }

      boot();
      bootField();
      document.addEventListener("astro:page-load", () => {
        boot();
        bootField();
      });
    </script>
  </body>
</html>
