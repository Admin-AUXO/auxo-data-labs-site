---
import BaseLayout from "./BaseLayout.astro";
import Section from "../components/layout/Section.astro";
import { Icon } from "astro-icon/components";
import { LEGAL_LAST_UPDATED, LEGAL_PAGE_META } from "../data/legal";
import { siteData } from "../data/site";

interface Props {
  title: string;
  description?: string;
  lastUpdated?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  lastUpdated = LEGAL_LAST_UPDATED,
  noindex,
} = Astro.props;

const currentPath = Astro.url.pathname.replace(/^\//, "").replace(/\/$/, "");
const meta = LEGAL_PAGE_META[currentPath];
---

<BaseLayout
  title={title}
  description={description ?? `${title} for ${siteData.name}`}
  noindex={noindex}
>
  <Section padding="lg" width="4xl">
    <header class="legal-header">
      {meta?.eyebrow && (
        <p class="legal-header__eyebrow">
          <Icon name={meta.icon ?? "mdi:file-document-outline"} aria-hidden="true" />
          <span>{meta.eyebrow}</span>
        </p>
      )}
      <h1 class="legal-header__title">{title}</h1>
      {description && <p class="legal-header__lede">{description}</p>}
      {meta?.summary && <p class="legal-header__summary">{meta.summary}</p>}
      {meta?.highlights && (
        <ul class="legal-header__highlights" aria-label="Document highlights">
          {meta.highlights.map((highlight) => (
            <li class="legal-chip">
              <Icon name="mdi:check-decagram" aria-hidden="true" />
              <span>{highlight}</span>
            </li>
          ))}
        </ul>
      )}
      {lastUpdated && (
        <p class="legal-header__updated">
          <Icon name="mdi:calendar-outline" aria-hidden="true" />
          <span>Last updated: <strong>{lastUpdated}</strong></span>
        </p>
      )}
    </header>

    <div class="prose-auxo">
      <slot />
    </div>
  </Section>
</BaseLayout>

<style>
  .legal-header {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-bottom: 2rem;
    margin-bottom: 2.5rem;
    border-bottom: 1px solid var(--border);
  }

  .legal-header__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--accent);
  }

  .legal-header__eyebrow :global(svg) {
    width: 1.1em;
    height: 1.1em;
  }

  .legal-header__title {
    margin: 0;
    font-size: var(--text-3xl);
    line-height: var(--text-3xl--line-height);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--foreground);
  }

  .legal-header__lede {
    margin: 0;
    max-width: 60ch;
    font-size: var(--text-lg);
    color: var(--muted);
  }

  .legal-header__summary {
    margin: 0;
    max-width: 65ch;
    color: var(--subtle);
  }

  .legal-header__highlights {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .legal-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface-raised);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--foreground);
  }

  .legal-chip :global(svg) {
    width: 1.05em;
    height: 1.05em;
    color: var(--accent);
    flex-shrink: 0;
  }

  .legal-header__updated {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0.5rem 0 0;
    font-size: var(--text-sm);
    color: var(--muted);
  }

  .legal-header__updated :global(svg) {
    width: 1.1em;
    height: 1.1em;
    color: var(--accent);
    flex-shrink: 0;
  }

  .legal-header__updated strong {
    color: var(--foreground);
    font-weight: 600;
  }
</style>
